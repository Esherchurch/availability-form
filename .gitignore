
# EGBC hub installer backups
_backup-*/

# Installed only to run the Firestore rules tests. Twenty thousand files,
# none of them ours.
node_modules/
v2/node_modules/

# Written by the emulator when it runs
*-debug.log
firebase-debug.*.log
.firebase/

# Electron build output for the Mix Builder desktop app. The installer alone is
# 100 MB; it is a build artefact, not source.
mix-app/dist/

# The functions emulator's stand-ins for Secret Manager (test values only).
# Without them the emulator fetches the REAL secrets from Google Secret Manager.
v2/functions/.secret.local
