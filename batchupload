<!DOCTYPE html>
<html>
<head>
<title>Batch Music Importer (Working)</title>

<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-storage.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>

<style>
body { font-family: Arial; padding: 20px; }

.dropzone {
border: 3px dashed #ccc;
padding: 30px;
text-align: center;
border-radius: 15px;
cursor: pointer;
margin-bottom: 15px;
}

.dropzone.dragover { background: #e8f4ff; }

table { border-collapse: collapse; width: 100%; font-size: 12px; }

td, th { border: 1px solid #ddd; padding: 6px; }

.status-new { background:#d4edda; }
.status-exists { background:#f8d7da; }
.status-review { background:#fff3cd; }
.status-skipped { background:#e0e0e0; }

input, select { width: 100%; }

button { margin: 2px; }
</style>
</head>

<body>

<h2>Batch Music Importer</h2>

<div class="dropzone" id="dropzone">
Drag folder OR click to select
</div>

<input type="file" id="fileInput" multiple webkitdirectory style="display:none">

<div id="status"></div>

<button onclick="processAll()">Upload</button>

<table>
<thead>
<tr>
<th>File</th>
<th>Title</th>
<th>Key</th>
<th>Type</th>
<th>Match</th>
<th>YouTube</th>
<th>CCLI</th>
<th>Status</th>
<th>Action</th>
</tr>
</thead>
<tbody id="table"></tbody>
</table>

<script>

// PREVENT NAVIGATION
window.addEventListener("dragover", e => e.preventDefault());
window.addEventListener("drop", e => e.preventDefault());

// FIREBASE
const firebaseConfig = {
apiKey: "YOUR_KEY",
authDomain: "egbc-worship-planner.firebaseapp.com",
projectId: "egbc-worship-planner",
storageBucket: "egbc-worship-planner.firebasestorage.app"
};

firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();
const storage = firebase.storage();

let songs = [];
let rows = [];

const KEYS = ["C","C#","Db","D","Eb","E","F","F#","G","Ab","A","Bb","B"];
const TYPES = ["Lead Sheet","Chord Sheet","Lyrics","Bass Tabs"];

// LOAD SONGS
async function loadSongs(){
const snap = await db.collection("songs").get();
songs = snap.docs.map(d => ({id:d.id,...d.data()}));
}

// NORMALIZE
function normalize(t){
return t.toLowerCase().replace(/[^a-z0-9 ]/g,"").trim();
}

// SIMPLE MATCH
function getMatches(title){
const norm = normalize(title);
return songs
.map(s => ({
song:s,
score: normalize(s.title).includes(norm) ? 1 : 0
}))
.sort((a,b)=>b.score-a.score)
.slice(0,5);
}

// FILE HANDLING
const dropzone = document.getElementById("dropzone");
const fileInput = document.getElementById("fileInput");

dropzone.onclick = () => fileInput.click();

fileInput.onchange = e => handleFiles(Array.from(e.target.files));

dropzone.addEventListener("dragover", e=>{
e.preventDefault();
dropzone.classList.add("dragover");
});

dropzone.addEventListener("dragleave", ()=>{
dropzone.classList.remove("dragover");
});

dropzone.addEventListener("drop", async e=>{
e.preventDefault();
dropzone.classList.remove("dragover");

let files = [];

for(let item of e.dataTransfer.items){
let entry = item.webkitGetAsEntry();
await traverse(entry, files);
}

handleFiles(files);
});

// FIXED TRAVERSAL
async function traverse(entry, files){

if(entry.isFile){
await new Promise(resolve=>{
entry.file(file=>{
if(file.name.toLowerCase().endsWith(".pdf")){
files.push(file);
}
resolve();
});
});
}

if(entry.isDirectory){
let reader = entry.createReader();

let readEntries = async () => {
let entries = await new Promise(res => reader.readEntries(res));
if(entries.length){
for(const e of entries){
await traverse(e, files);
}
await readEntries();
}
};

await readEntries();
}
}

// MAIN
async function handleFiles(files){

document.getElementById("status").innerText =
files.length + " PDF files loaded";

await loadSongs();

rows = files.map(file=>{
let matches = getMatches(file.name);

return {
file,
title:file.name.replace(".pdf",""),
key:"",
type:"",
matches,
match:matches[0]?.song || null,
youtube:matches[0]?.song?.youtube || "",
ccli:matches[0]?.song?.ccli || "",
skip:false,
force:false
};
});

render();
}

// STATUS
function getStatus(r){

if(r.skip) return "SKIPPED";

if(!r.match || !r.key || !r.type) return "REVIEW";

let dup = (r.match.files||[]).find(f =>
f.key===r.key && f.type===r.type
);

if(dup && !r.force) return "EXISTS";

return "NEW";
}

// RENDER
function render(){

const tbody = document.getElementById("table");
tbody.innerHTML = "";

rows.forEach((r,i)=>{

let status = getStatus(r);

let tr = document.createElement("tr");
tr.className = "status-"+status.toLowerCase();

tr.innerHTML = `
<td>${r.file.name}</td>

<td><input value="${r.title}"></td>

<td>
<select>
<option value="">Key</option>
${KEYS.map(k=>`<option ${r.key===k?"selected":""}>${k}</option>`).join("")}
</select>
</td>

<td>
<select>
<option value="">Type</option>
${TYPES.map(t=>`<option ${r.type===t?"selected":""}>${t}</option>`).join("")}
</select>
</td>

<td>
<select>
${r.matches.map(m=>`
<option value="${m.song.id}" ${r.match?.id===m.song.id?"selected":""}>
${m.song.title}
</option>`).join("")}
</select>
</td>

<td><input value="${r.youtube}"></td>
<td><input value="${r.ccli}"></td>

<td>${status}</td>

<td>
<button>Skip</button>
<button>Force</button>
</td>
`;

tbody.appendChild(tr);

const inputs = tr.querySelectorAll("input, select, button");

inputs[0].onchange = e => { r.title=e.target.value; render(); };
inputs[1].onchange = e => { r.key=e.target.value; render(); };
inputs[2].onchange = e => { r.type=e.target.value; render(); };
inputs[3].onchange = e => {
r.match = r.matches.find(m=>m.song.id===e.target.value).song;
render();
};

inputs[4].onchange = e => { r.youtube=e.target.value; };
inputs[5].onchange = e => { r.ccli=e.target.value; };

inputs[6].onclick = () => { r.skip=true; render(); };
inputs[7].onclick = () => { r.force=true; render(); };

});

}

// PROCESS
async function processAll(){

if(!confirm("Upload?")) return;

for(const r of rows){

let status = getStatus(r);

if(status==="SKIPPED" || status==="EXISTS") continue;

if(status==="REVIEW"){
alert("Fix: "+r.file.name);
return;
}

const id = r.match.id;

const ref = storage.ref(`songs/${id}/${r.file.name}`);
await ref.put(r.file);
const url = await ref.getDownloadURL();

const docRef = db.collection("songs").doc(id);
const snap = await docRef.get();
let data = snap.exists ? snap.data() : {};

let files = data.files || [];

files.push({
name:r.file.name,
url,
type:r.type,
key:r.key
});

await docRef.set({
title:r.match.title,
normalized: normalize(r.match.title),
youtube:r.youtube,
ccli:r.ccli,
files
},{merge:true});
}

alert("Upload complete");
}

</script>

</body>
</html>
