rules_version = '2';

// EGBC Worship Planner — Firestore rules
//
// Deploy:  firebase deploy --only firestore:rules --project egbc-worship-planner
//
// ORDER OF ROLLOUT MATTERS. Deploy these only once everyone who needs access
// has signed in at least once and been given their teams in the hub admin
// panel. Deploying earlier locks the team out mid-term.
//
// ADMINISTRATORS are anyone ticked "Core Team" in the address book. There is
// no separate owner role and no console step: tick Core Team against yourself
// in addressbook.html before deploying these rules, and sign in once so the
// lookup runs.
//
// Content tabs come from a person's own markers. Being Core Team makes you an
// administrator; it does not hand you the Kids Church tab.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // The signed-in person's mirrored record, as a Resource. get() returns
    // null for a document that is not there, which is how active() can tell
    // without a second lookup: two identical get() calls in one evaluation
    // count as ONE document access, and an exists() would have been a second.
    // That mattered - see active().
    function myRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function me() {
      return myRecord().data;
    }

    // IT HAS TO CHECK THE DOCUMENT IS THERE. get() on a document that does
    // not exist returns null, and `null.status` is not false - it is an
    // evaluation error, which fails the whole rule set for that request with
    // "Null value error" rather than a tidy refusal.
    //
    // That was unreachable until 9 October 2026 only because addressBook was
    // `allow read: if true`: a brand new account has no users/{uid} document
    // yet, and the first thing egbc-auth.js does is query the address book to
    // find out who has signed in. The moment that query went through a rule
    // naming active(), every first sign-in threw - for everybody, not only
    // Attenders - and the page showed "Something went wrong". Found by
    // signing in as an Attender in a browser and reading the screen; no rules
    // test caught it, because they all wrote users/{uid} with the memberId
    // already in hand and none of them ran the lookup that finds it.
    // AN exists() HERE COST TOO MUCH. The first fix for the null above was
    // `exists(users/{uid}) && me().status == 'active'`, which is correct and
    // readable - and it broke one rule in the events window's section outright:
    // "the Session Leader sees the medical details of a child checked in this
    // morning" went from allow to deny, because that rule already walks the
    // rota and the morning and the child, and Firestore allows a limited
    // number of document accesses per request. The extra exists() was one too
    // many. 636/637, from a change that read as a safe tidy-up.
    //
    // Comparing the get() to null does the same job for nothing: the same
    // get() appears in me(), and two identical gets in one evaluation are one
    // access.
    function active() {
      return signedIn() && myRecord() != null && me().status == 'active';
    }

    // CORE TEAM COVERS WORSHIP & AV (Martin, 11 Oct 2026: "core team cant
    // see worship and AV"). On the old portal the Core Team link showed
    // every Worship & AV item plus Core's own, and the pages now agree -
    // egbc-auth.js CORE_COVERS. The rules have to say the same thing, or a
    // page opens and the data behind it is refused.
    //
    // ONE LIST, AND EVERY TEAM TEST GOES THROUGH IT. The reason is not
    // tidiness: there were two ways of asking "is this person on that
    // team" in this file - onTeam() and a bare me().teams.hasAny() on the
    // rota write - and a cover added to one of them would have let Core
    // Team read the Service Planner and refused them saving it. Both now
    // read myTeams().
    //
    // IT ONLY GOES ONE WAY. Core Team counts as Worship, AV and Choir;
    // nobody counts as Core Team who is not on it.
    //
    // WORSHIP, AV AND CHOIR ARE ONE TEAM FOR SEEING THINGS (Martin,
    // 12 Oct 2026: "if worship team want to turn on the sound desk they
    // should be able to see how"). Being on any of the three counts as
    // being on all three, which egbc-auth.js's inTeam() already does for
    // the pages (WORSHIP_AV, 8c9dba43). The rules have to say the same
    // or a page opens and the data behind it is refused - which is the
    // fault this whole helper was written for.
    //
    // ONE LIST FOR BOTH, because they are the same three teams: what
    // Core Team covers and what the three cover between them.
    //
    // THIS WIDENS READING AND NOT WRITING. Every leader-only write in
    // this file goes through canAct()/adminOf(), which read adminFor
    // directly and never myTeams() - so an AV member reading the worship
    // team's videos does not become able to change them. That is worth
    // stating because widening a helper that everything leans on is
    // exactly how a read gate turns into a write gate by accident.
    function worshipAv() { return ['Worship Team', 'AV Team', 'Choir']; }
    function coreCovers() { return worshipAv(); }
    // CORE TEAMS COVER CHOSEN TEAMS (H-15, 26 Oct 2026): `covers` is the
    // teams a person's core teams cover - the Worship Core Team, Worship, AV
    // and Choir; the Kids & Youth Core Team, Kids Church, Lazers, ReNu and
    // Youth - kept on their users record by the server (functions/
    // core-teams.js), never by a page. Core Team keeps worshipAv() until its
    // record has covers, so nothing changes on the day.
    function myTeams() {
      return me().teams
        .concat(me().get('covers', []))
        .concat('Core Team' in me().teams ? worshipAv() : [])
        .concat(me().teams.hasAny(worshipAv()) ? worshipAv() : []);
    }

    function onTeam(team) {
      return active() && (team in myTeams());
    }

    // On any of these teams. Same list, same cover.
    function onAnyTeam(teams) {
      return active() && myTeams().hasAny(teams);
    }

    // Three levels, all set in the address book and mirrored onto users/{uid}:
    //   masterAdmin  - everything, everywhere, including making admins
    //   adminFor[]   - manages those areas only
    //   member       - their own team's pages, plus anything open to everyone

    function isMaster() {
      return active() && me().get('masterAdmin', false) == true;
    }

    // An admin of a core team administers the teams it covers (H-15):
    // adminCovers, kept by the server like covers.
    function adminOf(team) {
      return isMaster() || (active() && (team in me().get('adminFor', []) || team in me().get('adminCovers', [])));
    }

    // Manages something, anything. Use adminOf(team) wherever the area is known.
    function isAdmin() {
      return isMaster() || (active() && me().get('adminFor', []).size() > 0);
    }

    // ---- the four levels (NEXT-BRIEF 21, Martin, 9 Oct 2026) --------
    //
    //   Pending        signed in, no address book record carries their
    //                  verified address. Almost nothing.
    //   Attender       a record does. status is 'active' for them now, which
    //                  it was not before, so active() means Attender.
    //   Church member  that record also has the office's "Church member"
    //                  tick. Members' meetings, members-only documents.
    //   Team member    that record has teams in markers. Their team's pages.
    //
    // THE NAME active() DID NOT CHANGE BUT ITS MEANING DID, and it is used 72
    // times. Everything meant for volunteers was changed to volunteer() in
    // the same commit - which is exactly what active() meant before, so that
    // pass moved nothing - and only the places section 21 names were left
    // reading active(). ACCESS-LEVELS.md lists all 72 with the verdict.
    //
    // None of the three can be granted by the person they describe: all of
    // them are mirrored from the address book and checked by mirrorsBook().

    // What active() used to mean: on a team, or administering something.
    function volunteer() {
      return active() && (me().get('teams', []).size() > 0
                          || me().get('adminFor', []).size() > 0
                          || me().get('masterAdmin', false) == true);
    }

    // An action from the Permissions screen on this person's sign-in (H-14;
    // the claim functions/permissions.js keeps). permKey() is 'egbc' here
    // and the church's id in the church build (tools/rules-build.mjs).
    function permKey() { return 'egbc'; }
    function hasPerm(a) { return request.auth != null && a in request.auth.token.get('perms', {}).get(permKey(), []); }

    // In the address book, not archived, not a child's record. Carries no
    // information active() does not already imply - mirrorsBook proves the
    // record is theirs - and exists so that a rule meaning "anyone who comes
    // to this church" can say so rather than leaning on a coincidence.
    function isAttender() {
      return active() && me().get('attender', false) == true;
    }

    // Formally joined the church. Not every attender, and the office decides.
    function isChurchMember() {
      return active() && me().get('churchMember', false) == true;
    }

    // ---- the projection PC (ChurchShow) ----------------------------
    //
    // ChurchShow reads services, songs and the rota through the Firestore
    // REST API with the web key and no sign-in at all. It works today only
    // because events was open; this commit shuts it, so without this the
    // projection would go blank at switch-over. NEXT-BRIEF 20, and R4 of
    // FINDINGS-churchshow.md.
    //
    // NOT active(): a paired computer is not a person and has no
    // users/{uid} document. The claim is set by the pairing function with
    // the Admin SDK, so it cannot be forged from a page.
    //
    // THE DEVICE DOCUMENT IS CHECKED AS WELL AS THE CLAIM, and that is the
    // point of it: revoking a refresh token stops the device RENEWING, but
    // an ID token already issued stays good for up to an hour. Reading
    // devices/{uid}.active makes Disconnect on the hub take effect at once
    // rather than "some time within the hour".
    //
    // Reads only. The device may write nothing, anywhere.
    function churchShow() {
      return request.auth != null
             && request.auth.token.get('device', '') == 'churchshow'
             && exists(/databases/$(database)/documents/devices/$(request.auth.uid))
             && get(/databases/$(database)/documents/devices/$(request.auth.uid))
                  .data.get('active', false) == true;
    }
    // A COMPUTER'S JOB (Martin, 19 Oct 2026): "Main services" and/or
    // "Lessons" for chosen plan groups, set by a master admin on
    // churchshow.html. Only a computer doing main services reads the service
    // plans, the songs and the rota; a Lessons-only one gets none of them
    // (its lessons come through lessonFor). Read off the device's own
    // record on every request, like `active`, so a change takes effect at
    // once. A record with no jobs - everything paired before - does main
    // services, which is what it always did.
    function churchShowServices() {
      return churchShow()
             && get(/databases/$(database)/documents/devices/$(request.auth.uid))
                  .data.get('jobs', {}).get('services', true) == true;
    }

    // The paired computers, and the one-time pairing codes. Written by the
    // functions with the Admin SDK, which does not come through here; an
    // admin may look at what is paired, and nothing may be written from a
    // page. A code is a password, so even reading one is shut.
    match /devices/{deviceUid} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /deviceCodes/{codeHash} {
      allow read, write: if false;
    }

    // May change that team's content. Used by the knowledge base, the video
    // library and the resource shelf.
    //
    // This was called in three places and never defined, which does not fail
    // quietly - the whole ruleset refuses to compile, so nothing could have
    // been deployed at all. Caught by running the rules in the emulator.
    //
    // There is no separate "leader" tier here on purpose: the users document
    // mirrors teams, adminFor and masterAdmin from the address book, and
    // never carried a roles map, so admin is the only tier above member that
    // exists in the data.
    function canAct(team) {
      return adminOf(team);
    }

    // ---- users ------------------------------------------------------
    // A person may read and create their own record. They may not invent what
    // it says about them - but they MUST be able to write what the address
    // book already says, because that is how signing in works at all.
    //
    // This rule used to allow a create only with status 'pending' and no
    // teams, and an update to nothing but lastSeen and name. egbc-auth.js
    // provisions a first sign-in by matching the address book and writing the
    // membership it finds, in one set(). So for every member who matches a
    // record - which is every member - the create was refused, the mirror was
    // never written, and active() was false for ever after. The page still
    // looked signed in, because the client keeps its own copy and the failed
    // write was swallowed; it is the rules that read the stored document. The
    // whole site would have refused every member the day these rules were
    // deployed, and the suite missed it because every test created users/{uid}
    // with the rules switched off.
    //
    // So: copying from the address book is allowed, and checked against it.
    // The address book is editable only by admins, so this grants nothing an
    // admin has not already granted.
    //
    // RESIDUAL RISK, worth knowing about: where two people share an address -
    // a parent's email on a child's record - either of them could claim
    // either record, including an admin one. The client refuses that (it
    // marks the account ambiguous for an admin to settle) but these rules
    // cannot, because proving it needs a query for every record carrying the
    // address and rules cannot query. Tightening it further needs a decision
    // about who links shared addresses.

    function book(id) {
      return get(/databases/$(database)/documents/addressBook/$(id)).data;
    }

    // A record that carries this person's own verified sign-in address.
    function bookIsMine(id) {
      return exists(/databases/$(database)/documents/addressBook/$(id))
             && request.auth.token.get('email_verified', false) == true
             && book(id).get('email', '') == request.auth.token.get('email', '');
    }

    // Says exactly what the address book says, and nothing more.
    function mirrorsBook(d) {
      return d.get('memberId', '') != ''
             && bookIsMine(d.get('memberId', ''))
             && d.get('teams', []) == book(d.get('memberId', '')).get('markers', [])
             && d.get('adminFor', []) == book(d.get('memberId', '')).get('adminFor', [])
             && d.get('masterAdmin', false) == book(d.get('memberId', '')).get('masterAdmin', false)
             // Section 21. The "Church member" tick, and being an Attender at
             // all. Somebody archived has left, and a child's record is not a
             // person who signs in - neither is an Attender, and refreshFromBook
             // did not look at either before, so an archived member kept
             // whatever they had.
             //
             // CHECKED IF PRESENT, NOT REQUIRED. A browser holding a cached
             // egbc-auth.js writes the old shape, with neither field, and
             // refreshFromBook swallows a refusal - so requiring them would
             // leave somebody signing in for the first time on deploy day
             // stuck pending with nothing on screen to explain it. Absent
             // means "claims nothing extra", which is exactly what the old
             // client meant.
             && (!d.keys().hasAny(['churchMember'])
                 || d.get('churchMember', false) == (
                      book(d.get('memberId', '')).get('churchMember', false) == true
                      && book(d.get('memberId', '')).get('archived', false) != true))
             && (!d.keys().hasAny(['attender'])
                 || d.get('attender', false) == (
                      book(d.get('memberId', '')).get('archived', false) != true
                      && book(d.get('memberId', '')).get('isMinor', false) != true))
             // The one-off Running things ticks (NEXT-BRIEF §25). Checked
             // against the record like everything else here, so a person
             // cannot give themselves a tab by writing their own mirror -
             // and an archived person carries none. Present-or-absent for
             // the same reason as the two above: a browser holding a cached
             // egbc-auth.js writes the old shape with no `runs` at all, and
             // requiring it would refuse every heartbeat silently.
             && (!d.keys().hasAny(['runs'])
                 || (book(d.get('memberId', '')).get('archived', false) != true
                     && d.get('runs', []) == book(d.get('memberId', '')).get('runs', []))
                 || (book(d.get('memberId', '')).get('archived', false) == true
                     && d.get('runs', []).size() == 0))
             // An Attender is active now, where before only a volunteer was.
             // 'pending' is allowed whatever the book says, because claiming
             // LESS than the record grants can never be an escalation - and
             // it is what the old client writes for an Attender on no team.
             && (d.get('status', '') == 'pending'
                 || (d.get('status', '') == 'active'
                     && (d.get('attender', false) == true
                         || d.get('teams', []).size() > 0
                         || d.get('adminFor', []).size() > 0
                         || d.get('masterAdmin', false) == true)));
    }

    // Claiming nothing: waiting to be recognised, or waiting for an admin to
    // settle which of two records with this address is this person.
    function claimsNothing(d) {
      return (d.get('status', '') == 'pending' || d.get('status', '') == 'ambiguous')
             && d.get('teams', []).size() == 0
             && d.get('adminFor', []).size() == 0
             && d.get('masterAdmin', false) == false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || volunteer());

      allow create: if signedIn()
                    && request.auth.uid == uid
                    // familyGroups opens boards (6c), covers / adminCovers
                    // what core teams give (H-15), and jobs the team jobs
                    // (H-9 part 2): the server's to write.
                    && !request.resource.data.keys().hasAny(['familyGroups', 'covers', 'adminCovers', 'jobs'])
                    && (claimsNothing(request.resource.data)
                        || mirrorsBook(request.resource.data));

      // Own record: the heartbeat, and nothing else.
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastSeen', 'name']);

      // Own record: picking up a change an admin made in the address book, so
      // somebody added to a team does not have to be told to sign out and
      // back in. Checked against that record, so it grants nothing new.
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastSeen', 'name', 'teams', 'adminFor', 'masterAdmin',
                                   'status', 'memberId', 'linkedBy', 'candidates',
                                   'attender', 'churchMember', 'runs'])
                    && mirrorsBook(request.resource.data);

      // Own record: standing down to 'ambiguous' when a second record turns
      // out to carry this address. Gives nothing up to an attacker and takes
      // nothing: it is the state that asks an admin to decide.
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastSeen', 'name', 'teams', 'adminFor', 'masterAdmin',
                                   'status', 'memberId', 'candidates'])
                    && claimsNothing(request.resource.data);

      // Admins may change teams, roles and status.
      // Master admins may change anything. A team admin may change teams and
      // status, but only for areas they administer - and never adminFor or
      // masterAdmin, so admin rights cannot be self-granted or handed on.
      allow update: if isMaster();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['teams', 'status', 'name', 'lastSeen', 'memberId', 'linkedBy'])
                    && me().get('adminFor', []).hasAny(request.resource.data.get('teams', []));

      allow delete: if isAdmin();
    }

    // ---- the live rota calendar (Step R) -----------------------------
    //
    // A calendar app cannot sign in, so the long random key in the subscribe
    // link stands in for signing in. That makes the key a password, and it is
    // kept where a password has to be kept.
    //
    // calendarKeys/{uid} is the person's own copy, so the hub can show them
    // their link. Only they can read it.
    //
    // calendarFeeds/{key} is the lookup the Cloud Function uses to turn a key
    // back into a person. NOBODY may read it - not even the person it belongs
    // to - because being able to read it is being able to turn anyone's key
    // into their name. Only the Admin SDK inside the function sees it, and the
    // Admin SDK does not go through these rules.
    //
    // Neither is written by any page. The function makes the key, because a
    // page that could write calendarFeeds could point a key at somebody else.
    //
    // Why not keep the key on users/{uid}: that document is readable by every
    // active member, which is deliberate - the hub shows who is on which team.
    // Rules cannot hide one field of a document, so a key kept there would be
    // readable by the whole church.

    // Each feed now has its own key (NEXT-BRIEF 18): just me, my household,
    // and the full rota for a team. They live in a `feeds` map on this
    // document, and resetting one leaves the others alone.
    //
    // NOBODY reads this from a page any more. The hub asks the myCalendarLinks
    // function instead, which answers only about the person asking. A key is a
    // password, and the fewer places one can be read from the better - so this
    // is shut to everything except the Admin SDK inside the functions, which
    // does not go through these rules.
    match /calendarKeys/{uid} {
      allow read, write: if false;
    }

    match /calendarFeeds/{key} {
      allow read, write: if false;
    }

    // ---- Apps and downloads (hubresources.html; 26 Oct 2026) ----------
    // SHARED with the original site's page, which edits it today under the
    // live rules. Under these rules: anybody signed in reads it (v2's page
    // lists its web tools and links), and only a master admin changes it -
    // v2's page itself writes nothing while the original site uses the list.
    match /hub_resources/{rid} {
      allow read: if signedIn();
      allow write: if isMaster();
    }

    // ---- hub page registry ------------------------------------------

    match /hubPages/{pageId} {
      allow read: if active();
      allow write: if isAdmin() && adminOf(request.resource.data.team);
    }

    // ---- address book -----------------------------------------------
    // Personal data. Readable by any active member so rotas and directories
    // work; writable only by team admins.

    // signInEmails holds any extra addresses Core Team has linked to this
    // person, so a Gmail sign-in still resolves to their record.
    // THIS WAS `allow read: if true` UNTIL 9 OCTOBER 2026, so that
    // index.html - the public availability form, which has no sign-in by
    // design - could find somebody by their email address. That handed anyone
    // on the internet every name, address, telephone number and household in
    // the church, in one request. The form now asks the findMe function
    // instead, which answers about one address and returns a name and teams
    // and nothing else. PRIVACY-OPEN-COLLECTIONS.md has the reasoning.
    //
    // NOT active(): that now means Attender, which is most of the church, so
    // closing it to active() would have been closing it to almost nobody.
    // volunteer() is what active() meant before.
    match /addressBook/{personId} {
      // Their own record, so a dashboard can greet them by name. bookIsMine
      // checks the verified address on the record, so it cannot be claimed.
      allow get: if isAdmin() || volunteer() || bookIsMine(personId);
      // A LIST IS EVALUATED AGAINST EACH DOCUMENT IT RETURNS, which is what
      // makes the last clause possible and what the first version of this rule
      // got wrong. It said `isAdmin() || volunteer()` and nothing else - and
      // broke EVERY FIRST SIGN-IN, for everybody, not only Attenders.
      //
      // egbc-auth.js does not know your memberId until it has found you, and
      // it finds you with two queries: `where email ==` and
      // `where signInEmails array-contains`. A brand new account has no
      // users/{uid} document at all, so volunteer() is false, the queries were
      // refused, provisionProfile failed, and the page showed "Something went
      // wrong". The rules tests all passed, because every one of them tested
      // the WRITE to users/{uid} with the memberId already in hand, and not
      // one of them ran the lookup that produces it. Caught by signing in as
      // an Attender in a browser and reading the screen.
      //
      // The last clause lets a signed-in person run exactly those two
      // queries and no others: a document only comes back if it carries their
      // own verified address, so there is nothing to enumerate.
      // A QUERY IS NOT NARROWED TO ONE PERSON HERE, and that is a choice
      // rather than a limitation - an earlier version of this comment said it
      // was impossible, which is not true. A list rule CAN say
      // `resource.data.email == request.auth.token.email`: Firestore then
      // allows a query whose own `where` clauses guarantee it and refuses one
      // that asks for the whole collection. Measured, five ways, after this
      // comment first claimed otherwise.
      //
      // The lookup is a function anyway - whoAmI, which egbc-auth.js asks -
      // for two reasons that are worth more than the clause saved:
      //
      //   the directory is then shut to page-side queries ENTIRELY, so there
      //   is no clause for somebody to widen later by adding an `||`, and
      //
      //   whoAmI drops archived and under-16 records itself, so the page is
      //   no longer the only thing enforcing that.
      //
      // The cost is that signing in now needs that function deployed. See
      // SERVER-DEPLOY.md, which says so twice.
      //
      // Once the page knows the id, `allow get` above lets it read that one
      // record - its own.
      allow list: if isAdmin() || volunteer();
      // WHO MAY CHANGE A RECORD (Martin, 16 Oct 2026): the church office and
      // master admins, anyone; a team leader, the people on their teams -
      // adding or taking away only their own teams' ticks, and never the
      // admin, master or under-18 ticks. A new person they add is on their
      // teams only. Removing somebody is the office's, or the leader's when
      // the person is on no team but theirs.
      allow write: if raOffice() || bookLeaderOk();
    }

    function bookLeaderOk() {
      let mine = me().get('adminFor', []);
      let was = resource == null ? [] : resource.data.get('markers', []);
      let now = request.resource == null ? [] : request.resource.data.get('markers', []);
      return isAdmin()
        && (request.resource == null
              ? was.size() > 0 && was.hasOnly(mine)
              : ((resource == null ? now.size() > 0 && now.hasOnly(mine) : was.hasAny(mine))
                 && now.toSet().difference(was.toSet()).hasOnly(mine)
                 && was.toSet().difference(now.toSet()).hasOnly(mine)
                 && request.resource.data.get('adminFor', []) == (resource == null ? [] : resource.data.get('adminFor', []))
                 && request.resource.data.get('masterAdmin', false) == (resource == null ? false : resource.data.get('masterAdmin', false))
                 && request.resource.data.get('isMinor', false) == (resource == null ? false : resource.data.get('isMinor', false))
                 // Under 18 (never emailed): the office's to set, like Under 16.
                 && request.resource.data.get('under18', false) == (resource == null ? false : resource.data.get('under18', false))));
    }

    // Two collections the availability form's function keeps for itself. The
    // Admin SDK does not go through these rules, so shutting them to
    // everything costs the function nothing and means a form token cannot be
    // read out of the database by the page that was given one.
    match /formSessions/{token} {
      allow read, write: if false;
    }
    match /formRateLimit/{ipHash} {
      allow read, write: if false;
    }

    // ---- rota, services, availability -------------------------------
    // Ministry-scoped. A document carries a `ministry` field naming the team
    // it belongs to; leaders of that team may write it.

    // events.teams is an array of team names, e.g. ["Worship Team","AV Team"].
    // A leader of any team on the event may write it.
    // ALSO `allow read: if true` until 9 October 2026, and worse than it
    // looks: every event carries `assignments`, so this published who is
    // serving, by name, along with the service leader and the speaker. The
    // availability form needs dates and types only, and the myDates function
    // gives it those - filtered to the one person asking, with no
    // assignments, no leader and no speaker.
    match /events/{eventId} {
      // FINDINGS-churchshow.md R4: "events - already open; if it's ever
      // closed, add churchShow()". That commit is what closed it.
      //
      // The youth app lists them to choose which service to plan, and marks
      // the ones that are not youth services "view only". That means a young
      // person sees who is serving, by name, on every service - no telephone
      // number, no address, no email, because events carries none. Said out
      // loud in YOUTH-ACCESS.md rather than left to be discovered.
      // MEETINGS (27 Oct 2026): whoever the Permissions screen lets see
      // every meeting ("meetingsAll") reads the rota too, though on no team
      // - a small group leader, say. Never anybody by default.
      allow read: if volunteer() || (active() && hasPerm('meetingsAll')) || churchShowServices() || youthGranted();
      // SAFEGUARDING IS A SEPARATE GATE, and it applies to admins too. The
      // line above says who may touch the rota; safeguardingOk() says who
      // may be put on it. A master admin is not exempt - the exception
      // route is, which is the point of recording a reason.
      // onAnyTeam, not a bare me().teams.hasAny: Core Team ran the Service
      // Planner on the old portal, so they must be able to SAVE a Worship
      // service and not only read it. Same helper as onTeam, same cover.
      allow write: if (isAdmin()
                       || onAnyTeam(request.resource.data.get('teams', ['Worship Team'])))
                   && safeguardingOk();
      // THE PREACHING PLAN (Martin, 15 Oct 2026): the Pastor - the one named
      // in Team emails (teamMailSettings/main.pastor; isPastor() is with
      // For Sunday, under EVENTS) - reads the services and
      // changes the four preaching fields - what the Sunday is, the speaker,
      // the service leader and the readers - and nothing else: no roles,
      // no people on the rota, no dates. Whether or not they are on a team.
      // And the church's overall leaders (the "leadership" job; Martin, 26
      // Oct 2026: "assembled and edited by the pastors and elders").
      allow read: if isPastor() || isLeadership();
      allow update: if (isPastor() || isLeadership())
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['publicTitle', 'speaker', 'speakerId', 'serviceLeader', 'serviceLeaderId', 'serviceRoles', 'readers', 'updatedAt', 'updatedBy'])
                    && request.resource.data.get('publicTitle', '') is string
                    && request.resource.data.get('publicTitle', '').size() <= 140
                    && request.resource.data.get('readers', []) is list
                    && request.resource.data.get('readers', []).size() <= 12;
    }


    // ---- "I'M WORRIED ABOUT SOMEONE" (NEXT-BRIEF §24) ------------------
    // Martin: "We are not tracking it, but if someone notices that X has
    // not been in church for a while they can flag it if they are worried.
    // It may be an older person getting isolated."
    //
    // PEOPLE-LED, NEVER AUTOMATIC. Nothing here counts or watches anybody;
    // a person chooses to speak up. The same value governs §24 throughout:
    // adults' attendance is never recorded.
    //
    // PRIVATE, AND THAT IS THE WHOLE POINT. The person it is about never
    // sees it. It never appears on their address book record, their
    // profile, the directory or any list. The person who raised it gets
    // "Thank you, it has been passed on" and nothing else - not even their
    // own concern back, because a list of "concerns I raised" is a list
    // somebody can be asked to show.
    //
    // WHO READS WHAT:
    //   pastoral      the Pastoral group (teams-as-data, rota:false), and
    //                 the safeguarding lead
    //   safeguarding  the safeguarding lead and deputy, AND NOBODY ELSE
    //
    // A MASTER ADMIN IS DELIBERATELY NOT A READER of a safeguarding
    // concern. §24 says "goes only to the safeguarding lead and deputy",
    // and a master admin is a technical role, not a safeguarding one.
    // Reading it the other way would make "only" mean "only, and whoever
    // can edit the rules". If Martin wants otherwise it is one line, said
    // out loud rather than assumed.
    function sgLeadOrDeputy() {
      return exists(/databases/$(database)/documents/safeguardingSettings/defaults)
             && sgLeadOf(get(/databases/$(database)/documents/safeguardingSettings/defaults).data.get('leadSiteId', ''));
    }
    function onPastoral() { return onTeam('Pastoral'); }

    // WHO GETS TOLD (Martin, 14 Oct 2026; NEXT-BRIEF §24): the people the
    // church names for each kind (careRouting/main, a master admin's), and
    // NEVER the church office or any admin inbox. A person named for a
    // kind reads that kind.
    function careNamed(kind) {
      return active() && exists(/databases/$(database)/documents/careRouting/main)
             && me().get('memberId', '-') in get(/databases/$(database)/documents/careRouting/main).data
                  .get(kind, {}).get('memberIds', []);
    }
    // A safeguarding lead is set. Without one a concern or a request for
    // care could reach nobody, so it is refused (the form says so, and
    // master admins are warned).
    function sgLeadSet() {
      return exists(/databases/$(database)/documents/safeguardingSettings/defaults)
             && get(/databases/$(database)/documents/safeguardingSettings/defaults).data.get('leadSiteId', '') != ''
             && exists(/databases/$(database)/documents/bookingSettings/$(get(/databases/$(database)/documents/safeguardingSettings/defaults).data.leadSiteId))
             && get(/databases/$(database)/documents/bookingSettings/$(get(/databases/$(database)/documents/safeguardingSettings/defaults).data.leadSiteId)).data.get('safeguardingLead', '') != '';
    }
    function careKinds(d) {
      return d.keys().hasOnly(['memberIds', 'email'])
             && d.get('memberIds', []) is list && d.get('memberIds', []).size() <= 20
             && d.get('email', '') is string && d.get('email', '').size() <= 200
             && (d.get('email', '') == '' || d.get('email', '').matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'));
    }
    match /careRouting/{id} {
      // Which members are named, and a church address: nothing private, and
      // every reader's page needs it to know what is theirs.
      allow read: if (id == 'main' && active())
                  // status: is a safeguarding lead set? Written by the
                  // server only (careStatusSync), read by anyone signed in,
                  // so a form can say "this cannot be sent" before it is.
                  || (id == 'status' && active());
      allow write: if id == 'main' && isMaster()
                   && request.resource.data.keys().hasOnly(['care', 'pastoral', 'prayer', 'updatedAt', 'updatedBy'])
                   && careKinds(request.resource.data.get('care', {}))
                   && careKinds(request.resource.data.get('pastoral', {}))
                   && careKinds(request.resource.data.get('prayer', {}))
                   && request.resource.data.updatedBy == request.auth.uid;
    }

    function concernShape(d) {
      return d.keys().hasOnly(['kind', 'aboutMemberId', 'aboutName', 'noticed',
                               'happyToBeContacted', 'by', 'byName', 'at',
                               'dealtWith', 'dealtNote', 'dealtBy', 'dealtAt'])
             // 'care': "I'd like some pastoral care" (Care & support, Martin
             // 14 Oct 2026) - somebody asking for themselves. Read exactly
             // as a pastoral concern is, below.
             && (d.kind == 'pastoral' || d.kind == 'safeguarding' || d.kind == 'care')
             // Who it is about: picked from the address book, or typed.
             // One of the two has to say something, or the concern names
             // nobody and cannot be acted on.
             && (d.get('aboutName', '').size() > 0 || d.get('aboutMemberId', '').size() > 0)
             && d.get('aboutName', '').size() <= 120
             && d.get('aboutMemberId', '').size() <= 80
             && d.noticed is string && d.noticed.size() <= 4000
             && d.happyToBeContacted is bool
             // A concern says what was noticed. Somebody asking for care
             // need not say why - but it is about THEM (their own record,
             // never somebody else's), and asking is agreeing to be
             // contacted.
             && ((d.kind != 'care' && d.noticed.size() >= 5)
                 || (d.kind == 'care' && d.get('aboutMemberId', '') == me().get('memberId', '')
                     && d.happyToBeContacted == true))
             && d.by == request.auth.uid
             && d.byName is string && d.byName.size() <= 120
             && d.at == request.time
             && d.get('dealtWith', false) == false;
    }

    // A COLLECTION OF ITS OWN, and it has to be. `concerns` already exists
    // - the events window's safeguarding concerns raised at an event, keyed
    // by site, read by that site's safeguarding lead. Firestore ORs every
    // match block for a path, so a second block on `concerns` would hand
    // each set of documents the other's rules. A deliberate break proved it
    // live: with both on `concerns`, opening MY read rule unlocked THEIR
    // documents and three of their tests failed alongside mine. Separated,
    // the same break touches only the ten that are mine.
    match /worries/{worryId} {
      // Anybody in the address book may raise one. Someone noticing that a
      // neighbour has stopped coming is exactly who this is for, and they
      // are not necessarily on a team.
      allow create: if active() && concernShape(request.resource.data) && sgLeadSet();

      allow read: if (resource.data.kind == 'safeguarding' && sgLeadOrDeputy())
                  || ((resource.data.kind == 'pastoral' || resource.data.kind == 'care')
                      && (onPastoral() || sgLeadOrDeputy() || careNamed(resource.data.kind)));

      // Marking it dealt with, and nothing else. Not the words of the
      // concern, not who it is about, not who raised it - an account of
      // what somebody was worried about should not be editable after the
      // fact, by anyone.
      // The pastoral team closes what it reads (care-inbox.html); never a
      // safeguarding concern, which it cannot read either.
      allow update: if (sgLeadOrDeputy()
                        || ((resource.data.kind == 'pastoral' || resource.data.kind == 'care')
                            && (onPastoral() || careNamed(resource.data.kind))))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['dealtWith', 'dealtNote', 'dealtBy', 'dealtAt'])
                    && request.resource.data.dealtBy == request.auth.uid
                    && request.resource.data.get('dealtNote', '') is string
                    && request.resource.data.get('dealtNote', '').size() <= 2000;

      // NOBODY DELETES ONE from a page. How long concerns are kept is the
      // safeguarding lead's decision to confirm before switch-over (§24),
      // and when it is made it belongs in a scheduled function with the
      // Admin SDK - not in a button somebody can press in a hurry.
      allow delete: if false;
    }

    // ---- TEAMS AS DATA (APP-A1 §4, steps 1-2) --------------------------
    // teamId IS THE TEAM'S NAME as the rules already spell it - 'Kids
    // Church', 'Worship Team'. That one decision is what makes this cheap:
    // every markers array, every adminFor, and every team name written into
    // a rule keeps working untouched. THE RULES DO NOT READ THIS
    // COLLECTION, and must not: a team's name appearing here grants
    // nothing by itself, or adding a team would be a way of granting
    // access. `markers` on an address book record stays the only switch.
    //
    // A GROUP IS A TEAM WITH rota: false (NEXT-BRIEF §25) - Church office,
    // Bookings, Elders, Finance. `runs` on it names the Running things tabs
    // its members see.
    match /teams/{teamId} {
      // Everyone needs the labels and colours to draw anything, and there
      // is nothing private in it.
      allow read: if active();
      // Adding a team gives access to whoever is ticked into it, and `runs`
      // decides who runs things - neither is an ordinary admin job.
      // TEAMS & GROUPS (Martin, 15 Oct 2026): master admins and the Church
      // office job keep the list (teams-admin.html). The office may not
      // change `runs` - who runs things stays a master admin's - and nobody
      // deletes one: archive, never remove (markers and history stay).
      // coreFor (H-15): the teams this one is the core team for. Like runs,
      // it gives people access, so it is a master admin's: the office may
      // keep the list but not change what a team covers.
      allow write: if (isMaster() || (raOffice()
                        && request.resource.data.get('runs', []) == (resource == null ? [] : resource.data.get('runs', []))
                        && request.resource.data.get('coreFor', []) == (resource == null ? [] : resource.data.get('coreFor', []))
                        && request.resource.data.get('board', '') == (resource == null ? '' : resource.data.get('board', ''))))
                   && request.resource.data.keys().hasOnly(['name', 'label', 'colour', 'tint',
                        'parent', 'rota', 'tabs', 'runs', 'under18', 'order', 'archived', 'coreFor', 'board',
                        'updatedAt', 'updatedBy'])
                   && request.resource.data.get('board', '') is string && request.resource.data.get('board', '').size() <= 60
                   && request.resource.data.get('coreFor', []) is list
                   && request.resource.data.get('coreFor', []).size() <= 500
                   && !(teamId in request.resource.data.get('coreFor', []))
                   && request.resource.data.get('name', '') == teamId
                   && request.resource.data.get('rota', true) is bool
                   && request.resource.data.get('runs', []) is list
                   && request.resource.data.get('runs', []).size() <= 4
                   && request.resource.data.get('runs', []).hasOnly(['today', 'people', 'bookings', 'send']);
    }

    // ---- SAFEGUARDING: teams that work with under-18s ------------------
    // NEXT-BRIEF §24, Martin, 10 October 2026: "nobody without an in-date
    // DBS check and training can be put on a ticked team's slot."
    //
    // THE SAME FIVE NAMES ARE IN egbc-auth.js (TEAMS, `under18: true`),
    // because the rules cannot read that file and the interface cannot read
    // these. tests/check-under18-teams-agree.mjs reads both and fails if
    // they ever differ, so adding a team in one place tells you about the
    // other. Creche is not here because it is not a team: the address book
    // holds it as roles inside Kids Church.
    // The Kids & Youth Core Team too (H-15, Martin, 26 Oct 2026): a core
    // team covering an under-18s team works with under-18s itself.
    // From each team's own tick (teamFlags/under18, kept by the events
    // window's under18OnTeam, F-304); EGBC's five when nothing is stored.
    function under18Teams() {
      let p = /databases/$(database)/documents/teamFlags/under18;
      return exists(p) ? get(p).data.teams : ['Kids Church', 'Youth Worship', 'Lazers', 'ReNu', 'Kids & Youth Core Team'];
    }
    function eventIsUnder18() {
      return request.resource.data.get('teams', []).hasAny(under18Teams());
    }

    // In-date DBS and training, judged by checksInDate() - the events
    // window's, against the years in Safeguarding settings (F-109). Reused
    // rather than written again: one definition of "cleared" for the whole
    // church, so the rota and the under-18s groups cannot drift apart.
    //
    // An exception is recorded by a master admin or the safeguarding lead
    // with a reason, in rotaExceptions. UNLIKE the groups one, which is per
    // group, this covers the person for under-18s rota work generally: a
    // church rota is one thing, where a group is many.
    function rotaCleared(memberId) {
      return memberId is string && memberId != ''
             && (checksInDate(memberId)
                 || exists(/databases/$(database)/documents/rotaExceptions/$(memberId)));
    }

    // WHICH SLOT CHANGED, and it is the page that says so - proved on the
    // emulator rather than assumed, because two things are not as they look:
    // affectedKeys() returns a SET, which cannot be indexed ([0] gives
    // "Function not found"), and indexing a map by a key that is not there
    // is an evaluation error, so it fails closed.
    //
    // The page names the slot in lastSlot. It cannot lie: affectedKeys()
    // must be exactly that one slot, so filling a different slot while
    // naming an empty one is refused. There is no shadow list to trust.
    function slotName() { return request.resource.data.get('lastSlot', ''); }
    function slotsChanged() {
      return request.resource.data.get('assignments', {})
               .diff(resource.data.get('assignments', {})).affectedKeys();
    }
    function slotEmptied() {
      return !(slotName() in request.resource.data.get('assignments', {}));
    }
    function personInSlot() {
      return request.resource.data.assignments[slotName()].get('id', '');
    }
    function safeguardingOk() {
      return !eventIsUnder18()
             // A new under-18s event starts empty and is filled a slot at a
             // time, so there is never a create to check. An event arriving
             // complete would need one clearance per slot, and the document
             // access limit does not allow that - the same reason F-109
             // checks the one leader added rather than all of them.
             || (resource == null
                   ? request.resource.data.get('assignments', {}).keys().size() == 0
                   : (slotsChanged().size() == 0
                      || (slotsChanged().size() == 1 && slotsChanged().hasOnly([slotName()])
                          && (slotEmptied() || rotaCleared(personInSlot())))));
    }

    // The exception, and who may record one: a master admin, or the
    // safeguarding lead named in Safeguarding settings. A reason is
    // required and has to be a sentence, not a shrug - the same shape and
    // the same floor as smallGroupExceptions (F-109).
    function sgLeadChurchwide() {
      return exists(/databases/$(database)/documents/safeguardingSettings/defaults)
             && sgLeadOf(get(/databases/$(database)/documents/safeguardingSettings/defaults).data.get('leadSiteId', ''));
    }
    match /rotaExceptions/{memberId} {
      // Anybody planning a rota needs to see why somebody is allowed on it,
      // and the person themselves can see their own.
      allow read: if volunteer();
      allow create, update: if (isMaster() || sgLeadChurchwide())
                   && memberId == request.resource.data.get('memberId', '')
                   && request.resource.data.keys().hasOnly(['memberId', 'name', 'reason', 'by', 'byName', 'at'])
                   && request.resource.data.reason is string
                   && request.resource.data.reason.size() >= 10
                   && request.resource.data.reason.size() <= 1000
                   && request.resource.data.by == request.auth.uid
                   && request.resource.data.at == request.time;
      allow delete: if isMaster() || sgLeadChurchwide();
    }

    match /availability/{docId} {
      allow read: if volunteer();
      // THE OPEN CREATE IS GONE. It checked that an answer looked like an
      // answer, not that it was yours: anyone who had read the address book -
      // which anyone could - held every member id, and could mark anybody
      // available or unavailable for anything. The form writes through the
      // saveAnswer function now, which will only accept an answer for a
      // person whose email address the caller proved they can receive mail at.
      //
      // A signed-in planner still edits answers on the rota's behalf, which is
      // what the Core Team app does. Delete was canAct('Kids Church') alone,
      // which refused the Core Team app's own "clear this answer" - it has
      // never been exercised because these rules are not deployed yet.
      allow create, update: if volunteer();
      allow delete: if volunteer();
    }

    // ---- knowledge base ---------------------------------------------

    match /kb_troubleshoot_av/{docId} {
      allow read: if volunteer();
      allow write: if canAct('AV Team');
    }

    match /kb_howto_av/{docId} {
      allow read: if volunteer();
      allow write: if canAct('AV Team');
    }

    // ---- songs and library ------------------------------------------

    match /songs/{docId} {
      // The projection PC reads the words and the chords. See churchShow().
      // The youth app picks from the same library. See youthGranted().
      allow read: if volunteer() || churchShowServices() || youthGranted();
      allow write: if isAdmin();
    }

    // ---- team panels ---------------------------------------------------
    // A block of welcome content per team, shown on the landing page under the
    // church-wide one. Someone on Worship and Kids Church sees both.

    match /teamContent/{team} {
      allow read: if volunteer();
      allow write: if adminOf(team);
    }

    // ---- pin boards ----------------------------------------------------
    // One document per board: 'state' is the worship one and keeps its name,
    // with Kids Church and the youth alongside it. Each is readable and
    // writable only by the teams it belongs to, so a note pinned to the Kids
    // Church board is not church-wide reading.

    // Which group a board belongs to, in one place, so the board rules and
    // the suggestion rules cannot drift apart.
    function boardGroup(boardId) {
      return boardId == 'renu' ? 'ReNu'
           : boardId == 'lazers' ? 'Lazers'
           : boardId == 'kids-church' ? 'Kids Church'
           : boardId == 'youth' ? 'Youth Worship'
           : boardId == 'core-team' ? 'Core Team'
           : '';
    }

    function boardIsMine(boardId) {
      return isMaster()
        // KIDS CHURCH IS THE WHOLE TEAM, the same as Youth (Martin, 10 Oct
        // 2026): "Its an ideas board. Its pointless chopping off the people
        // we want ideas from." It was built leaders-only on the 9 October
        // note and that has been corrected here and in the page.
        || (boardId == 'kids-church'
            && (onTeam('Kids Church') || adminOf('Kids Church')))
        || (boardId == 'youth'
            && (onTeam('Youth Worship') || adminOf('Youth Worship')))
        // CORE TEAM'S OWN BOARD (Martin, 10 Oct 2026). Everyone on the
        // team, nobody else - not every admin, and not Worship, who have
        // their own.
        || (boardId == 'core-team'
            && (onTeam('Core Team') || adminOf('Core Team')))
        // ReNu and Lazers: the adults on the group write it directly, as the
        // worship team does theirs. A young person's post goes through
        // boardSuggestions below and a leader puts it up.
        || ((boardId == 'renu' || boardId == 'lazers')
            && (onTeam(boardGroup(boardId)) || adminOf(boardGroup(boardId))))
        || (boardId == 'state'
            && (onTeam('Worship Team') || onTeam('AV Team') || onTeam('Choir')
                || adminOf('Worship Team')));
    }

    // A PARENT READS THEIR CHILDREN'S YOUTH BOARDS (6c, the reviewing
    // window 13 Oct 2026). familyGroups is written by the server only
    // (functions/family.js), from the household; nobody can write it about
    // themselves (the users rules). Reading only - writing is unchanged.
    function familyBoard(boardId) {
      return (boardId == 'youth' || boardId == 'renu' || boardId == 'lazers')
             && active() && boardGroup(boardId) in me().get('familyGroups', []);
    }

    match /worshipBoardState/{boardId} {
      // A young person READS the youth board and writes nothing. Not 'state':
      // that is the worship team's, and the whole point of one document per
      // board is that a note pinned to one is not church-wide reading.
      //
      // youthapp2.html read and wrote 'state' until 9 October 2026, which was
      // wrong twice over - it showed the youth the worship team's board, and
      // it would have been refused anyway for an adult on Youth Worship, who
      // is not on Worship Team. It reads 'youth' now.
      allow read: if boardIsMine(boardId)
                  || (youthGranted() && boardId == 'youth')
                  || ((boardId == 'renu' || boardId == 'lazers')
                      && youthInGroup(boardGroup(boardId)))
                  || familyBoard(boardId);
      allow write: if boardIsMine(boardId);
    }

    // ---- what a young person posts, before a leader has seen it ------
    //
    // ONE DOCUMENT PER POST, which is the whole reason this collection
    // exists: a board is one document holding every note, so letting a child
    // write it would let them rewrite everybody else's. Here each post stands
    // alone, and until a leader copies it onto the board it is not on the
    // board - "waits for a leader before others see it" is true by
    // construction rather than by a flag somebody has to check.
    //
    // NO SURNAMES AND NO CONTACT DETAILS: the allowed keys hold neither an
    // email nor a telephone number, and firstName must have no space in it,
    // which is what stops a surname. What the rules CANNOT do is stop a child
    // typing a number into the text - nothing can, short of refusing free
    // text - and that is what the moderation is for.
    function suggestionShape(d, boardId) {
      return d.keys().hasOnly(['boardId', 'text', 'firstName', 'byUid', 'createdAt'])
             && d.boardId == boardId
             && d.byUid == request.auth.uid
             && d.text is string && d.text.size() > 0 && d.text.size() <= 500
             && d.firstName is string && d.firstName.size() > 0
             && d.firstName.size() <= 40
             && !d.firstName.matches('.*\\s.*');
    }

    match /boardSuggestions/{suggestionId} {
      // A leader of the group sees the queue. The child sees their own, so
      // the app can say "waiting for a leader".
      allow get: if isMaster()
                 || adminOf(boardGroup(resource.data.get('boardId', '')))
                 || onTeam(boardGroup(resource.data.get('boardId', '')))
                 || (request.auth != null && resource.data.get('byUid', '') == request.auth.uid);
      // A list is for the queue, so it is the group's adults only - a child
      // listing the queue would read every other child's unapproved post.
      allow list: if isMaster()
                  || adminOf(boardGroup(resource.data.get('boardId', '')))
                  || onTeam(boardGroup(resource.data.get('boardId', '')));

      // THE YOUTH BOARD IS MODERATED TOO (Martin, 10 Oct 2026). It let a
      // young person with a live code READ it and suggest nothing, which
      // "cuts off exactly the people we want ideas from". Same shape, same
      // queue, same no-surname and no-contact-details rules as ReNu and
      // Lazers: the young person posts a suggestion, an adult on Youth
      // Worship puts it up.
      allow create: if (suggestionId.matches('renu__.*') || suggestionId.matches('lazers__.*')
                        || suggestionId.matches('youth__.*'))
                    && youthInGroup(boardGroup(request.resource.data.get('boardId', '')))
                    && suggestionShape(request.resource.data,
                         suggestionId.matches('renu__.*') ? 'renu'
                         : suggestionId.matches('lazers__.*') ? 'lazers' : 'youth');

      // LEADERS CAN REMOVE ANYTHING (Martin). A child may also withdraw
      // their own, which is not "removing anything" - it is theirs.
      allow delete: if isMaster()
                    || adminOf(boardGroup(resource.data.get('boardId', '')))
                    || onTeam(boardGroup(resource.data.get('boardId', '')))
                    || (request.auth != null && resource.data.get('byUid', '') == request.auth.uid);

      // Nobody edits one. A leader approves by putting it on the board and
      // deleting it, so there is no half-approved state to reason about.
      allow update: if false;
    }

    // ---- comments on a pin board note (APP-DESIGN-BRIEF 7f) ----------
    //
    // ONE DOCUMENT PER COMMENT, and the brief says so in as many words:
    // "The board is one document holding every note, so comments MUST NOT
    // go in it." The reason is the same one that put suggestions in their
    // own collection - a board is a single document, so anyone allowed to
    // add a comment to it would be allowed to rewrite every note on it.
    // Here a comment stands alone and the worst anyone can do to the board
    // by commenting is add a row beside it.
    //
    // WHO IS A LEADER OF A BOARD, for deleting somebody else's comment.
    // Deliberately NARROWER than who may write the board: everyone on Kids
    // Church can pin a note and comment, but taking down another person's
    // words is a leader's job.
    function boardLeader(boardId) {
      return isMaster()
             || (boardId == 'state' && adminOf('Worship Team'))
             || (boardGroup(boardId) != '' && adminOf(boardGroup(boardId)));
    }

    function commentShape(d) {
      return d.keys().hasOnly(['boardId', 'noteId', 'text', 'byUid', 'byName', 'createdAt'])
             && d.boardId is string && d.boardId.size() > 0 && d.boardId.size() <= 40
             && d.noteId is string && d.noteId.size() > 0 && d.noteId.size() <= 60
             && d.text is string && d.text.size() > 0 && d.text.size() <= 500
             && d.byName is string && d.byName.size() > 0 && d.byName.size() <= 80
             // The author is whoever is signed in, not whoever the page says.
             && d.byUid == request.auth.uid;
    }

    match /boardComments/{commentId} {
      // READ: whoever can read that board, which includes a young person
      // with a live code on their own group's board - they read the notes,
      // so they read what is said about them.
      allow read: if boardIsMine(resource.data.boardId)
                  || (youthGranted() && resource.data.boardId == 'youth')
                  || ((resource.data.boardId == 'renu' || resource.data.boardId == 'lazers')
                      && youthInGroup(boardGroup(resource.data.boardId)))
                  || familyBoard(resource.data.boardId);

      // CREATE: whoever can WRITE that board - the adults on the team.
      //
      // YOUNG PEOPLE DO NOT COMMENT AT LAUNCH, which is Martin's decision
      // and not an oversight: on the moderated boards (Youth, ReNu,
      // Lazers) their way in stays "Suggest an idea" through a leader, so
      // that an adult reads anything they write before anybody else does.
      // boardIsMine() is false for a youth-code account, so this is true
      // by construction rather than by a flag - the same reasoning as the
      // suggestions queue above. When that changes it changes HERE, in one
      // place, and the check below is what will notice.
      allow create: if boardIsMine(request.resource.data.boardId)
                    && commentShape(request.resource.data);

      // DELETE: the person who wrote it, or a leader of that board.
      allow delete: if (request.auth != null && resource.data.byUid == request.auth.uid)
                    || boardLeader(resource.data.boardId);

      // NOBODY EDITS A COMMENT (the brief: "No editing comments"). An
      // edited comment with the same name and date on it is a quiet way to
      // put words in somebody's mouth; deleting and writing again is
      // honest about what happened.
      allow update: if false;
    }

    // ---- news ---------------------------------------------------------
    // One document per notice, with a `teams` array. An empty array means
    // everyone; otherwise only people on one of those teams see it, which is
    // what keeps youth notices carrying places and times away from others.

    // URGENT ALSO GOES TO PHONES (N-4, functions/notify.js onNotice), once,
    // to everyone it is for. Martin, 13 Oct 2026: only the Church office
    // group and the master admin may do that, not every admin. A notice
    // that is already urgent may still be edited by its admins - that
    // sends nothing, the phones were told the first time.
    function urgentOk() {
      return request.resource.data.get('urgent', false) != true
             || (resource != null && resource.data.get('urgent', false) == true)
             || raOffice();
    }
    // WHO MAY POST A NOTICE (Martin, 16 Oct 2026, any church): the church
    // office and master admins, to anyone (teams [] is everyone); a team
    // leader - somebody who administers a team - only to their own teams,
    // never to everyone. Changing or removing one follows the same line:
    // a leader only touches notices that are wholly their teams'.
    function noticeTeamsMine(teams) {
      return teams is list && teams.size() > 0 && teams.hasOnly(me().get('adminFor', []));
    }
    function mayNoticeTo(teams) {
      return raOffice() || (isAdmin() && noticeTeamsMine(teams));
    }
    match /news/{itemId} {
      allow read: if active();
      allow create: if mayNoticeTo(request.resource.data.get('teams', [])) && urgentOk();
      allow delete: if mayNoticeTo(resource.data.get('teams', []));

      // Anyone active may add themselves to ackedBy, and nothing else -
      // that is the "I have read it" button.
      allow update: if (mayNoticeTo(resource.data.get('teams', []))
                        && mayNoticeTo(request.resource.data.get('teams', [])) && urgentOk())
                    || (active()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackedBy'])
                        && request.resource.data.ackedBy.hasAll(resource.data.get('ackedBy', [])));
    }

    // ---- availability requests ---------------------------------------
    // Who has already been asked about a term, so a second send from another
    // team does not ask the same people again.

    match /availabilityRequests/{term} {
      allow read: if volunteer();
      allow write: if isAdmin();
    }

    // ---- youth access ------------------------------------------------
    // Young people cannot have accounts - the church does not hold minors'
    // email addresses. Instead a single-use code is emailed to a parent and
    // redeemed once on the young person's own device, which is then bound to
    // an anonymous Firebase account. See YOUTH-ACCESS.md.

    // WHAT THIS OPENS, and the list is deliberately short - it is every
    // collection youthapp2.html asks for and no others. YOUTH-ACCESS.md says
    // why each one is there.
    //
    //   songs                the library the planner picks from
    //   services             the plans
    //   events               which services there are, to choose one
    //   portal/dashboardContent  the welcome panel
    //   kb_playthrough       published articles only
    //   kb_training_worship  published articles only
    //   worshipBoardState/youth  the youth board, and NOT 'state', which
    //                        belongs to the worship team
    //
    // READ ONLY, everywhere. A young person writes nothing: saving a plan,
    // the board and the song library all need canAct('Youth Worship') or
    // isAdmin() already, so this takes nothing away.
    //
    // AND NEVER addressBook. The church does not hold minors' email
    // addresses and a young person's phone does not hold the adults'.
    // The young person's own access record, or null. youthGranted() reads it
    // too, and two identical get()s in one evaluation are one document read.
    function youthRec() {
      return get(/databases/$(database)/documents/youthAccess/$(request.auth.uid));
    }

    // WHICH GROUP. redeemYouthCode copies the youth groups off the child's
    // address book record into `groups` when the code is redeemed, so the
    // rules can tell a Lazers child from a ReNu one without reading the
    // address book - which would hand over every field of it (rules cannot
    // project). If the office moves a child between groups, the next code
    // moves them here.
    function youthInGroup(group) {
      return youthGranted() && group in youthRec().data.get('groups', []);
    }

    function youthGranted() {
      return request.auth != null
             && exists(/databases/$(database)/documents/youthAccess/$(request.auth.uid))
             && get(/databases/$(database)/documents/youthAccess/$(request.auth.uid)).data.active == true
             && get(/databases/$(database)/documents/youthAccess/$(request.auth.uid)).data.expiresAt > request.time;
    }

    // A record, or null if it is not there. get() returns null for a missing
    // document and null.data is an evaluation error rather than false, so
    // every use below is guarded - and two identical get()s in one evaluation
    // count as one document read, which is why this costs two reads and not
    // four (the lesson from active(), A-037).
    function bookRec(id) {
      return get(/databases/$(database)/documents/addressBook/$(id));
    }

    // NO YOUNG PERSON GETS IN WITHOUT A PARENT RECEIVING THE CODE, and that
    // is now the rule's business rather than the page's (Martin, after A-045
    // pointed out it was only the page's).
    //
    // It asks about the HOUSEHOLD, not about a string somebody typed:
    //
    //   the code is for a record that exists and is flagged Under 16
    //   that record's household head is the record named as the parent
    //   the parent's record exists and carries an email address
    //   the address the code is being sent to is THAT address
    //
    // So an admin cannot write a grant for a child with no parent on file,
    // cannot name somebody else's parent, and cannot send it anywhere except
    // the address the church holds for that household.
    function grantHasParent(d) {
      let child = d.get('memberId', '');
      let parent = d.get('parentId', '');
      return child != '' && parent != ''
             && bookRec(child) != null
             && bookRec(parent) != null
             && bookRec(child).data.get('isMinor', false) == true
             && bookRec(child).data.get('householdId', '') == parent
             && bookRec(parent).data.get('email', '') != ''
             && d.get('sentTo', '') == bookRec(parent).data.get('email', '');
    }

    match /youthGrants/{code} {
      // SHUT TO EVERY PAGE. This document holds `sentTo`, the PARENT'S EMAIL
      // ADDRESS, and it used to be `allow get: if true` so that
      // youth-access.html could look a code up before anybody was signed in.
      // Anybody holding a code could therefore read a parent's address off
      // it - a forwarded email, a screenshot, a code already used (A-045).
      //
      // redeemYouthCode does the lookup now, with the Admin SDK, which does
      // not come through these rules. An admin may still list them, because
      // the hub's youth panel shows what has been issued.
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && grantHasParent(request.resource.data);
      allow delete: if isAdmin();

      // Marking a code used is redeemYouthCode's job, in the same
      // transaction as the check - so the clause that let the redeemer do it
      // from a phone is gone.
      //
      // IT WOULD STILL HAVE WORKED WITHOUT IT, which is why this is worth
      // saying: a write needs no read, so even with `get` shut to admins a
      // phone could have blind-written `redeemedAt` and `uid` onto somebody
      // else's live code and burnt it. Nothing read it back, so nothing would
      // have noticed until a young person's real code stopped working. Caught
      // by a rules check that expected the refusal and did not get it.
      //
      // An admin may still cancel one (active: false) from the youth panel.
      allow update: if isAdmin();
    }

    match /youthAccess/{uid} {
      // Their own record, so the app can greet them and the page can tell
      // whether this device has already redeemed something. Admins see all
      // of them, for the hub's youth panel.
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if isAdmin();

      // WRITTEN ONLY BY redeemYouthCode, with the Admin SDK. It used to be
      // written by the phone, which is why the rule above it had to be open:
      // the page read the grant, then wrote this, then burnt the grant. Three
      // steps a page could get half way through, and one of them handed over
      // a parent's email address. One function does all three now, in a
      // transaction, and nothing on a phone may write here at all.
      allow create: if false;
    }

    // ---- the video library ------------------------------------------
    // One collection for every team, with the team on each record - the same
    // shape as the news feed. A person sees their own teams' videos; the
    // team's admin is the one who can add and remove them, which is what
    // lets Karen put a video up without going through the Core Team.

    match /teamVideos/{videoId} {
      allow read: if isMaster()
                  || (active() && (onTeam(resource.data.team)
                                   || adminOf(resource.data.team)));
      allow create: if canAct(request.resource.data.team);
      allow update, delete: if canAct(resource.data.team);
    }

    // The sections a team has made for its own videos - one document per
    // team, holding a list of names.
    match /videoSections/{teamSlug} {
      allow read: if volunteer();
      allow write: if canAct(request.resource.data.team);
    }

    // ---- the rota sign-off ------------------------------------------
    // One document per term and team, saying that department has finished.
    // Anyone who administers a team may sign that team off; the planner
    // clears them again on the next edit.

    match /rotaSignoff/{key} {
      allow read: if volunteer();
      allow write: if isAdmin();
    }

    // ---- documents and links ----------------------------------------

    match /resources/{itemId} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // ---- the rest of the knowledge base ------------------------------
    // Play-through and worship training sit alongside the two AV ones above.

    match /kb_playthrough/{docId} {
      // Published articles only. The youth app's query already asks for
      // published == true, which is what lets a rule say so: for a list,
      // Firestore allows a query whose own constraints guarantee the rule.
      allow read: if volunteer()
                  || (youthGranted() && resource.data.published == true);
      allow write: if canAct('Worship Team');
    }

    match /kb_training_worship/{docId} {
      // Published articles only, as above.
      allow read: if volunteer()
                  || (youthGranted() && resource.data.published == true);
      allow write: if canAct('Worship Team');
    }

    // ---- service plans -----------------------------------------------
    // What the Sunday Service Planner saves, and what the projection
    // software reads back. Everyone signed in can see the plan for a
    // Sunday; building one is a worship job.

    // EVERYONE ON THE SUNDAY PLAN EMAIL CAN READ THE PLAN (Martin,
    // 12 Oct 2026: "That includes the preachers and service leader").
    //
    // The planner writes an `audience` of uids when the plan is saved or
    // sent - the people the rota names, plus the serviceLeader and the
    // speaker, resolved through the address book. This lets those uids
    // read the document and nobody else.
    //
    // WHY A LIST AND NOT A QUESTION. Being "on this Sunday" is a fact
    // about the rota event, the address book and the users mirror; rules
    // cannot join three collections, and asking the page to prove it
    // would put three reads in front of every plan anybody opens.
    //
    // THE TEAMS ARE NOT IN THE LIST. Worship, AV, Choir and Core Team
    // already read these through volunteer(), and a list of their uids
    // would be stale the moment somebody joined. Only the named people
    // are written down, because they are the ones no team covers - which
    // is the whole fault being fixed.
    function onThePlan() {
      return signedIn() && request.auth.uid in resource.data.get('audience', []);
    }

    // The field is a list of uids and nothing else. Without this a
    // planner could put anything in it, and `audience` is a read gate.
    function audienceShape(d) {
      return d.get('audience', []) is list
             && d.get('audience', []).size() <= 300
             && d.get('audienceUnresolved', []) is list
             && d.get('audienceUnresolved', []).size() <= 50;
    }

    match /services/{serviceId} {
      // The projection PC reads the service plan. See churchShow().
      // The youth app reads it to plan a youth service. See youthGranted().
      allow read: if volunteer() || churchShowServices() || youthGranted() || onThePlan();
      allow write: if (canAct('Worship Team') || canAct('Youth Worship'))
                   && audienceShape(request.resource.data);
    }

    // THIS COLLECTION HAD NO RULE AT ALL, so the catch-all at the bottom
    // refused it - and three pages use it: SundayServicePlanner.html writes
    // it (line ~552), youthserviceplanner.html writes it (~800), and
    // song-summary.html reads it (~148). All three would have stopped working
    // the day the rules were deployed. Found while answering ChurchShow's
    // question about whether anything still writes it; it does.
    //
    // One document per Sunday, keyed by the date: the song list for the
    // service, which is what ChurchShow falls back to when it has no plan.
    match /songSummaries/{date} {
      // The same audience as the service it belongs to: the link in the
      // plan email goes here, so this is the document a preacher who is
      // on no team actually opens.
      allow read: if volunteer() || churchShowServices() || onThePlan();
      allow write: if (canAct('Worship Team') || canAct('Youth Worship'))
                   && audienceShape(request.resource.data);
    }

    // ---- the AV team's own two -------------------------------------
    // Neither of these had a rule, so the catch-all at the bottom denied
    // them: the inventory and the schematic would not have read, let alone
    // saved, the day the rules were deployed. Both are AV's working tools,
    // and both are read by anyone on a team who wants to know what is
    // plugged into what.

    match /inventory/{itemId} {
      allow read: if volunteer();
      allow write: if canAct('AV Team') || isAdmin();
    }

    match /av_schematic/{docId} {
      allow read: if volunteer();
      allow write: if canAct('AV Team') || isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if volunteer();
      allow write: if canAct('Worship Team') || canAct('Youth Worship');
    }

    // ---- older shared content ----------------------------------------
    // The legacy portal menu, the page content blocks and the saved email
    // drafts. Readable by the team, changed by whoever manages something.

    match /portal/{docId} {
      // One document, the welcome panel the youth app draws on its home
      // screen. Not the rest of the older shared content.
      allow read: if volunteer()
                  || (youthGranted() && docId == 'dashboardContent');
      allow write: if isAdmin();
    }

    match /pageContent/{docId} {
      allow read: if volunteer();
      allow write: if isAdmin();
    }

    // ANYONE ON CORE TEAM, NOT ONLY AN ADMIN (Martin, 11 Oct 2026, "as on
    // the old portal"). EmailBuilder2.html was gated data-role="leader"
    // and this was isAdmin(), which is the same mistake twice: a Core Team
    // member who writes the church email was refused at the door and would
    // have been refused the drafts behind it. The page gate has gone; this
    // is the half that actually protects the data.
    //
    // A draft is the church's own wording before it is sent. It carries no
    // personal data of anybody else - the addresses are chosen at sending
    // time, not stored here - so Core Team reading and writing all of them
    // is the right shape, and that is why this is not narrowed to the
    // person who wrote it.
    // The Email Compiler's drafts follow who may email (Martin, 16 Oct 2026,
    // which replaces 11 Oct's "anyone on Core Team"): team leaders, the
    // church office and master admins.
    match /emailDrafts/{draftId} {
      allow read, write: if raOffice() || isAdmin();
    }

    // THE E-NEWS (comms window, 19 Oct 2026; FINDINGS-comms). The office
    // and master admins write issues as drafts or scheduled; only the
    // hub's server moves one to sending or sent, and a sent issue is
    // never changed or deleted - it is the record of what went out.
    // Settings are the church's look and footer. Neither is public: the
    // web version is a separate, server-written copy without the
    // members-only blocks (later step).
    // The office job (H-9): the church's own teams for it; EGBC's Church office
    // when nothing is stored (main's raOffice, master admins included).
    function enewsOffice() { return raOffice(); }
    function enewsIssueOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['subject', 'preheader', 'template', 'colours', 'blocks', 'status', 'sendAt',
                               'htmlMembers', 'htmlEveryone', 'week', 'kind', 'audience', 'team', 'picked', 'templateId',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        // A one-off email (plan F): who it goes to. The server works the list
        // out from these when it sends; a page never hands it addresses.
        && d.get('kind', 'enews') in ['enews', 'oneoff']
        && d.get('audience', 'subscribers') in ['subscribers', 'members', 'team', 'picked']
        && d.get('team', '') is string && d.get('team', '').size() <= 60
        && d.get('picked', []) is list && d.get('picked', []).size() <= 300
        && d.get('templateId', '') is string && d.get('templateId', '').size() <= 60
        && d.status in ['draft', 'scheduled']
        && d.subject is string && d.subject.size() <= 200
        && d.get('preheader', '') is string && d.get('preheader', '').size() <= 200
        && d.get('template', 'classic') in ['classic', 'green']
        && d.blocks is list && d.blocks.size() <= 80
        && d.get('sendAt', '') is string && d.get('sendAt', '').size() <= 40
        && d.get('week', '') is string && d.get('week', '').size() <= 10
        // The two finished copies, saved by Schedule (functions/enews-send.js
        // sends them); a scheduled issue must have both.
        && d.get('htmlMembers', '') is string && d.get('htmlMembers', '').size() <= 600000
        && d.get('htmlEveryone', '') is string && d.get('htmlEveryone', '').size() <= 600000
        && (d.status != 'scheduled' || (d.get('htmlMembers', '').size() > 0 && d.get('htmlEveryone', '').size() > 0))
        && d.updatedBy == request.auth.uid;
    }
    match /enewsIssues/{id} {
      // Who was sent this issue, written by the sender as it goes.
      match /sends/{subId} {
        allow read: if enewsOffice();
        allow write: if false;
      }
      allow read: if enewsOffice();
      allow create: if enewsOffice() && enewsIssueOk() && request.resource.data.createdBy == request.auth.uid;
      allow update: if enewsOffice() && enewsIssueOk()
                    && resource.data.status in ['draft', 'scheduled']
                    && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
                    && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');
      allow delete: if enewsOffice() && resource.data.status == 'draft';
    }
    // SUBSCRIBERS (C-10): people's email addresses and the record of how
    // each agreed. The office reads them; NOBODY writes them from a page -
    // sign-up, confirm, unsubscribe, bounces and the office's "add by hand"
    // all go through the hub's functions (functions/enews.js), which keep
    // the history. Webhook receipts (hqMailEvents) are the server's alone.
    match /enewsSubscribers/{id} {
      allow read: if enewsOffice();   // subscribers: the office
      allow write: if false;          // subscribers: functions only
    }
    // THE WEB VERSION AND ARCHIVE: everybody else's copy of each sent
    // e-news, without the members-only blocks, written by the sender.
    // Public, like the e-news was on Mailchimp - and never the members' copy.
    // "Preview web version" (functions/enews-preview.js): read by its
    // unguessable link only - get, never list - and written by the server only.
    match /enewsPreview/{id} {
      allow get: if true;
      allow list: if false;           // previews: never listed
      allow write: if false;          // previews: the server only
    }
    match /enewsWeb/{id} {
      allow read: if true;
      allow write: if false;          // web version: the sender only
    }
    // CANVA'S TOKENS AND SIGN-IN STATE (comms window; functions/canva.js):
    // the server's alone, never a page - not even a master admin's.
    match /integrationSecrets/{id} {
      allow read, write: if false;    // integration secrets: the server only
    }
    match /hqMailEvents/{id} {
      allow read, write: if false;
    }
    // SOCIAL POSTS, step 1 (FINDINGS-comms plan H): a countdown's post for
    // each day, kept until it is posted from someone's phone, and the
    // card maker's settings (hashtags, the verse of the day, who is
    // reminded). The church office and master admins; nothing public.
    // TEMPLATES (plan G): the church's own, made with "Save as a template".
    // The starters live in the hub's code (egbc-starters.js), not here.
    match /emailTemplates/{id} {
      allow read: if enewsOffice();   // email templates: the office
      allow delete: if enewsOffice();
      allow create, update: if enewsOffice()
        && request.resource.data.keys().hasOnly(['name', 'about', 'group', 'subject', 'preheader', 'template', 'audience', 'blocks', 'archived',
             'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.blocks is list && request.resource.data.blocks.size() <= 80
        && request.resource.data.get('audience', 'subscribers') in ['subscribers', 'members', 'team', 'picked']
        && request.resource.data.updatedBy == request.auth.uid;
    }
    // Unsplash searches kept a day, the hour's count and pings owed (functions/unsplash.js): the server only.
    // A members' meeting's papers: each member's own link, kept as its hash (functions/meeting-papers.js): the server only.
    // Who has had a welcome email (functions/welcome-mail.js): the server only.
    match /welcomeSent/{id} {
      allow read, write: if false;   // welcomes sent: the server only
    }
    match /meetingPaperLinks/{id} {
      allow read, write: if false;   // paper links: the server only
    }
    match /unsplashCache/{id} {
      allow read, write: if false;   // unsplash cache: the server only
    }
    match /socialPosts/{id} {
      allow read: if enewsOffice();   // social posts: the office
      allow delete: if enewsOffice();
      allow create, update: if enewsOffice()
        && request.resource.data.keys().hasOnly(['date', 'kind', 'eventId', 'title', 'opening', 'caption', 'status', 'postedAt',
             'mode', 'size', 'style', 'vstyle', 'accent', 'words', 'verse', 'photoUrl', 'createdBy', 'createdAt'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.kind in ['countdown', 'post']
        && request.resource.data.status in ['ready', 'posted']
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 2200;
    }
    match /socialSettings/{id} {
      allow read: if enewsOffice();
      allow write: if enewsOffice() && id == 'main'
        && request.resource.data.keys().hasOnly(['usual', 'sets', 'vod', 'vodDone', 'remind', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('remind', []) is list && request.resource.data.get('remind', []).size() <= 20
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /enewsSettings/{id} {
      allow read: if enewsOffice();
      // The welcome emails' switches (enews.html Welcome emails; functions/welcome-mail.js).
      allow write: if enewsOffice() && id == 'welcomes'
                   && request.resource.data.keys().hasOnly(['subscriber', 'newcomer', 'updatedAt', 'updatedBy'])
                   && request.resource.data.get('subscriber', false) is bool && request.resource.data.get('newcomer', false) is bool
                   && request.resource.data.updatedBy == request.auth.uid;
      allow write: if enewsOffice() && id == 'main'
                   && request.resource.data.keys().hasOnly(['template', 'colours', 'church', 'bible', 'updatedAt', 'updatedBy'])
                   && request.resource.data.template in ['classic', 'green']
                   && request.resource.data.colours is map && request.resource.data.colours.size() <= 20
                   && request.resource.data.church is map
                   // the church's usual Bible version for the verse (source, id, abbrev), or null
                   && (request.resource.data.get('bible', null) == null || (request.resource.data.bible is map && request.resource.data.bible.keys().hasOnly(['source', 'id', 'abbrev'])))
                   && request.resource.data.church.keys().hasOnly(['shortName', 'address', 'charityNo', 'phone', 'hours', 'diaryButton', 'social'])
                   // the footer's social links: a short list of { kind, url }
                   && (request.resource.data.church.get('social', []) is list && request.resource.data.church.get('social', []).size() <= 12)
                   && request.resource.data.church.get('diaryButton', true) is bool
                   && request.resource.data.updatedBy == request.auth.uid;
    }

    // The practice copies of the tools write here rather than into the real
    // collections. Anyone learning the system may scribble on it.
    match /training_portal/{docId} {
      allow read, write: if volunteer();
    }

    // ---- places: sites, rooms, resources, venues --------------------
    // The physical half of the events and booking module. Nothing here is
    // personal data, so members read it all; admins are the only writers.
    //
    // WHY THE PUBLIC CAN READ SOME OF IT. whatson.html and book.html have to
    // draw a site and room list before anyone has signed in, so an active
    // site or room is public. Inactive ones are not: a room taken out of use
    // should stop appearing everywhere at once, including on the public form.
    //
    // HOW A PUBLIC LIST HAS TO BE WRITTEN. A rule that reads resource.data
    // can only pass a list query the engine can prove in advance, so a public
    // page must ask for .where('active','==',true). Asking for the whole
    // collection without a login is refused outright, not filtered down to
    // the active ones - see the two list tests either side of this.
    //
    // NAMES ARE NOT KEYS. Rooms are renamed whenever the church changes what
    // it calls them, so every reference elsewhere is by document id. Nothing
    // in these rules keys off a name, and nothing else should either.

    function activeRecord() {
      return resource.data.get('active', false) == true;
    }

    match /sites/{siteId} {
      allow read: if active() || activeRecord();
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if active() || activeRecord();
      allow write: if isAdmin();
    }

    // Projectors, the PA, chairs, the urn - things a booking reserves
    // alongside a room.
    //
    // NOT `resources`. That name is taken by the team document and link shelf
    // which resources.html reads, and reusing it would have put bookable
    // kit and charters in one collection under one set of rules. Renamed
    // here rather than there, because the shelf is live and this is not.
    match /bookableResources/{resourceId} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // Outside places - the pub that hosts the carols. Saved once and reused.
    // Members only for now: no public page needs one until events exist.
    match /venues/{venueId} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // Per-site settings: who approves bookings here, and who the
    // safeguarding lead and deputy are. Member ids, not names.
    //
    // Readable by any member on purpose - a member about to request a room
    // should be able to see who they are waiting on.
    match /bookingSettings/{siteId} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // ---- events and sign-ups (Chunk 2) ------------------------------
    //
    // THE SHAPE OF THE PROBLEM. Guests sign up with no account at all, so
    // these rules are the only thing standing between a form on the open
    // internet and the database. Three ideas carry the weight:
    //
    //   1. Public CREATE only, never list. Nothing public can enumerate a
    //      collection that holds a person's name and email.
    //   2. The manage link is the key. A sign-up's document id IS its
    //      unguessable key, so `get` by that id is the only way in, and
    //      `list` is shut to everyone but an admin.
    //   3. Capacity is counted in the database, not in the page. The write
    //      is a batch, and the rule uses getAfter() to require the new total
    //      to be the old total plus the places asked for, and never over
    //      capacity. Two people taking the last place at the same moment
    //      cannot both succeed.

    // A person who is not a member: a guest who signed up, a parent, a
    // hirer. Same shape as addressBook so an admin can promote one into it
    // later without reshaping anything.
    //
    // NOT a second people store: every sign-up points at either an
    // addressBook id or a contacts id, which is what lets a future CRM join
    // it up.
    function publicContact() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'phone', 'isMinor', 'householdId', 'source', 'createdAt'])
             && d.name is string && d.name.size() > 0 && d.name.size() <= 120
             && d.email is string && d.email.size() <= 200
             && d.get('phone', '') is string && d.get('phone', '').size() <= 40
             && d.get('source', '') in ['signup', 'booking', 'form']
             && d.get('isMinor', false) is bool
             // Nothing here grants anything. There is deliberately no
             // markers, adminFor or masterAdmin in the allowed keys.
             ;
    }

    match /contacts/{contactId} {
      allow get, list: if volunteer();
      allow create: if isAdmin() || publicContact();
      allow update, delete: if isAdmin();
    }

    // ---- the events themselves --------------------------------------
    //
    // WHO MAY SEE ONE. `audience` is the field the reader is judged on, and
    // it is the only one: a list query asks for the audiences that apply to
    // the person, so every document that comes back already passes. The
    // alternative - judging on visibility and status separately - cannot be
    // expressed as a query, and a public list would be refused outright.
    //
    // audience holds 'public', 'members', or team names. It is written by
    // one function in egbc-events.js so it cannot drift, and the rule below
    // checks it agrees with visibility and status on every write - a held
    // (pending) event is never public, whatever the page says.

    function eventAudience() {
      return resource.data.get('audience', []);
    }

    // ...and the safeguarding lead and deputy of the event's own site, so an
    // event shown only to its team can still be assessed, signed off and
    // printed (the reviewing window, 23 Oct). Last, so it costs the other
    // cases nothing.
    // A PERSON'S TEAMS, WITH THE ONES THEIR CORE TEAMS COVER (main's H-15): being
    // on a core team counts as being on each team it covers. covers is kept on
    // the users record by the server (functions/core-teams.js); no page writes
    // it. The cheaper form of main's myTeams(), for these busy reads.
    function teamsCovered() {
      return me().get('teams', []).concat(me().get('covers', []));
    }
    function canSeeEvent() {
      return eventAudience().hasAny(['public'])
             || (active() && (eventAudience().hasAny(['members'])
                              || eventAudience().hasAny(teamsCovered())
                              || isAdmin()))
             || onEventTeam(resource.data)
             || sgLeadOf(resource.data.get('location', {}).get('siteId', ''));
    }

    // ---- THE EVENT TEAM (F-212; Martin, 15 Oct: "if I run Film Club only
    // me, Natasha and Val should be able to edit things and download
    // lists") - events window. Each event names its own team, by address
    // book id (teamMemberIds) and, where they have one, account (teamUids).
    // Being on it needs no admin role. With master admins, the team edits
    // the event and its form, and is the only one who sees its sign-ups.
    function onEventTeam(ev) {
      return active()
             && (me().get('memberId', '') in ev.get('teamMemberIds', [])
                 || request.auth.uid in ev.get('teamUids', []));
    }
    function eventTeamOf(calEventId) {
      return calEventId is string && calEventId != ''
             && exists(/databases/$(database)/documents/calEvents/$(calEventId))
             && onEventTeam(get(/databases/$(database)/documents/calEvents/$(calEventId)).data);
    }
    // Master admins, the team, and (for events made before teams) the
    // admin who made it. Not "an admin of a team it belongs to" any more:
    // being an admin elsewhere gives nothing here (F-212).
    function runsThisEvent(ev) {
      return isMaster() || onEventTeam(ev)
             || (isAdmin() && ev.get('createdBy', '') == request.auth.uid);
    }
    function runsEventId(calEventId) {
      return isMaster()
             || (calEventId is string && calEventId != ''
                 && exists(/databases/$(database)/documents/calEvents/$(calEventId))
                 && runsThisEvent(get(/databases/$(database)/documents/calEvents/$(calEventId)).data));
    }

    function audienceAgrees() {
      let d = request.resource.data;
      let a = d.get('audience', []);
      let held = d.get('status', 'confirmed') == 'pending';
      let pub = d.get('visibility', 'members') == 'public';
      return held ? !a.hasAny(['public']) : (pub ? a.hasAny(['public']) : !a.hasAny(['public']));
    }

    // An event is edited by its team (F-212), a master admin, or (for an
    // event from before teams) the admin who made it.
    function canEditEvent() {
      return runsThisEvent(resource.data);
    }

    match /calEvents/{calEventId} {
      allow get, list: if canSeeEvent();
      // A Sunday service from the rota (calEvents/rota_<id>) is the server's
      // (rotaWhatsOn, F-218 from the main window): no page writes one.
      allow create: if isAdmin() && audienceAgrees() && !calEventId.matches('rota_.*')
                    && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update: if canEditEvent() && audienceAgrees() && !calEventId.matches('rota_.*');
      allow delete: if canEditEvent() && !calEventId.matches('rota_.*');

      // Ticket types and questions are part of the sign-up form, so a guest
      // has to be able to read them. They hold no personal data: a name, a
      // price, a capacity, a question.
      match /ticketTypes/{ticketTypeId} {
        allow read: if true;
        allow write: if runsEventId(calEventId);   // the event team (F-212)
      }
      match /questions/{questionId} {
        allow read: if true;
        allow write: if runsEventId(calEventId);   // the event team (F-212)
      }
    }

    // ---- capacity ----------------------------------------------------
    // One document per event holding `taken` and `capacity`. Read by
    // anyone, because the sign-up page shows how many places are left
    // before asking for a name.

    function capDoc(calEventId) {
      return getAfter(/databases/$(database)/documents/capacity/$(calEventId)).data;
    }

    function cancelledInThisBatch(calEventId) {
      let sid = request.resource.data.get('lastCancelled', '');
      return sid != ''
             && getAfter(/databases/$(database)/documents/signups/$(sid)).data.status == 'cancelled'
             && getAfter(/databases/$(database)/documents/signups/$(sid)).data.calEventId == calEventId
             && request.resource.data.taken ==
                resource.data.taken - getAfter(/databases/$(database)/documents/signups/$(sid)).data.places;
    }

    match /capacity/{calEventId} {
      allow read: if true;
      allow create: if isAdmin() || runsEventId(calEventId);
      // Going up is the sign-up's job and is checked on the sign-up itself.
      // Going down has to name the sign-up that was cancelled, and that
      // sign-up has to actually be cancelled in the same write.
      allow update: if isAdmin() || runsEventId(calEventId)
                    || (request.resource.data.capacity == resource.data.capacity
                        && request.resource.data.taken > resource.data.taken
                        && request.resource.data.taken <= resource.data.capacity)
                    || (request.resource.data.capacity == resource.data.capacity
                        && request.resource.data.taken < resource.data.taken
                        && request.resource.data.taken >= 0
                        && cancelledInThisBatch(calEventId));
      allow delete: if isAdmin();
    }

    // ---- sign-ups ----------------------------------------------------
    // The document id is the manage key: 32 random characters. `get` with
    // that id is how a guest opens their own booking, and `list` is shut to
    // everyone except an admin, so nothing can be enumerated.

    function signupShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['calEventId', 'personKind', 'personId', 'name', 'email', 'phone',
                               'attendees', 'answers', 'places', 'ticketTypeId', 'status',
                               'donation', 'createdAt', 'cancelledAt', 'notes', 'memberUid'])
             && d.calEventId is string && d.calEventId.size() > 0
             && d.name is string && d.name.size() > 0 && d.name.size() <= 120
             && d.email is string && d.email.size() <= 200
             && d.places is int && d.places > 0 && d.places <= 20
             && d.personKind in ['addressBook', 'contacts']
             && d.personId is string && d.personId.size() > 0
             && d.status in ['confirmed', 'waiting']
             && d.get('notes', '') is string && d.get('notes', '').size() <= 2000;
    }

    // A confirmed sign-up has to move the counter by exactly its own places
    // and must not take the event past its capacity. A waiting-list place
    // takes no seat, so it does not touch the counter at all.
    function takesItsPlaces() {
      let d = request.resource.data;
      return d.status == 'waiting'
             || (capDoc(d.calEventId).taken ==
                   get(/databases/$(database)/documents/capacity/$(d.calEventId)).data.taken + d.places
                 && capDoc(d.calEventId).taken <= capDoc(d.calEventId).capacity);
    }

    match /signups/{manageKey} {
      allow get: if true;
      // A member may ask for their own, and only their own: the query has to
      // name the person, so every document that comes back already belongs
      // to them. This is what lets "My events" exist on the hub without a
      // second collection, and it is the only widening of list here.
      // F-212: NOT every admin any more - the event's team and master
      // admins (and, in the events section, its leaders and the site's
      // safeguarding lead).
      allow list: if runsEventId(resource.data.calEventId)
                  || (active() && resource.data.get('memberUid', '') == request.auth.uid);
      // F-115, the events window's request. Without the last clause anybody
      // holding an event's id could sign up to it, signed in or not, including
      // an event marked Church members only - the shape and the places were
      // checked and the AUDIENCE was not. canSignUpTo() is theirs, in their
      // section, and judges the same audiences as reading one does.
      allow create: if signupShape() && takesItsPlaces()
                    && canSignUpTo(request.resource.data.calEventId);
      // The key-holder may cancel, and that is all they may do. An admin may
      // change anything.
      allow update: if runsEventId(resource.data.calEventId)
                    || (request.resource.data.status == 'cancelled'
                        && request.resource.data.calEventId == resource.data.calEventId
                        && request.resource.data.places == resource.data.places
                        && request.resource.data.email == resource.data.email);
      allow delete: if runsEventId(resource.data.calEventId);
    }

    // ---- the admin's side of an event --------------------------------
    // Checklists ("chairs out", "AV booked"), internal notes, the change
    // history and the log of what was emailed. None of it is for members.

    match /eventChecklists/{calEventId} {
      allow read: if volunteer() || runsEventId(calEventId);
      allow write: if isAdmin() || runsEventId(calEventId);
    }
    match /checklistTemplates/{templateId} {
      allow read: if volunteer();
      allow write: if isAdmin();
    }
    match /eventNotes/{calEventId} {
      allow read, write: if isAdmin() || runsEventId(calEventId);
    }
    // Append-only on purpose: a history that can be edited is not a history.
    match /eventChanges/{changeId} {
      allow read: if isAdmin() || runsEventId(resource.data.get('calEventId', ''));
      allow create: if isAdmin() || runsEventId(request.resource.data.get('calEventId', ''));
      allow update, delete: if false;
    }
    match /commsLog/{entryId} {
      allow read: if isAdmin() || runsEventId(resource.data.get('calEventId', ''));
      allow create: if isAdmin() || runsEventId(request.resource.data.get('calEventId', ''));
      allow update, delete: if false;
    }

    // ── EVENTS (events window) ──────────────────────────────────────
    // Everything between this line and "end EVENTS" belongs to the events
    // window (EVENTS-WINDOW-BRIEF.md). The main window does not edit it,
    // and nothing in it changes a rule outside it.

    // ---- WHO CAN COME (Martin, NEXT-BRIEF §21) ------------------------
    // Every event, form and small group says who it is for, in one list:
    // an event's `audience`, a form's or a group's `canCome` (a group's
    // `audience` is the words "who it is for"). The values:
    //   'public'        Everyone, signed in or not
    //   'members'       Attenders: anyone signed in from the address book
    //                   (and every volunteer)
    //   'churchMembers' Church members only (the office's tick)
    //   <team names>    those teams
    // A reader who cannot come is never shown it: lists ask only for the
    // audiences that apply to them, and the rules refuse the rest.
    function audienceOk(a) {
      return a.hasAny(['public'])
             || (active() && a.hasAny(['members']))
             || (isChurchMember() && a.hasAny(['churchMembers']))
             || (active() && a.hasAny(teamsCovered()))
             || isAdmin();
    }
    // Events: the main rule (outside this section) lets admins and the
    // other audiences read; this lets a Church member read a
    // Church-members-only event. Rules for one path add up, so it widens
    // nothing else.
    match /calEvents/{calEventId} {
      allow get, list: if isChurchMember() && resource.data.get('audience', []).hasAny(['churchMembers']);
    }
    // Who may sign up to an event: the same test. The sign-up rule is
    // outside this section; the main window adds
    //   && canSignUpTo(request.resource.data.calEventId)
    // to its create (request in FINDINGS-events.md, F-115).
    function canSignUpTo(calEventId) {
      return calEventId is string && calEventId != ''
             && exists(/databases/$(database)/documents/calEvents/$(calEventId))
             && audienceOk(get(/databases/$(database)/documents/calEvents/$(calEventId)).data.get('audience', []))
             && (signupsOpen(get(/databases/$(database)/documents/calEvents/$(calEventId)).data) || runsEventId(calEventId))
             // F-265 step 2: an under-18s trip, overnight, holiday club or off-site event takes no sign-up until it is signed off
             && (!sgNeedsSignoff(calEventId, get(/databases/$(database)/documents/calEvents/$(calEventId)).data) || sgSignedOff(calEventId));
    }
    // OPEN FOR SIGN-UPS (F-265, the gap found planning it): the page hid the
    // button for an event not taking sign-ups or cancelled, but the database
    // took a sign-up anyway while its capacity record existed. Now it must
    // be taking sign-ups and not cancelled - except for the event's own team
    // (a walk-in added at the door, checkin.html).
    function signupsOpen(ev) {
      return ev.get('signupOn', false) == true && ev.get('status', 'confirmed') != 'cancelled';
    }

    // ---- who leads an event (Chunk 3, stage 3) ------------------------
    // eventLeaders/{calEventId}.leaderUids names the people leading that
    // event. Being on that list is what lets a leader who is not an admin
    // check children in, see their forms and medical answers, and record
    // an incident - for that event only.
    function isEventLeader(calEventId) {
      return active() && calEventId is string && calEventId != ''
             && exists(/databases/$(database)/documents/eventLeaders/$(calEventId))
             && request.auth.uid in get(/databases/$(database)/documents/eventLeaders/$(calEventId)).data.get('leaderUids', []);
    }

    // ---- check-in and attendance (Chunk 3, stage 1) -----------------
    //
    // ONE DOCUMENT PER PERSON PER EVENT, and its id is worked out, never
    // random: <calEventId>__<signupKey>__<attendee number>. Two phones
    // scanning the same child at the same moment write to the same
    // document, and the update rule below refuses "in" on someone already
    // in - so the second phone is told, and nobody is counted twice.
    //
    // Admins only, for now. There is no "leader of this event" yet (that
    // is stage 3), and these hold names, times and who collected a child.

    function checkinShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['calEventId', 'signupKey', 'attendeeIndex', 'name', 'kind', 'state',
                               'inAt', 'inBy', 'inByName', 'outAt', 'outBy', 'outByName',
                               'collectedBy', 'collectorListed', 'overrideReason',
                               'roomId', 'day', 'updatedAt', 'buildingId',
                               'groupId', 'siteId', 'familyId', 'pickupCode', 'codeGiven', 'screenNo'])
             && d.calEventId is string && d.calEventId.size() > 0
             && d.signupKey is string && d.signupKey.size() > 0
             && d.attendeeIndex is int && d.attendeeIndex >= 0 && d.attendeeIndex < 20
             && d.name is string && d.name.size() > 0 && d.name.size() <= 120
             && d.kind in ['booked', 'walkin', 'leader', 'child']
             && d.state in ['in', 'out']
             && d.get('collectedBy', '') is string && d.get('collectedBy', '').size() <= 120
             && d.get('overrideReason', '') is string && d.get('overrideReason', '').size() <= 300;
    }

    function checkinIdAgrees(checkinId) {
      let d = request.resource.data;
      return checkinId == d.calEventId + '__' + d.signupKey + '__' + string(d.attendeeIndex);
    }

    // Check-out on an event that asks for it: a child goes to a named
    // person, and if that person is not on the booking's list, a reason
    // is written down. Leaders are never "collected".
    function checkoutSettings(calEventId) {
      return get(/databases/$(database)/documents/checkinSettings/$(calEventId)).data;
    }
    function collectionAllowed() {
      let d = request.resource.data;
      return d.kind == 'leader'
             || !exists(/databases/$(database)/documents/checkinSettings/$(d.calEventId))
             || checkoutSettings(d.calEventId).get('checkoutRequired', false) != true
             || (d.get('collectedBy', '').size() > 0
                 && (d.get('collectorListed', false) == true
                     || d.get('overrideReason', '').size() >= 3));
    }

    // SUNDAY GROUPS (Chunk 6, stage 2) use the same check-in: one session
    // per group per day, its calEventId "kids_<groupId>_<YYYY-MM-DD>", one
    // record per child (kind "child", signupKey = the child's id). Need to
    // know (F-087) holds here too: a child's check-in is seen and written
    // only by the children's leads and that group's own leaders - not by
    // other admins, who see event check-ins as before. A child goes home
    // only with a collector listed on their record, or with the collection
    // code printed for their parent at check-in. There is no way round it
    // on the page: a lead adds a collector to the child's record first.
    function kidsCkFields() {
      return ['groupId', 'siteId', 'familyId', 'pickupCode', 'codeGiven', 'screenNo'];
    }
    function eventCk(d) {
      return d.kind != 'child' && !d.calEventId.matches('kids_.*') && !d.keys().hasAny(kidsCkFields());
    }
    function kidsChild(childId) {
      return get(/databases/$(database)/documents/kidsChildren/$(childId)).data;
    }
    function kidsCkTeam(d) {
      return kidsLead(d.get('siteId', '')) || kidsGroupLeader(d.get('groupId', ''));
    }
    function kidsCk(d) {
      return d.kind == 'child'
             && d.groupId is string && d.siteId is string && d.familyId is string
             && d.day is string && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
             && d.calEventId == 'kids_' + d.groupId + '_' + d.day
             && d.attendeeIndex == 0
             && d.pickupCode is string && d.pickupCode.size() >= 4 && d.pickupCode.size() <= 8
             && d.get('codeGiven', '') is string && d.get('codeGiven', '').size() <= 8
             // The screen number (Martin, 14 Oct 2026): three digits, never
             // the collection code. All the service screen may ever show.
             && d.get('screenNo', '') is string
             && (d.get('screenNo', '') == '' || (d.get('screenNo', '').matches('[0-9]{3}') && d.get('screenNo', '') != d.pickupCode
                 // reserved for THIS family at this site today, so no two share one
                 && getAfter(/databases/$(database)/documents/kidsScreenNos/$(d.siteId + '_' + d.day + '_' + d.get('screenNo', ''))).data.familyId == d.familyId))
             && kidsCkTeam(d);
    }
    // Who may collect: someone listed on the child's record (as it is
    // now), or anyone who gives the code from the parent's slip.
    function kidsMayCollect(before, after) {
      return after.get('collectedBy', '').size() > 0
             && ((after.get('codeGiven', '') != '' && after.get('codeGiven', '') == before.pickupCode)
                 || (after.get('collectorListed', false) == true
                     && kidsChild(after.signupKey).get('collectors', []).hasAny([after.get('collectedBy', '')])));
    }

    match /checkins/{checkinId} {
      // Event check-ins: admins and the event's leaders. Sunday groups: the
      // children's leads and the group's leaders, nobody else. (Either half
      // can be proved from a list that asks by event, by day and kind, or
      // by group or site.)
      allow read: if ((runsEventId(resource.data.calEventId) || isEventLeader(resource.data.calEventId))
                      && (resource.data.kind in ['booked', 'walkin', 'leader'] || !resource.data.calEventId.matches('kids_.*')))
                  // The fire roll-call (F-214): the people named for it, for
                  // their building (or every building). By kind: never a
                  // child's check-in (kind 'child', which holds collection
                  // codes); adult leaders and booked people only.
                  || (resource.data.kind in ['booked', 'walkin', 'leader']
                      && fireWarden(resource.data.get('buildingId', '')))
                  || kidsLead(resource.data.get('siteId', ''))
                  || kidsGroupLeader(resource.data.get('groupId', ''));
      // A child arrives: their own record says this group, this site, and
      // they have not left.
      allow create: if checkinShape() && checkinIdAgrees(checkinId) && request.resource.data.state == 'in'
                    && kidsCk(request.resource.data)
                    && exists(/databases/$(database)/documents/kidsChildren/$(request.resource.data.signupKey))
                    && kidsChild(request.resource.data.signupKey).get('groupId', '') == request.resource.data.groupId
                    && kidsChild(request.resource.data.signupKey).get('siteId', '') == request.resource.data.siteId
                    && kidsChild(request.resource.data.signupKey).get('familyId', '') == request.resource.data.familyId
                    && kidsChild(request.resource.data.signupKey).get('status', 'registered') != 'left';
      // (Everything that says whose check-in it is cannot change, so the
      // team is checked once, on the record as it stands.)
      allow update: if resource.data.kind == 'child' && checkinShape()
                    && request.resource.data.get('codeGiven', '') is string && request.resource.data.get('codeGiven', '').size() <= 8
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['state', 'inAt', 'inBy', 'inByName', 'outAt', 'outBy', 'outByName',
                                   'collectedBy', 'collectorListed', 'codeGiven', 'overrideReason', 'updatedAt'])
                    && ((resource.data.state == 'in' && request.resource.data.state == 'out'
                         && request.resource.data.get('overrideReason', '') == ''
                         && kidsMayCollect(resource.data, request.resource.data))
                        || (resource.data.state == 'out' && request.resource.data.state == 'in'))
                    && kidsCkTeam(resource.data);
      // You arrive before you leave.
      allow create: if eventCk(request.resource.data)
                    && (runsEventId(request.resource.data.calEventId) || isEventLeader(request.resource.data.calEventId)) && checkinShape() && checkinIdAgrees(checkinId)
                    && request.resource.data.state == 'in';
      allow update: if eventCk(resource.data) && eventCk(request.resource.data)
                    && (runsEventId(resource.data.calEventId) || isEventLeader(resource.data.calEventId)) && checkinShape()
                    && request.resource.data.calEventId == resource.data.calEventId
                    && request.resource.data.signupKey == resource.data.signupKey
                    && request.resource.data.attendeeIndex == resource.data.attendeeIndex
                    && request.resource.data.kind == resource.data.kind
                    && ((resource.data.state == 'in' && request.resource.data.state == 'out'
                         && collectionAllowed())
                        || (resource.data.state == 'out' && request.resource.data.state == 'in'));
      // A register that can be quietly edited away is not a register.
      allow delete: if false;
    }

    // Per event: does check-out need a collector, which question holds the
    // collectors' names, which questions are shown as a flag at the door.
    match /checkinSettings/{calEventId} {
      allow read: if runsEventId(calEventId) || isEventLeader(calEventId);
      allow write: if runsEventId(calEventId)
                   && request.resource.data.keys().hasOnly(['checkoutRequired', 'collectorsQuestionId',
                                                             'flagQuestionIds', 'updatedAt', 'updatedBy'])
                   && request.resource.data.get('checkoutRequired', false) is bool
                   && request.resource.data.get('flagQuestionIds', []) is list;
    }

    // Every download that holds a flagged (medical, allergy) column, and
    // every register, is written here first. Append-only, and always in
    // the name of the person downloading.
    match /downloadsLog/{entryId} {
      allow read: if isAdmin();
      // Anyone allowed to download something sensitive - an admin, a
      // leader, a safeguarding lead - logs it in their own name.
      allow create: if active()
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.keys().hasOnly(['by', 'byName', 'at', 'calEventId', 'what',
                                                              'format', 'columns', 'sensitive'])
                    && request.resource.data.sensitive is bool;
      allow update, delete: if false;
    }

    // Quick headcounts ("Gatherings"): adults, children and online for a
    // Sunday service or an event. Numbers only, no names.
    match /headcounts/{countId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                    && request.resource.data.keys().hasOnly(['date', 'label', 'calEventId', 'adults',
                                                              'children', 'online', 'notes', 'by', 'byName', 'at'])
                    && request.resource.data.date is string && request.resource.data.date.size() == 10
                    && request.resource.data.label is string && request.resource.data.label.size() <= 120
                    && request.resource.data.adults is int && request.resource.data.adults >= 0
                    && request.resource.data.children is int && request.resource.data.children >= 0
                    && request.resource.data.online is int && request.resource.data.online >= 0;
      allow delete: if isAdmin();
    }

    // ---- forms and consent (Chunk 3, stage 2) -----------------------
    //
    // A parent fills a form in from a link, with no account, so - as with
    // sign-ups - the rules carry the weight:
    //
    //   forms              the form itself. Holds questions, not answers,
    //                      so anyone may read one; only admins write.
    //   eventForms         which forms an event asks for. Admins only.
    //   formRequests       one per person asked. The id IS the link key,
    //                      so `get` is open and `list` is admins only.
    //   formResponses      the ordinary answers. Written once, in the same
    //                      batch that marks the request done, and only for
    //                      the person, form, event and site that request
    //                      names. Admins and the site's safeguarding lead
    //                      may list them.
    //   sensitiveResponses the medical answers, split off by the page. Only
    //                      a master admin and the site's safeguarding lead
    //                      or deputy may list them - not ordinary admins.
    //                      The id is a second secret only the parent is
    //                      sent, which is how they see what is held about
    //                      them. Event leaders are added in stage 3.

    // The safeguarding lead or deputy of a site, set in Places
    // (bookingSettings). Member ids, compared with the reader's own.
    function sgLeadOf(siteId) {
      return active() && siteId is string && siteId != ''
             && me().get('memberId', '') != ''
             && exists(/databases/$(database)/documents/bookingSettings/$(siteId))
             && (get(/databases/$(database)/documents/bookingSettings/$(siteId)).data.get('safeguardingLead', '') == me().get('memberId', '')
                 || get(/databases/$(database)/documents/bookingSettings/$(siteId)).data.get('safeguardingDeputy', '') == me().get('memberId', ''));
    }

    // WHOSE FORMS (Martin, F-087): every form belongs to a team (forms.team).
    // A team's admins send, chase and read that team's forms only; master
    // admins and the safeguarding lead or deputy see all of them. A form with
    // no team is the master admins' and the safeguarding lead's. The medical
    // halves keep their own, narrower rule (sensitiveResponses, E3).
    function formTeam(formId) {
      return formId is string && formId != '' && exists(/databases/$(database)/documents/forms/$(formId))
             ? get(/databases/$(database)/documents/forms/$(formId)).data.get('team', '') : '';
    }
    function formTeamAdmin(formId) {
      return active() && formTeam(formId) != '' && formTeam(formId) in me().get('adminFor', []);
    }
    function formsOffice(formId, siteId) {
      return isMaster() || sgLeadOf(siteId) || formTeamAdmin(formId);
    }
    match /forms/{formId} {
      allow get: if true;
      allow list: if isMaster() || (active() && resource.data.get('team', '') != '' && resource.data.get('team', '') in me().get('adminFor', []));
      // The safeguarding lead sees every form but changes only its periods
      // (the rule further down, from E3).
      allow write: if (isMaster()
                       || (active() && request.resource.data.get('team', '') != '' && request.resource.data.get('team', '') in me().get('adminFor', [])
                           && (resource == null || resource.data.get('team', '') in me().get('adminFor', []))))
                   && request.resource.data.get('team', '') is string
                   && request.resource.data.title is string && request.resource.data.title.size() > 0
                   && request.resource.data.title.size() <= 140
                   && request.resource.data.fields is list
                   && request.resource.data.get('siteId', '') is string;
    }

    match /eventForms/{calEventId} {
      allow read, write: if isAdmin();
    }

    function requestAfter(key) {
      return getAfter(/databases/$(database)/documents/formRequests/$(key)).data;
    }

    match /formRequests/{key} {
      allow get: if true;
      allow list: if formsOffice(resource.data.formId, resource.data.siteId) || isEventLeader(resource.data.calEventId)
                  || kidsFormOf(resource.data.siteId, resource.data.formId);
      allow create: if formsOffice(request.resource.data.formId, request.resource.data.siteId);
      allow delete: if formsOffice(resource.data.formId, resource.data.siteId);
      // Chunk 6: the children's team sends the registration form - that
      // form, for their site, and no other - and may chase it.
      allow create: if kidsFormOf(request.resource.data.siteId, request.resource.data.formId)
                    && request.resource.data.get('calEventId', '') == ''
                    && request.resource.data.status == 'sent';
      allow update: if kidsFormOf(resource.data.siteId, resource.data.formId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reminders']);
      // The admin who sends it may change anything. The person with the
      // link may only mark it done: with a new answer written in the same
      // batch, or - for "still correct?" - by pointing at the answer it
      // already names.
      allow update: if (formsOffice(resource.data.formId, resource.data.siteId) && request.resource.data.formId == resource.data.formId)
                    || (resource.data.status in ['sent', 'reuse']
                        && request.resource.data.status == 'done'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'completedAt', 'responseId', 'confirmedStillCorrect'])
                        && ((request.resource.data.get('confirmedStillCorrect', false) == true
                             && resource.data.status == 'reuse'
                             && request.resource.data.responseId == resource.data.reuseOf)
                            || getAfter(/databases/$(database)/documents/formResponses/$(request.resource.data.responseId)).data.requestKey == key));
    }

    match /formResponses/{rid} {
      allow get: if true;
      allow list: if formsOffice(resource.data.formId, resource.data.siteId) || kidsFormOf(resource.data.siteId, resource.data.formId);
      allow create: if request.resource.data.keys().hasOnly(['formId', 'formVersion', 'requestKey', 'calEventId',
                                 'personKind', 'personId', 'email', 'name', 'subjects', 'siteId', 'answers',
                                 'hasSensitive', 'submittedAt', 'validUntil', 'deleteAfter'])
                    && request.resource.data.answers is map
                    && request.resource.data.validUntil is string && request.resource.data.validUntil.size() == 10
                    && request.resource.data.deleteAfter is string && request.resource.data.deleteAfter.size() == 10
                    && get(/databases/$(database)/documents/formRequests/$(request.resource.data.requestKey)).data.status in ['sent', 'reuse']
                    && requestAfter(request.resource.data.requestKey).responseId == rid
                    && requestAfter(request.resource.data.requestKey).status == 'done'
                    && request.resource.data.formId == requestAfter(request.resource.data.requestKey).formId
                    && request.resource.data.email == requestAfter(request.resource.data.requestKey).email
                    && request.resource.data.siteId == requestAfter(request.resource.data.requestKey).siteId
                    && request.resource.data.calEventId == requestAfter(request.resource.data.requestKey).calEventId
                    // Who can come (§21): a form for Attenders, Church members or a team is filled in signed in.
                    && audienceOk(get(/databases/$(database)/documents/forms/$(request.resource.data.formId)).data.get('canCome', ['public']));
      // An answer, once given, is the record of what was said. Deleting it
      // when its time is up is the retention list's job (stage 3).
      allow update: if false;
      allow delete: if isMaster();
    }

    match /sensitiveResponses/{secret} {
      allow get: if true;
      // Stage 3: the leaders of the event it was given for, too.
      allow list: if isMaster() || sgLeadOf(resource.data.siteId) || isEventLeader(resource.data.get('calEventId', ''))
                  || kidsFormOf(resource.data.siteId, resource.data.formId);
      // A copy for another event's leaders, when a family said "still
      // correct" for it. Only the safeguarding lead or a master admin can
      // read the original, so only they can make the copy.
      allow create: if (isMaster() || sgLeadOf(request.resource.data.siteId))
                    && request.resource.data.keys().hasOnly(['responseId', 'requestKey', 'formId', 'siteId', 'calEventId',
                                                              'answers', 'submittedAt', 'deleteAfter', 'sharedFrom', 'sharedBy', 'sharedAt'])
                    && request.resource.data.get('sharedFrom', '') != ''
                    && request.resource.data.calEventId is string && request.resource.data.calEventId != ''
                    && get(/databases/$(database)/documents/sensitiveResponses/$(request.resource.data.sharedFrom)).data.responseId == request.resource.data.responseId
                    && get(/databases/$(database)/documents/sensitiveResponses/$(request.resource.data.sharedFrom)).data.siteId == request.resource.data.siteId;
      allow create: if request.resource.data.keys().hasOnly(['responseId', 'requestKey', 'formId', 'siteId', 'calEventId',
                                                              'answers', 'submittedAt', 'deleteAfter'])
                    && request.resource.data.get('calEventId', '') == requestAfter(request.resource.data.requestKey).get('calEventId', '')
                    && request.resource.data.answers is map
                    // Only while the form is still open: once it is done,
                    // nothing more can be added to it.
                    && get(/databases/$(database)/documents/formRequests/$(request.resource.data.requestKey)).data.status in ['sent', 'reuse']
                    && requestAfter(request.resource.data.requestKey).responseId == request.resource.data.responseId
                    && getAfter(/databases/$(database)/documents/formResponses/$(request.resource.data.responseId)).data.requestKey
                         == request.resource.data.requestKey
                    && request.resource.data.siteId == requestAfter(request.resource.data.requestKey).siteId
                    && request.resource.data.formId == requestAfter(request.resource.data.requestKey).formId;
      allow update: if false;
      allow delete: if isMaster();
    }

    // ---- safeguarding (Chunk 3, stage 3) ----------------------------
    //
    // Who may see what is decided here, not in the pages:
    //   eventLeaders   who leads an event, its ratios and whether leaders
    //                  must have their checks. Members may read it (a
    //                  leader needs to know who else is on); admins and the
    //                  site's safeguarding lead set it.
    //   leaderChecks   a leader's DBS status, the date it was seen, and the
    //                  date of their training. Dates and status only: the
    //                  rule has no room for a certificate number.
    //   incidents      the incident and accident log. The site's
    //                  safeguarding lead, master admins and that event's
    //                  leaders only - not ordinary admins. Never deleted.
    //   concerns       a concern goes to the site's safeguarding lead and
    //                  deputy and NOBODY else: not master admins, not the
    //                  person who reported it. Never deleted.
    //   retentionLog   what was deleted from the "due for deletion" list,
    //                  by whom and when.

    match /eventLeaders/{calEventId} {
      allow read: if volunteer();
      allow write: if (isAdmin() || sgLeadOf(request.resource.data.get('siteId', '')))
                   && request.resource.data.keys().hasOnly(['leaders', 'leaderUids', 'siteId', 'ratioAll', 'ratioUnder8',
                                                             'requireChecks', 'dbsYears', 'trainingYears', 'updatedAt', 'updatedBy',
                                                             'under18', 'leaderIds', 'clearedIds', 'lastCleared', 'leaderInfo'])
                   && request.resource.data.leaderUids is list
                   && leadersShapeOk(request.resource.data)
                   && request.resource.data.get('siteId', '')
                        == get(/databases/$(database)/documents/calEvents/$(calEventId)).data.get('location', {}).get('siteId', '')
                   && under18EventOk(calEventId);
    }

    // ---- "WORKS WITH UNDER-18s" ON AN EVENT OR CLUB (NEXT-BRIEF §24; F-142)
    // Martin: everyone working with under-18s needs an in-date DBS check
    // and training - Kids Film Club, Puppet practice, youth events, anything
    // a leader ticks. The SAME checks records (leaderChecks, against the
    // years in Safeguarding settings) and the SAME exception route as the
    // under-18s small groups (F-109): a master admin or the site's
    // safeguarding lead records an exception with a reason
    // (eventExceptions/<event>__<member>).
    //
    // HOW, WITH ANY NUMBER OF PEOPLE (F-146, after review). The rules can
    // look up only a few records in one save, so they cannot check twenty
    // people at once. So the clearing is done IN TURN and recorded:
    //   leaderIds    every leader's and helper's member id, in the same
    //                order as leaders (500 at most; leader i IS leaderIds[i])
    //   clearedIds   those checked and found cleared since the box was
    //                ticked
    //   lastCleared  the (at most two) people this save clears; each must
    //                be cleared NOW (checks in date, or an exception)
    // Ticking is always accepted; the page then clears everyone two at a
    // time, and names anyone it cannot, with the way forward (an exception,
    // or removing them). Nobody new may be NAMED on a ticked event unless
    // they are cleared in the same save. Unticking empties clearedIds, so
    // ticking again checks everyone afresh.
    function eventCleared(calEventId, memberId) {
      return memberId is string && memberId != ''
             && (checksInDate(memberId) || exists(/databases/$(database)/documents/eventExceptions/$(calEventId + '__' + memberId)));
    }
    // WHO EACH LEADER IS (S3; the spoofed-name fix, Martin 26 Oct). leaderIds
    // gives each leader's member id, in the same order as leaders ('' for
    // someone not in the address book); leaderInfo keeps each named leader's
    // name, role and sign-in by member id, and the pages show a member's name
    // from leaderInfo, never from leaders - so a name can't sit beside
    // someone else's checks. The rules: the same length, nobody twice, and
    // leaderInfo exactly the named ones. No limit but 500 (H-9). leaders is
    // kept as before, so the rules live today still accept these saves.
    function leadersShapeOk(d) {
      let ids = d.get('leaderIds', []);
      let info = d.get('leaderInfo', {});
      let named = ids.removeAll(['']);
      return ids is list && d.get('leaders', []) is list && ids.size() == d.get('leaders', []).size() && ids.size() <= 500
             && named.toSet().size() == named.size()
             && info is map && info.keys().hasOnly(named) && info.size() == named.size();
    }
    function under18EventOk(calEventId) {
      let d = request.resource.data;
      let wasOn = resource != null && resource.data.get('under18', false) == true;
      let ids = d.get('leaderIds', []);
      let after = d.get('clearedIds', []);
      let last = d.get('lastCleared', []);
      let before = wasOn ? resource.data.get('clearedIds', []) : [];
      let namedBefore = wasOn ? resource.data.get('leaderIds', []) : ids;
      return d.get('under18', false) != true
             ? (after is list && after.size() == 0)
             : (after is list && last is list && last.size() <= 2
                // only people named can be cleared
                && after.toSet().difference(ids.toSet()).size() == 0
                // anything newly cleared is in lastCleared...
                && after.toSet().difference(before.toSet()).difference(last.toSet()).size() == 0
                // ...and everyone in lastCleared is cleared now
                && (last.size() < 1 || eventCleared(calEventId, last[0]))
                && (last.size() < 2 || eventCleared(calEventId, last[1]))
                // nobody newly named on a ticked event unless cleared
                && ids.toSet().difference(namedBefore.toSet()).difference(after.toSet()).size() == 0);
    }
    match /eventExceptions/{key} {
      allow read: if isMaster() || sgLeadOf(resource.data.get('siteId', '')) || isAdmin()
                  || (active() && resource.data.memberId == me().get('memberId', '-'));
      allow create, update: if (isMaster() || sgLeadOf(request.resource.data.get('siteId', '')))
                   && request.resource.data.keys().hasOnly(['calEventId', 'memberId', 'name', 'reason', 'siteId', 'by', 'byName', 'at'])
                   && key == request.resource.data.calEventId + '__' + request.resource.data.memberId
                   && request.resource.data.reason is string && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 1000
                   && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if isMaster() || sgLeadOf(resource.data.get('siteId', ''));
    }

    // Leaders may list the sign-ups of the event they lead, for check-in,
    // and the site's safeguarding lead those of the site's events, for the
    // ratios. Rules for one path add up, so this widens the Chunk 2 rule
    // without editing it.
    function sgLeadOfEvent(calEventId) {
      return sgLeadOf(get(/databases/$(database)/documents/calEvents/$(calEventId)).data.get('location', {}).get('siteId', ''));
    }
    match /signups/{manageKey} {
      allow list: if isEventLeader(resource.data.calEventId) || sgLeadOfEvent(resource.data.calEventId);
    }

    match /leaderChecks/{memberId} {
      // DBS dates are the safeguarding lead and deputy's (Martin's rule), not
      // every team admin's: a Kids Church admin was reading everyone's
      // (the reviewing window, 22 Oct 2026). A master admin keeps it - they
      // can already write them, and somebody must name the first lead.
      allow read: if isMaster() || sgLeadOf(resource.data.get('siteId', ''))
                  || (active() && me().get('memberId', '') == memberId);
      allow write: if (isMaster() || sgLeadOf(request.resource.data.get('siteId', '')))
                   && request.resource.data.keys().hasOnly(['name', 'dbsStatus', 'dbsSeen', 'trainingDate', 'siteId', 'updatedAt', 'updatedBy',
                                                             'dbsLevel', 'referenceDate', 'declarationDate'])
                   // S3 (F-280 (a), 10.3): the DBS level, a church leader's reference, the confidential declaration
                   && request.resource.data.get('dbsLevel', '') in ['', 'enhancedBarred', 'enhanced', 'standard', 'basic']
                   && sgDay(request.resource.data.get('referenceDate', '')) && sgDay(request.resource.data.get('declarationDate', ''))
                   && request.resource.data.dbsStatus in ['current', 'applied', 'none']
                   && request.resource.data.get('dbsSeen', '') is string && request.resource.data.get('dbsSeen', '').size() <= 10
                   && request.resource.data.get('trainingDate', '') is string && request.resource.data.get('trainingDate', '').size() <= 10;
    }

    // ---- THE SAFEGUARDING RISK REGISTER (F-265, step 1: standing risks) ----
    // Risks, controls, owners and dates - never a child, a concern, an
    // incident's people or a medical detail: no field holds one (hasOnly,
    // length caps). Kept by the site's safeguarding lead and deputy; read by
    // them, the trustees (the team named in safeguarding settings, "Elders"
    // unless set) and master admins. Nobody else, activity leaders included.
    function sgTrusteeTeam() {
      return exists(/databases/$(database)/documents/safeguardingSettings/defaults)
             ? get(/databases/$(database)/documents/safeguardingSettings/defaults).data.get('trusteeTeam', 'Elders') : 'Elders';
    }
    // THE TRUSTEES ARE A JOB (H-9): the teams churchSettings/teamJobs gives
    // "trustees"; nothing stored, the team named in safeguarding settings;
    // nothing there, EGBC's Elders. The same answer as EGBCTeamJobs.teamsFor.
    function trusteeTeams() { return raJobTeams('trustees', [sgTrusteeTeam()]); }
    function onTrustees() { return active() && myTeams().hasAny(trusteeTeams()); }
    function sgRegSees(siteId) {
      return isMaster() || sgLeadOf(siteId) || onTrustees();
    }
    function sgDay(v) { return v is string && (v == '' || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function sgText(v, n) { return v is string && v.size() <= n; }
    function sgOneToFive(v) { return v is int && v >= 1 && v <= 5; }
    // AN ACTIVITY'S OWN LEADERS read its risks, never change them (job 2,
    // item 6; F-265 section 9): the leaders (member ids) of the Sunday group,
    // planner group or small group the activity is linked to. Read as the
    // page asks: activities by their link, risks by their activity.
    function sgLinkLeader(t, gid) {
      return active() && t in ['kidsGroup', 'smallGroup', 'planGroup'] && gid is string && gid != ''
             && me().get('memberId', '-') in get(/databases/$(database)/documents/$(t + 's')/$(gid)).data.get('leaderIds', []);
    }
    function sgActLeader(aid) {
      let l = get(/databases/$(database)/documents/sgActivities/$(aid)).data.get('link', {});
      return sgLinkLeader(l.get('type', ''), l.get('id', ''));
    }
    match /sgActivities/{id} {
      allow read: if sgRegSees(resource.data.get('siteId', ''))
                  || sgLinkLeader(resource.data.link.type, resource.data.link.id);
      allow create, update: if sgLeadOf(request.resource.data.get('siteId', ''))
                    && (resource == null || resource.data.siteId == request.resource.data.siteId)
                    && request.resource.data.keys().hasOnly(['siteId', 'kind', 'name', 'link', 'active', 'updatedAt', 'updatedBy'])
                    && request.resource.data.kind in ['sunday', 'youth', 'club', 'online', 'pastoral', 'transport', 'lone', 'hirers', 'other']
                    && sgText(request.resource.data.name, 80) && request.resource.data.name.size() > 0
                    && request.resource.data.get('link', {}) is map && request.resource.data.get('link', {}).keys().hasOnly(['type', 'id'])
                    && request.resource.data.active is bool && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /sgRisks/{id} {
      allow read: if sgRegSees(resource.data.get('siteId', ''))
                  || sgActLeader(resource.data.activityId);
      allow create, update: if sgLeadOf(request.resource.data.get('siteId', ''))
                    && (resource == null || resource.data.siteId == request.resource.data.siteId)
                    && exists(/databases/$(database)/documents/sgActivities/$(request.resource.data.get('activityId', '-')))
                    && get(/databases/$(database)/documents/sgActivities/$(request.resource.data.activityId)).data.siteId == request.resource.data.siteId
                    && request.resource.data.keys().hasOnly(['siteId', 'activityId', 'risk', 'who', 'l', 'i', 'controls', 'ownerName', 'reviewDue', 'rl', 'ri',
                                                             'status', 'source', 'starterId', 'createdAt', 'updatedAt', 'updatedBy', 'todo', 'sizeAtReview'])
                    // S5: the group's size when the risk was last reviewed (a count), to prompt another look if it changes a lot
                    && (request.resource.data.get('sizeAtReview', 0) is int && request.resource.data.get('sizeAtReview', 0) >= 0)
                    // STILL TO DO (Derby's steps 4 and 5; S4): up to 50 (what a record holds; T.MAX_TODO), each what, who and by when
                    && request.resource.data.get('todo', []) is list && request.resource.data.get('todo', []).size() <= 50
                    && sgText(request.resource.data.risk, 200) && request.resource.data.risk.size() > 0 && sgText(request.resource.data.get('who', ''), 120)
                    && sgOneToFive(request.resource.data.l) && sgOneToFive(request.resource.data.i)
                    && sgOneToFive(request.resource.data.rl) && sgOneToFive(request.resource.data.ri)
                    // the controls: at most 20 (each one's length is the page's; the rules cannot look inside a list)
                    && request.resource.data.controls is list && request.resource.data.controls.size() <= 50
                    && sgText(request.resource.data.get('ownerName', ''), 80) && sgDay(request.resource.data.get('reviewDue', ''))
                    && request.resource.data.status in ['open', 'closed'] && request.resource.data.get('source', 'added') in ['starter', 'added']
                    && sgText(request.resource.data.get('starterId', ''), 40) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // ---- STEP 2: EVENT ASSESSMENTS AND SIGN-OFF (F-265) ----
    // An under-18s event that is a trip, an overnight, a holiday club,
    // off-site or a camp or festival (calEvents.sgKind, set on events-admin) needs its site's
    // safeguarding lead or deputy to sign its assessment off before bookings
    // open. Only the lead, deputy or a master admin may say it isn't needed
    // ("waived"), and that says who, when and why.
    function sgEventSite(calEventId) {
      return get(/databases/$(database)/documents/calEvents/$(calEventId)).data.get('location', {}).get('siteId', '');
    }
    function sgNeedsSignoff(calEventId, ev) {
      return ev.get('sgKind', '') in ['trip', 'overnight', 'holidayclub', 'offsite', 'camp']
             && exists(/databases/$(database)/documents/eventLeaders/$(calEventId))
             && get(/databases/$(database)/documents/eventLeaders/$(calEventId)).data.get('under18', false) == true;
    }
    function sgSignedOff(calEventId) {
      return exists(/databases/$(database)/documents/sgAssessments/$(calEventId))
             && (get(/databases/$(database)/documents/sgAssessments/$(calEventId)).data.get('status', '') == 'signed'
                 || get(/databases/$(database)/documents/sgAssessments/$(calEventId)).data.get('waived', false) == true);
    }
    // THE REQUIRED CHECKLIST (Martin, 23 Oct): every question answered, or
    // "N/A: <reason>", before sign-off. The same ids as egbc-sg-templates.js
    // CHECKLIST (the unit test checks): the core, the event's kind, the
    // ticked flags (overseas; water, heights or adventurous), and the
    // church's own (safeguardingSettings/defaults.register.checklistIds).
    function sgChecklist(kind, flags) {
      return ['insurance', 'incharge', 'leaders', 'mixedLeaders', 'consent', 'paedFirstAid', 'medical', 'emergency', 'contacts', 'headcount', 'transport', 'venue', 'behaviour', 'accessibility', 'visitors', 'photos', 'weather', 'incidents']
        .concat(kind == 'overnight' ? ['sleeping', 'nightRota', 'fire', 'privacy']
              : kind == 'holidayclub' ? ['registration', 'staffRota', 'food', 'toilets']
              : kind == 'offsite' ? ['siteRules', 'water', 'boundaries']
              // a camp or festival (F-280 10.1), with the overnight questions too
              : kind == 'camp' ? ['tents', 'tentFire', 'cooking', 'campFood', 'tentCheck', 'medicalOfficer', 'adultForms', 'campRules', 'vehicles', 'leavingSite', 'setUp', 'sleeping', 'nightRota', 'fire', 'privacy'] : [])
        .concat(flags.get('abroad', false) == true ? ['travelAdvice', 'passports', 'travelInsurance', 'health', 'localEmergency', 'money', 'localHelpers'] : [])
        .concat(flags.get('adventurous', false) == true ? ['instructor', 'lifeguard', 'equipment'] : [])
        .concat(exists(/databases/$(database)/documents/safeguardingSettings/defaults)
                ? get(/databases/$(database)/documents/safeguardingSettings/defaults).data.get('register', {}).get('checklistIds', []) : []);
    }
    // and the host's own requirements (F-277), once the leader has checked
    // them (hostIds); while a host's list is waiting to be checked, no sign-off
    function sgChecklistDone(kind, d) {
      let a = d.get('answers', {});
      return d.get('host', {}).get('confirmed', true) == true
             && a.keys().hasAll(sgChecklist(kind, d.get('flags', {})).concat(d.get('hostIds', [])))
             && !a.values().hasAny(['', 'N/A:', 'N/A: ', 'Yes:', 'Yes: ', 'No:', 'No: ']);
    }
    // the assessment's writers: the site's lead or deputy, the event's team and its named leaders
    function sgAssessWrites(calEventId, siteId) {
      // the cheapest first: a named leader is one read; the organiser and the lead cost more (H-8 headroom)
      return isEventLeader(calEventId) || runsEventId(calEventId) || sgLeadOf(siteId);
    }
    // THE ASSESSMENT'S WRITE, as one function (main's church-ruleset run, 26 Oct:
    // a named leader's draft went over Firestore's 1,000-expression limit in
    // the church ruleset). The new data and the old are read once and passed
    // in, and the cheapest writer is tried first (sgAssessWrites).
    // screenshots/events/sg-headroom.test.mjs measures the room left.
    // ev: the event, read once; lead: whether the writer is the site's safeguarding lead or deputy, worked out once
    function sgAssessOk(calEventId, d, before, ev, lead) {
      return d.siteId == ev.get('location', {}).get('siteId', '')
                    // the writers, the cheapest first: the lead (already known), a named leader (one read), the event's team
                    && (lead || isEventLeader(calEventId) || runsThisEvent(ev))
                    && d.keys().hasOnly(['siteId', 'calEventId', 'title', 'templateId', 'answers', 'risks', 'status', 'version',
                                                             'signedBy', 'signedByName', 'signedAt', 'signedVersion', 'signedNote',
                                                             'waived', 'waivedBy', 'waivedByName', 'waivedAt', 'waivedWhy', 'source', 'updatedAt', 'updatedBy',
                                                             'flags', 'signedByRole', 'host', 'hostIds'])
                    && d.calEventId == calEventId
                    && sgText(d.get('title', ''), 120) && sgText(d.get('templateId', ''), 40)
                    && d.get('answers', {}) is map && d.get('answers', {}).size() <= 1100
                    && d.get('flags', {}) is map && d.get('flags', {}).keys().hasOnly(['abroad', 'adventurous', 'under8'])
                    && sgText(d.get('signedByRole', ''), 60)
                    && d.get('host', {}) is map && d.get('hostIds', []) is list && d.get('hostIds', []).size() <= 500
                    && d.get('risks', []) is list && d.get('risks', []).size() <= 200
                    && d.status in ['draft', 'waiting', 'signed']
                    && d.version is int && d.version >= 1
                    && sgText(d.get('signedNote', ''), 300)
                    && d.updatedBy == request.auth.uid
                    // SIGNED: only the site's lead or deputy, as themselves, now, for this version
                    && (d.status != 'signed'
                        || (before != null && before.status == 'signed'
                            && d.diff(before).affectedKeys().hasOnly(['updatedAt', 'updatedBy']))
                        || (lead && d.signedBy == request.auth.uid
                            && d.signedAt == request.time && d.signedVersion == d.version
                            // and never while a required question is blank (Martin, 23 Oct)
                            && sgChecklistDone(ev.get('sgKind', ''), d)))
                    // WAIVED ("not needed"): only the lead, deputy or a master admin, saying who, when and why
                    && ((d.get('waived', false) == (before == null ? false : before.get('waived', false))
                         && d.get('waivedAt', null) == (before == null ? null : before.get('waivedAt', null))
                         && d.get('waivedBy', '') == (before == null ? '' : before.get('waivedBy', ''))
                         && d.get('waivedWhy', '') == (before == null ? '' : before.get('waivedWhy', '')))
                        || ((lead || isMaster())
                            && d.get('waivedBy', '') == request.auth.uid && d.get('waivedAt', null) == request.time
                            && sgText(d.get('waivedWhy', ''), 300) && d.get('waivedWhy', '').size() > 0));
    }
    // HAS EACH LEADER READ THE HOST'S SAFEGUARDING POLICY (S3, F-280 10.3):
    // its own record for the event, so the assessment's own write (and its
    // headroom, F-285) is untouched. reads: { memberId: 'YYYY-MM-DD' }. Read
    // and written by those who write the assessment.
    // TRUSTEES NOTED (S4, F-280 10.4; Martin's answer 18): after the lead or
    // deputy signs an assessment off, a trustee records that the trustees
    // have noted it - for that signed version only. Its own record, so the
    // assessment's own write (and its headroom, F-285) is untouched. It never
    // stops the event.
    match /sgNoted/{calEventId} {
      allow read: if resource == null ? active() : (sgRegSees(resource.data.get('siteId', '')) || runsEventId(calEventId) || isEventLeader(calEventId));
      allow create, update: if (isMaster() || onTrustees())
                    && request.resource.data.keys().hasOnly(['siteId', 'version', 'by', 'byName', 'at'])
                    && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
                    && sgText(request.resource.data.get('byName', ''), 80)
                    && exists(/databases/$(database)/documents/sgAssessments/$(calEventId))
                    && get(/databases/$(database)/documents/sgAssessments/$(calEventId)).data.get('status', '') == 'signed'
                    && request.resource.data.version == get(/databases/$(database)/documents/sgAssessments/$(calEventId)).data.get('signedVersion', -1)
                    && request.resource.data.siteId == get(/databases/$(database)/documents/sgAssessments/$(calEventId)).data.siteId;
      allow delete: if false;
    }
    match /sgPolicyReads/{calEventId} {
      allow read: if resource == null ? active() : (sgRegSees(resource.data.get('siteId', '')) || runsEventId(calEventId) || isEventLeader(calEventId));
      allow create, update: if exists(/databases/$(database)/documents/calEvents/$(calEventId))
                    && request.resource.data.keys().hasOnly(['siteId', 'reads', 'updatedAt', 'updatedBy'])
                    && request.resource.data.siteId == sgEventSite(calEventId)
                    && sgAssessWrites(calEventId, request.resource.data.siteId)
                    && request.resource.data.reads is map && request.resource.data.reads.size() <= 500
                    && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /sgAssessments/{calEventId} {
      // one not written yet: nothing to see, so anyone signed in may find that out
      allow read: if resource == null ? active() : (sgRegSees(resource.data.get('siteId', '')) || runsEventId(calEventId) || isEventLeader(calEventId));
      allow create, update: if exists(/databases/$(database)/documents/calEvents/$(calEventId))
                    && sgAssessOk(calEventId, request.resource.data, resource == null ? null : resource.data,
                                  get(/databases/$(database)/documents/calEvents/$(calEventId)).data, sgLeadOf(request.resource.data.get('siteId', '')));
      allow delete: if false;
    }
    // ---- STEP 3: LIVE WARNINGS (F-265) ----
    // Counts, dates and links only, written by the server every 15 minutes
    // (functions/sg-warnings.js) - read by those who read the register.
    // sgMailed (the two-adults emails already sent) has no rule: server only.
    match /sgWarnings/{siteId} {
      allow read: if sgRegSees(siteId);
      allow write: if false;
    }
    // ---- STEP 4: THE DIALS, THE ANNUAL REVIEW AND SNAPSHOTS (F-265) ----
    // The dials: counts only, written by the server with the warnings.
    match /sgDashboard/{siteId} {
      allow read: if sgRegSees(siteId);
      allow write: if false;
    }
    function sgTrustee() { return onTrustees(); }
    function sgLeadSite() {
      return exists(/databases/$(database)/documents/safeguardingSettings/defaults)
             ? get(/databases/$(database)/documents/safeguardingSettings/defaults).data.get('leadSiteId', '') : '';
    }
    // The church-wide annual review (Martin, 22 Oct): one record per item per
    // year, sgReviews/<year>_<item>, saying who and when - never changed or
    // removed. Any site's lead or deputy records the lead's items (naming
    // their site); the trustees record theirs; either the annual return.
    // Only the two optional items may be marked "does not apply".
    match /sgReviews/{id} {
      // one not recorded yet: nothing to see
      allow read: if resource == null ? active()
                    : (isMaster() || sgTrustee() || sgLeadOf(sgLeadSite()) || sgLeadOf(resource.data.get('siteId', '')));
      allow create: if active()
                    && request.resource.data.keys().hasOnly(['year', 'itemId', 'siteId', 'at', 'by', 'byName', 'note', 'na'])
                    && request.resource.data.year is int && request.resource.data.year == request.time.year()
                    && request.resource.data.itemId is string
                    && id == string(request.resource.data.year) + '_' + request.resource.data.itemId
                    && request.resource.data.at == request.time && request.resource.data.by == request.auth.uid
                    && sgText(request.resource.data.get('byName', ''), 120) && sgText(request.resource.data.get('note', ''), 300)
                    && request.resource.data.get('na', false) is bool
                    && (request.resource.data.get('na', false) == false || request.resource.data.itemId in ['hirers', 'return'])
                    && request.resource.data.get('siteId', '') is string
                    && ((request.resource.data.itemId in ['leads', 'register', 'policy', 'recruitment', 'hirers', 'return'] && sgLeadOf(request.resource.data.get('siteId', '')))
                        || (request.resource.data.itemId in ['adopted', 'trusteeTraining', 'return'] && sgTrustee()));
      allow update, delete: if false;
    }
    // ---- STEP 5: AI-DRAFTED ASSESSMENTS (F-265 part A) ----
    // The log of each draft asked for: who, when, how long, the outcome and
    // the tokens - never the words. Read by master admins and the site's
    // lead and deputy; written by the server only. sgAiUse (today's counts)
    // and sgAiStub (the emulator's stand-in) have no rule: server only.
    match /sgAiLog/{id} {
      allow read: if isMaster() || sgLeadOf(resource.data.get('siteId', ''));
      allow write: if false;
    }
    // The trustees' dated snapshots: taken by the trustees and master admins,
    // read by those who read the register, never changed. The banner says
    // what it is, so it is never mistaken for an outside body's assessment.
    match /sgSnapshots/{id} {
      allow read: if sgRegSees(resource.data.get('siteId', ''));
      allow create: if (isMaster() || sgTrustee())
                    && request.resource.data.keys().hasOnly(['siteId', 'banner', 'by', 'byName', 'at', 'note', 'risks', 'warnings', 'dials', 'review'])
                    && request.resource.data.siteId is string && request.resource.data.siteId != ''
                    && request.resource.data.banner is string && request.resource.data.banner.size() <= 200
                    && request.resource.data.banner.matches('^Safeguarding risk register: .+')
                    && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
                    && sgText(request.resource.data.get('byName', ''), 120) && sgText(request.resource.data.get('note', ''), 300)
                    && request.resource.data.risks is list && request.resource.data.risks.size() <= 500
                    && request.resource.data.warnings is map && request.resource.data.dials is map && request.resource.data.review is map;
      allow update, delete: if false;
    }

    // What the public sign-up page may know: only "waiting for sign-off" or
    // "open" - never the assessment. "Open" must match a signed or waived
    // assessment saved with it.
    match /sgGate/{calEventId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['needed', 'open', 'updatedAt'])
                    && request.resource.data.needed is bool && request.resource.data.open is bool
                    && exists(/databases/$(database)/documents/calEvents/$(calEventId))
                    && sgAssessWrites(calEventId, sgEventSite(calEventId))
                    && (request.resource.data.open == false
                        || (existsAfter(/databases/$(database)/documents/sgAssessments/$(calEventId))
                            && (getAfter(/databases/$(database)/documents/sgAssessments/$(calEventId)).data.get('status', '') == 'signed'
                                || getAfter(/databases/$(database)/documents/sgAssessments/$(calEventId)).data.get('waived', false) == true)));
      allow delete: if false;
    }

    function incidentShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['calEventId', 'siteId', 'happenedAt', 'people', 'what', 'firstAid', 'firstAidBy',
                               'parentInformed', 'informedBy', 'informedAt', 'followUp', 'reportedBy', 'reportedByName', 'createdAt', 'activityId'])
             && d.calEventId is string && d.calEventId != ''
             && d.what is string && d.what.size() > 0 && d.what.size() <= 4000
             && d.siteId == get(/databases/$(database)/documents/calEvents/$(d.calEventId)).data.get('location', {}).get('siteId', '');
    }

    match /incidents/{incidentId} {
      allow read: if isMaster() || sgLeadOf(resource.data.siteId) || isEventLeader(resource.data.calEventId);
      allow create: if (isMaster() || sgLeadOf(request.resource.data.siteId) || isEventLeader(request.resource.data.calEventId))
                    && incidentShape() && request.resource.data.reportedBy == request.auth.uid;
      // The lead adds the follow-up; what was reported stays as it was.
      allow update: if (isMaster() || sgLeadOf(resource.data.siteId)) && incidentShape()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followUp', 'activityId'])
                    // S5: the lead links it to one of the register's activities on this site, so that activity's risks are looked at again
                    && (request.resource.data.get('activityId', '') == ''
                        || (exists(/databases/$(database)/documents/sgActivities/$(request.resource.data.activityId))
                            && get(/databases/$(database)/documents/sgActivities/$(request.resource.data.activityId)).data.siteId == resource.data.siteId));
      allow delete: if false;
    }

    match /concerns/{concernId} {
      allow read: if sgLeadOf(resource.data.siteId);
      allow create: if volunteer()
                    && request.resource.data.keys().hasOnly(['siteId', 'calEventId', 'about', 'concern', 'reportedBy',
                                                              'reportedByName', 'createdAt', 'status'])
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.status == 'new'
                    && request.resource.data.concern is string && request.resource.data.concern.size() > 0
                    && request.resource.data.concern.size() <= 6000
                    // Never into a site with nobody to read it.
                    && exists(/databases/$(database)/documents/bookingSettings/$(request.resource.data.siteId))
                    && get(/databases/$(database)/documents/bookingSettings/$(request.resource.data.siteId)).data.get('safeguardingLead', '') != '';
      allow update: if sgLeadOf(resource.data.siteId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'leadNotes', 'seenAt']);
      allow delete: if false;
    }

    // ---- safeguarding settings (Chunk 3, after E3) -------------------
    // One document, safeguardingSettings/defaults: how long each form
    // template's answers last and are kept, the default ratios, and how
    // many years DBS and training count. New forms and events take these.
    // Admins and any site's safeguarding lead change it; a lead who is not
    // an admin says which site they lead (leadSiteId) and the rule checks it.
    function wholeYears(v) { return v is int && v >= 1 && v <= 10; }
    match /safeguardingSettings/{id} {
      allow read: if volunteer();
      allow write: if id == 'defaults'
                   && (isAdmin() || sgLeadOf(request.resource.data.get('leadSiteId', '')))
                   /* leadName and leadPhone (NEXT-BRIEF §24): the "I'm
                      worried about someone" form shows the safeguarding
                      lead's number beside "call 999". The number is on
                      their address book record, which an ordinary attender
                      cannot read now - so it is kept here, beside who the
                      lead is, and the form reads this one document. */
                   && request.resource.data.keys().hasOnly(['templates', 'ratioAll', 'ratioUnder8', 'dbsYears', 'trainingYears',
                                                             'requireChecks', 'leadSiteId', 'leadName', 'leadPhone',
                                                             'updatedAt', 'updatedBy', 'updatedByName', 'trusteeTeam', 'register'])
                   /* the safeguarding risk register (F-265): who the trustees are, and its own settings */
                   && request.resource.data.get('trusteeTeam', 'Elders') is string && request.resource.data.get('trusteeTeam', 'Elders').size() <= 60
                   && request.resource.data.get('register', {}) is map
                   && request.resource.data.templates is map
                   && request.resource.data.ratioAll is int && request.resource.data.ratioAll >= 1 && request.resource.data.ratioAll <= 50
                   && request.resource.data.ratioUnder8 is int && request.resource.data.ratioUnder8 >= 1 && request.resource.data.ratioUnder8 <= 50
                   && wholeYears(request.resource.data.dbsYears) && wholeYears(request.resource.data.trainingYears)
                   && request.resource.data.requireChecks is bool;
    }

    // "Also apply to the ones already made": a safeguarding lead who is not
    // an admin may change how long a form's answers last and are kept, on
    // their own site's forms, and nothing else about them. Rules for one
    // path add up, so this widens the E2 rule without editing it.
    match /forms/{formId} {
      allow list: if sgLeadOf(resource.data.get('siteId', ''));
      allow update: if sgLeadOf(resource.data.get('siteId', ''))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['validity', 'retentionMonths', 'updatedAt', 'updatedBy']);
    }

    match /retentionLog/{entryId} {
      allow read, create: if isMaster();
      allow update, delete: if false;
    }

    // ---- one-off upload links (E4, NEXT-BRIEF §11) ------------------
    //
    // uploadLinks/{id}: one link for one event. Anyone with it may read it
    // (the id is the secret) and take the next numbered place on it - count
    // up by exactly one, while it is on, unexpired and not full. Admins make
    // it, and switch it off or change its expiry and limit.
    // uploadItems/{link}__{n}: one record per photo, for the review queue.
    // Written once by the uploader, for a place they took; read and
    // reviewed by admins only. Nothing is deleted from a page.

    function linkOpen(l) {
      return l.active == true && l.expiresAt > request.time && l.count <= l.maxFiles;
    }

    match /uploadLinks/{linkId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['calEventId', 'eventTitle', 'createdBy', 'createdByName', 'createdAt',
                                                              'expiresAt', 'maxFiles', 'active', 'count'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.count == 0 && request.resource.data.active == true
                    && request.resource.data.maxFiles is int && request.resource.data.maxFiles >= 1 && request.resource.data.maxFiles <= 200
                    && request.resource.data.expiresAt is timestamp;
      allow update: if (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'expiresAt', 'maxFiles'])
                        && request.resource.data.maxFiles is int && request.resource.data.maxFiles <= 200)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                        && resource.data.active == true && resource.data.expiresAt > request.time
                        && request.resource.data.count == resource.data.count + 1
                        && request.resource.data.count <= resource.data.maxFiles);
      allow delete: if false;
    }

    function uploadLink(linkId) {
      return get(/databases/$(database)/documents/uploadLinks/$(linkId)).data;
    }

    match /uploadItems/{itemId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['linkId', 'slot', 'calEventId', 'path', 'name', 'type', 'size',
                                                              'uploaderName', 'at', 'status'])
                    && request.resource.data.slot is int && request.resource.data.slot >= 0
                    && itemId == request.resource.data.linkId + '__' + string(request.resource.data.slot)
                    && request.resource.data.path == 'uploads/' + request.resource.data.linkId + '/' + string(request.resource.data.slot)
                    && linkOpen(uploadLink(request.resource.data.linkId))
                    && request.resource.data.slot < uploadLink(request.resource.data.linkId).count
                    && request.resource.data.calEventId == uploadLink(request.resource.data.linkId).calEventId
                    && request.resource.data.status == 'pending'
                    && request.resource.data.uploaderName is string && request.resource.data.uploaderName.size() <= 80
                    && request.resource.data.name is string && request.resource.data.name.size() <= 200;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt'])
                    && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if false;
    }

    // ---- room hire (Chunk 4, R1) -------------------------------------
    // Room profiles live on the room documents (Chunk 1 rules: admins
    // write, anyone reads a room that is in use). The catering menu is the
    // same shape: anyone may read what is on the menu - the public booking
    // form needs it - and a public list has to ask for active == true.
    match /menus/{menuId} {
      allow read: if active() || activeRecord();
      allow write: if isAdmin()
                   && request.resource.data.name is string && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 120
                   && request.resource.data.get('unit', 'head') in ['head', 'item']
                   && request.resource.data.get('price', 0) is number && request.resource.data.get('price', 0) >= 0;
    }

    // ---- church details (Martin, F-058) -----------------------------
    // One document: the church's name, its enquiry email and its logo. The
    // public hire pages show them, so anyone may read it; admins set it.
    // ONE MATCH BLOCK, NOT TWO. Several match blocks on the same path are
    // ORed, so adding `match /churchSettings/giving` beside this one would
    // leave `giving` readable by `if true` from here - which is the whole
    // point of keeping the bank details off a public document. That trap
    // cost a real mistake once already (the concerns/worries rename).
    // ---- MEMBERS' MEETINGS (21 Oct 2026; design-mocks/members-meeting) ----
    // Run by master admins, the office job and the trustees job (H-9: each
    // church's own teams for them, churchSettings/teamJobs; nothing stored,
    // EGBC's Church office and Elders). Seen
    // by church members (the address book's tick) and by whoever runs them.
    // Votes: a page may write a vote only while it is a draft, and the
    // chair's outcome once it has closed. Opening, closing, every ballot and
    // the tally are the hub's (functions/meetings.js) - no page writes them,
    // and nobody reads the tally: for a secret vote it is the only place a
    // choice exists, and it is never beside a name.
    function meetingRunner() {
      return raOffice() || onTrustees();
    }
    function meetingMember() {
      return isChurchMember() || meetingRunner();
    }
    match /churchMeetings/{mid} {
      allow read: if meetingMember();
      allow create, update: if meetingRunner()
                            && request.resource.data.keys().hasOnly(['title', 'date', 'time', 'place', 'joinKind', 'room',
                                 'papers', 'status', 'notes', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
                            && request.resource.data.get('joinKind', 'room') in ['room', 'zoom'];
      allow delete: if false;
      // The Zoom link and passcode: members only, never on a public page.
      match /private/{doc} {
        allow read: if meetingMember();
        allow write: if meetingRunner() && doc == 'join'
                     && request.resource.data.keys().hasOnly(['zoomUrl', 'zoomId', 'passcode', 'updatedAt', 'updatedBy']);
      }
      // PROXIES (Martin, 21 Oct 2026; design-mocks/members-meeting/PROXIES.md):
      // who holds whose vote. Read by whoever runs the meeting, the member
      // who gave it and the member holding it; written only by the hub's
      // proxyAppoint / proxyCancel.
      match /proxies/{giverId} {
        allow read: if meetingRunner()
                    || (active() && me().get('memberId', '-') == giverId)
                    || (active() && resource.data.holderId == me().get('memberId', '-'));
        allow write: if false;
      }
      match /votes/{vid} {
        allow read: if meetingMember();
        allow create: if meetingRunner()
                      && request.resource.data.status == 'draft'
                      && request.resource.data.keys().hasOnly(['question', 'choices', 'secret', 'status', 'order', 'createdAt', 'createdBy'])
                      && request.resource.data.question is string && request.resource.data.question.size() <= 300
                      && request.resource.data.choices is list
                      && request.resource.data.choices.size() >= 2 && request.resource.data.choices.size() <= 6
                      && request.resource.data.secret is bool;
        allow update: if meetingRunner()
                      && ((resource.data.status == 'draft' && request.resource.data.status == 'draft'
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question', 'choices', 'secret', 'order']))
                       || (resource.data.status == 'closed'
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outcome', 'outcomeBy', 'outcomeAt'])));
        allow delete: if meetingRunner() && resource.data.status == 'draft';
        // Who voted: whoever runs it, and your own. On an OPEN vote, once it
        // has closed, members see everyone's. Nobody writes one from a page.
        match /ballots/{memberId} {
          allow read: if meetingRunner()
                      || (active() && me().get('memberId', '') == memberId)
                      // the member holding this member's proxy (PROXIES.md)
                      || (active() && exists(/databases/$(database)/documents/churchMeetings/$(mid)/proxies/$(memberId))
                          && get(/databases/$(database)/documents/churchMeetings/$(mid)/proxies/$(memberId)).data.holderId == me().get('memberId', '-'))
                      || (meetingMember()
                          && get(/databases/$(database)/documents/churchMeetings/$(mid)/votes/$(vid)).data.secret == false
                          && get(/databases/$(database)/documents/churchMeetings/$(mid)/votes/$(vid)).data.status == 'closed');
          allow write: if false;
        }
        match /tally/{t} {
          allow read, write: if false;
        }
      }
    }

    // CHURCH HQ FOR MORE THAN ONE CHURCH, step 1 (design-mocks/multi-church/
    // PLAN.md; Martin chose B, 22 Oct 2026). The directory and the claims;
    // nothing is moved. A person reads the directory entries of the churches
    // in their own sign-in (token.churches, set by the server from
    // hqMemberships) and their own memberships; no page writes either.
    // EVERY CHURCH'S OWN DATA is not in this file: tools/rules-build.mjs
    // generates firestore.churches.rules from it - every rule below, under
    // churches/{cid}, the claim as the gate (FINDINGS-churchhq H-6, H-7). Step
    // 2's hand-written pilot that stood here was replaced by it (23 Oct 2026).

    match /hqChurches/{cid} {
      allow read: if signedIn() && cid in request.auth.token.get('churches', []);
      allow write: if false;
    }
    match /hqMemberships/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    /* One job's teams on churchSettings/teamJobs: absent, or a list of at
       most 500 (the team ids are checked by the page, which offers only
       the church's own teams). */
    function teamJobList(d, job) {
      return !(job in d) || (d[job] is list && d[job].size() <= 500);
    }
    /* PERMISSIONS (FINDINGS-churchhq H-14, 26 Oct 2026): one action's ticks
       on churchSettings/permissions (egbc-permissions.js). Lists of at most
       500; leaders yes or no. */
    function permAction(a) {
      return a is map && a.keys().hasOnly(['jobs', 'coresOf', 'adminJobs', 'teams', 'leaders'])
             && a.get('jobs', []) is list && a.get('jobs', []).size() <= 500
             && a.get('coresOf', []) is list && a.get('coresOf', []).size() <= 500
             && a.get('adminJobs', []) is list && a.get('adminJobs', []).size() <= 500
             && a.get('teams', []) is list && a.get('teams', []).size() <= 500
             && a.get('leaders', false) is bool;
    }
    match /churchSettings/{id} {
      // `details` is the church's name, enquiry address and logo, and it is
      // read by pages nobody has signed in to - the availability form, the
      // login page, the public room-hire pages. It stays open.
      //
      // `giving` is the church's BANK DETAILS, and it does not. They are
      // not a secret - they are on the giving envelopes - but an account
      // number on a world-readable document is an invitation to a
      // convincing fake, and nobody needs them before signing in.
      allow read: if id != 'giving' || active();

      // THE NOTIFICATIONS MASTER SWITCH (A-081): whether the timers and
      // triggers really send. A master admin only - it is the one setting
      // that starts the church being emailed and buzzed.
      allow write: if (isMaster() && id == 'notifications'
                       && request.resource.data.keys().hasOnly(['live', 'updatedAt', 'updatedBy'])
                       && request.resource.data.live is bool);
      // WHAT THIS CHURCH USES (item 14; the events window's F-230): a
      // master admin's switches, one per part, read by every page through
      // EGBCAuth.uses and by the server (sundaysInWhatsOn). Only the names
      // the hub knows - a new add-on joins this list when it is built.
      allow write: if (isMaster() && id == 'features'
                       && request.resource.data.keys().hasOnly(['care', 'prayer', 'notifications', 'watch', 'sermons', 'giftAid', 'teamMail', 'rotaReports', 'preachingPlan', 'pictureLibrary', 'publicWhatson', 'sundaysInWhatsOn', 'newHere', 'usualPeople', 'screenPaging', 'maintenance', 'events', 'roomBookings', 'kids', 'smallGroups', 'forms', 'payments', 'safeguarding', 'pinBoards', 'meetings', 'notices', 'churchShow', 'availability', 'sessionPlanner', 'buildingCompliance', 'safeguardingRegister', 'enews', 'cardMaker', 'canva', 'quiz', 'updatedAt', 'updatedBy']));
      // THE CHURCH'S SERVICES AND SERVICE ROLES (H-11; egbc-services.js):
      // the kinds of service and meeting, and the roles a service names.
      // The office and master admins keep them; nothing in them is private.
      allow write: if raOffice() && id == 'services'
                       && request.resource.data.keys().hasOnly(['types', 'roles', 'updatedAt', 'updatedBy'])
                       && request.resource.data.types is list && request.resource.data.types.size() <= 200
                       && request.resource.data.roles is list && request.resource.data.roles.size() <= 50
                       && request.resource.data.updatedBy == request.auth.uid;
      // TEAM JOBS (FINDINGS-churchhq H-9, 26 Oct 2026): which of the
      // church's teams do each job (egbc-team-jobs.js). A master admin's,
      // because it decides who reaches the office's, the trustees' and the
      // money pages. Only the 15 jobs; each a list of team ids, at most 500
      // (H-9: no other cap); [] is "nobody". A job left out is EGBC's team.
      // WHO MAY DO WHAT (H-14): the Permissions screen's ticks. Only master
      // admins change permissions (Martin's answer 5). Only the actions the
      // hub knows - a new one joins this list when it is built.
      allow write: if (isMaster() && id == 'permissions'
                       && request.resource.data.keys().hasOnly(['actions', 'updatedAt', 'updatedBy'])
                       && request.resource.data.actions is map
                       && request.resource.data.actions.keys().hasOnly(['kbUpload', 'meetingsAll'])
                       && (!('kbUpload' in request.resource.data.actions) || permAction(request.resource.data.actions.kbUpload))
                       && (!('meetingsAll' in request.resource.data.actions) || permAction(request.resource.data.actions.meetingsAll)));
      allow write: if (isMaster() && id == 'teamJobs'
                       && request.resource.data.keys().hasOnly(['office', 'communications', 'trustees', 'leadership', 'finance', 'buildings', 'pastoral',
                            'worship', 'av', 'choir', 'children', 'youth', 'catering', 'welcome', 'prayer', 'updatedAt', 'updatedBy'])
                       && teamJobList(request.resource.data, 'office') && teamJobList(request.resource.data, 'communications')
                       && teamJobList(request.resource.data, 'trustees') && teamJobList(request.resource.data, 'leadership')
                       && teamJobList(request.resource.data, 'finance') && teamJobList(request.resource.data, 'buildings')
                       && teamJobList(request.resource.data, 'pastoral') && teamJobList(request.resource.data, 'worship')
                       && teamJobList(request.resource.data, 'av') && teamJobList(request.resource.data, 'choir')
                       && teamJobList(request.resource.data, 'children') && teamJobList(request.resource.data, 'youth')
                       && teamJobList(request.resource.data, 'catering') && teamJobList(request.resource.data, 'welcome')
                       && teamJobList(request.resource.data, 'prayer'));
      // SWITCH-OVER (14 Oct 2026): the private forms (Care & support,
      // prayer, "I'm new here") save nothing until rulesLocked is true. A
      // master admin sets it straight after the locked rules deploy
      // (NEXT-BRIEF §26). opensOn is the words the forms show till then.
      allow write: if (isMaster() && id == 'launch'
                       && request.resource.data.keys().hasOnly(['rulesLocked', 'opensOn', 'updatedAt', 'updatedBy'])
                       && request.resource.data.rulesLocked is bool
                       && request.resource.data.get('opensOn', '') is string
                       && request.resource.data.get('opensOn', '').size() <= 40);
      allow write: if (isAdmin() && id == 'details'
                       && request.resource.data.keys().hasOnly(['name', 'enquiryEmail', 'logoUrl', 'logoPath', 'hubUrl', 'ministerTitle', 'updatedAt', 'updatedBy'])
                       // THE MINISTER'S TITLE (26 Oct 2026; Comms' C-53): a word
                       // for a sentence, '' meaning "minister"; any admin.
                       && request.resource.data.get('ministerTitle', '') is string && request.resource.data.get('ministerTitle', '').size() <= 40
                       && !request.resource.data.get('ministerTitle', '').matches('.*[<>"&].*')
                       && request.resource.data.name is string && request.resource.data.name.size() <= 120
                       && request.resource.data.enquiryEmail is string && request.resource.data.enquiryEmail.size() <= 200
                       && (request.resource.data.enquiryEmail == '' || request.resource.data.enquiryEmail.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
                       // THE HUB'S ADDRESS IS MADE, NEVER TYPED (Martin, 26 Oct
                       // 2026): functions/hub-address.js, from the church's short
                       // name. A hubUrl a page typed in before (25 Oct) is kept as
                       // it is and read by nothing; no page sets or changes it.
                       && request.resource.data.get('hubUrl', '') == (resource == null ? '' : resource.data.get('hubUrl', '')))
                   // The giving details: a master admin, or the office job
                   // (H-9: the church's own team for it; nothing stored, EGBC's
                   // Church office), who are the people who would know them.
                   // Deliberately NOT every admin - a children's team admin has
                   // no business changing where the church's money goes.
                   || (raOffice() && id == 'giving'
                       && request.resource.data.keys().hasOnly(['accountName', 'sortCode', 'accountNumber',
                            'reference', 'giftAid', 'giftAidUrl', 'note', 'updatedAt', 'updatedBy'])
                       && request.resource.data.accountName is string && request.resource.data.accountName.size() <= 120
                       && request.resource.data.sortCode is string && request.resource.data.sortCode.size() <= 20
                       && request.resource.data.accountNumber is string && request.resource.data.accountNumber.size() <= 20
                       && request.resource.data.reference is string && request.resource.data.reference.size() <= 60
                       && request.resource.data.get('giftAid', false) is bool
                       && request.resource.data.get('giftAidUrl', '') is string
                       && request.resource.data.get('giftAidUrl', '').size() <= 300
                       && request.resource.data.get('note', '') is string
                       && request.resource.data.get('note', '').size() <= 400);
    }

    // ---- PERMISSIONS: exceptions and the history (H-14, 26 Oct 2026) -----
    //
    // AN EXCEPTION ONLY ADDS (Martin's answer 2): one person, one action.
    // Its id is <action>_<memberId>, so a person has at most one per action.
    // A master admin adds and removes them; the person reads their own (the
    // page shows them the control), nobody else. The reason is a master
    // admin's note, so it is not shown to the rest of the church.
    match /permissionExceptions/{xid} {
      allow read: if isMaster() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow create, update: if isMaster()
                    && request.resource.data.keys().hasOnly(['action', 'memberId', 'uid', 'name', 'by', 'byName', 'at', 'until', 'why', 'notedAt'])
                    && request.resource.data.action in ['kbUpload', 'meetingsAll']
                    && request.resource.data.memberId is string && request.resource.data.memberId.size() > 0 && request.resource.data.memberId.size() <= 120
                    && xid == request.resource.data.action + '_' + request.resource.data.memberId
                    && request.resource.data.get('uid', '') is string && request.resource.data.get('uid', '').size() <= 128
                    && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 120
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.get('until', '') is string
                    && (request.resource.data.get('until', '') == '' || request.resource.data.get('until', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
                    && request.resource.data.get('why', '') is string && request.resource.data.get('why', '').size() <= 300;
      allow delete: if isMaster();
    }
    // Every change, kept: who, when, what it was and what it became. Added
    // by a master admin with the change; never altered.
    match /permissionsLog/{lid} {
      allow read: if isMaster();
      allow create: if isMaster()
                    && request.resource.data.keys().hasOnly(['at', 'by', 'byName', 'action', 'change', 'memberId', 'name', 'before', 'after'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.action in ['kbUpload', 'meetingsAll']
                    && request.resource.data.change in ['ticks', 'added', 'removed'];
      allow update, delete: if false;
    }

    // ---- room bookings (Chunk 4, R2) ---------------------------------
    //
    // A room's day is 96 quarter-hours: roomDays/<room>_<YYYY-MM-DD>.slots,
    // 0 free, 1 or more taken. A day never booked counts as the room's
    // standing weekly pattern (rooms.rotaWeek, its rota services).
    //
    // WHAT THESE RULES GUARANTEE, whatever a page does:
    //   - nobody but the office books over a confirmed booking, a rota
    //     service, or anyone's setup and pack-down time;
    //   - a confirmed booking takes its quarter-hours in the same write as
    //     the booking, and only if every one of them was free;
    //   - a member's booking is confirmed straight away only where the room
    //     (or, by default, its site) says so; otherwise it waits;
    //   - the public's requests always wait;
    //   - the office - admins and the site's bookings admin - can always
    //     see, move or cancel any booking, and may book over something.

    // HEADROOM (main's H-8, 23 Oct): Firestore evaluates at most 1,000
    // expressions a request, and the office's event booking was within one
    // of it. A day with no standing pattern is now null - all free - instead
    // of a list of 96 zeros built on every check; a room's record and its
    // parts are worked out once; cheap tests come first.
    // screenshots/events/h8-headroom.test.mjs keeps the room measured.
    function isoDow(day) {
      let p = day.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])).dayOfWeek();
    }
    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }
    // ---- rooms made of other rooms (Martin, 14 Oct 2026) ----
    // A room with parts has no day of its own: its time is held on each
    // part's day. So booking it needs every part free (and open), and marks
    // every part; booking a part is checked on the part's day, which the
    // whole room's bookings have marked. At most 4 parts, written out.
    function partsOf(roomId) { return roomData(roomId).get('parts', []); }
    function partFree(roomId, d, dow) {
      let s = exists(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day))
        ? get(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day)).data.slots
        : roomData(roomId).get('rotaWeek', {}).get(dow, null);
      return roomOpen(roomId, d.day) && (s == null || s[d.slotFrom:d.slotTo].hasOnly([0]));
    }
    // Not each part's closures: closing a part closes every room it is part
    // of (the closure's wholeIds), so the whole room's own closed day, which
    // memberCreate checks, covers its parts. Each part's too ran past the
    // 1,000-expression limit for a hall of four parts in a church's own hub.
    function partMarked(roomId, d, key) {
      return getAfter(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day)).data.lastBooking == key;
    }
    function partHeld(roomId, d) {
      return !getAfter(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day)).data.slots[d.slotFrom:d.slotTo].hasAny([0]);
    }
    function partGivenBack(roomId, b, key) {
      return getAfter(/databases/$(database)/documents/roomDays/$(roomId + '_' + b.day)).data.get('lastCancel', '') == key;
    }
    function partsFree(p, d, dow) {
      return p.size() <= 4 && partFree(p[0], d, dow) && (p.size() < 2 || partFree(p[1], d, dow))
             && (p.size() < 3 || partFree(p[2], d, dow)) && (p.size() < 4 || partFree(p[3], d, dow));
    }
    function footMarked(d, key) {
      let p = partsOf(d.roomId);
      return p.size() == 0 ? partMarked(d.roomId, d, key)
        : (p.size() <= 4 && partMarked(p[0], d, key) && (p.size() < 2 || partMarked(p[1], d, key))
           && (p.size() < 3 || partMarked(p[2], d, key)) && (p.size() < 4 || partMarked(p[3], d, key)));
    }
    function footHeld(d, p) {
      return p.size() == 0 ? partHeld(d.roomId, d)
        : (p.size() <= 4 && partHeld(p[0], d) && (p.size() < 2 || partHeld(p[1], d))
           && (p.size() < 3 || partHeld(p[2], d)) && (p.size() < 4 || partHeld(p[3], d)));
    }
    function footGivenBack(b, key) {
      let p = partsOf(b.roomId);
      return p.size() == 0 ? partGivenBack(b.roomId, b, key)
        : (p.size() <= 4 && partGivenBack(p[0], b, key) && (p.size() < 2 || partGivenBack(p[1], b, key))
           && (p.size() < 3 || partGivenBack(p[2], b, key)) && (p.size() < 4 || partGivenBack(p[3], b, key)));
    }
    // The day a booking may mark: its room's, or (a room made of parts) a part's.
    function dayOfBooking(roomOnDay, bookingRoom) {
      return partsOf(bookingRoom).size() == 0 ? roomOnDay == bookingRoom : roomOnDay in partsOf(bookingRoom);
    }
    // null: no standing pattern that day, so all free
    function baseSlots(roomId, day) {
      return roomData(roomId).get('rotaWeek', {}).get(string(isoDow(day)), null);
    }
    function bookingsAdminOf(siteId) {
      return active() && siteId is string && siteId != ''
             && exists(/databases/$(database)/documents/bookingSettings/$(siteId))
             && me().get('memberId', '-') in get(/databases/$(database)/documents/bookingSettings/$(siteId)).data.get('bookingsAdmins', []);
    }
    // The office: an admin (or master), or the site's bookings admin. The
    // same as isAdmin() || bookingsAdminOf(siteId), with the person's record
    // read once (H-8: a hall's booking checks it for every part's day).
    function theOffice(siteId) {
      return signedIn() && officeFor(myRecord(), siteId);
    }
    function officeFor(u, siteId) {
      return u != null && u.data.status == 'active'
             && (u.data.get('masterAdmin', false) == true || u.data.get('adminFor', []).size() > 0
                 || (siteId is string && siteId != ''
                     && exists(/databases/$(database)/documents/bookingSettings/$(siteId))
                     && u.data.get('memberId', '-') in get(/databases/$(database)/documents/bookingSettings/$(siteId)).data.get('bookingsAdmins', [])));
    }
    function memberInstant(roomId) {
      let mode = roomData(roomId).get('memberBookings', 'site');
      return mode == 'instant'
             || (mode == 'site'
                 && get(/databases/$(database)/documents/sites/$(roomData(roomId).siteId)).data.get('memberBookings', 'instant') == 'instant');
    }

    // The times, and the quarter-hours they take with setup and pack-down,
    // checked with whole numbers only: slotFrom is the quarter-hour the
    // setup starts in, slotTo the first one after the pack-down ends.
    function bookingTimesOk(d) {
      let a = d.startMin - d.setupMins;
      let b = d.endMin + d.packdownMins;
      return d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && d.startMin is int && d.endMin is int && d.setupMins is int && d.packdownMins is int
             && d.slotFrom is int && d.slotTo is int
             && d.setupMins >= 0 && d.packdownMins >= 0 && d.endMin > d.startMin
             && a >= 0 && b <= 1440
             && d.slotFrom * 15 <= a && (d.slotFrom + 1) * 15 > a
             && d.slotTo * 15 >= b && (d.slotTo - 1) * 15 < b;
    }

    function bookingShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'status', 'siteId', 'roomId', 'groupId', 'day', 'startMin', 'endMin', 'startLocal', 'endLocal',
                               'setupMins', 'packdownMins', 'slotFrom', 'slotTo', 'title', 'people', 'layout', 'av', 'refreshments',
                               'resources', 'notes', 'requester', 'memberUid', 'memberName', 'createdAt', 'calEventId',
                               'decidedBy', 'decidedByName', 'decidedAt', 'decisionNote', 'override', 'cancelledAt', 'movedAt',
                               'series', 'cancelledBy', 'bookingType', 'charity', 'quote', 'memberRate', 'accepted', 'payment',
                               'cancelRequest', 'invoice', 'damage'])
             && (!('memberRate' in d) || d.memberRate is bool)
             // Chunk 5: the kind of booking, a charity's say-so (the office
             // checks it), and the quote as it stood. Amounts are the
             // office's to set: a hirer's own figures are only what they saw.
             && (!('bookingType' in d) || (d.bookingType is string && d.bookingType.size() <= 60))
             && (!('charity' in d) || d.charity is bool)
             && (!('quote' in d) || (d.quote is map && d.quote.get('lines', []) is list && d.quote.get('lines', []).size() <= 60))
             // A repeating booking (R3): one booking per date, each carrying
             // the series id, which date it is, of how many, and the rule.
             && (!('series' in d) || (d.series is map && d.series.keys().hasOnly(['id', 'rule', 'n', 'of'])
                 && d.series.id is string && d.series.id.size() <= 40 && d.series.rule in ['week', 'fortnight', 'month']
                 && d.series.n is int && d.series.of is int && d.series.n >= 1 && d.series.n <= d.series.of && d.series.of <= 52))
             && d.title is string && d.title.size() <= 120
             && d.notes is string && d.notes.size() <= 2000
             && d.people is int && d.people >= 1
             && d.requester is map
             && d.kind in ['member', 'hire', 'office', 'event'] && d.status in ['requested', 'confirmed']
             && d.layout is string && d.layout.size() <= 40 && d.groupId is string && d.groupId.size() <= 40
             && d.av is map && d.refreshments is map && d.resources is list && d.resources.size() <= 30
             && bookingTimesOk(d)
             && roomShapeOk(roomData(d.roomId), d);
    }
    function roomShapeOk(r, d) {
      return r.siteId == d.siteId && r.get('active', false) == true
             // Never more people than the room's fire-safety maximum (R1).
             && (r.get('fireMax', 0) == 0 || d.people <= r.get('fireMax', 0));
    }

    // A room closed for the day (Close a room, F-135) is not free at any
    // time: only the office may book it, as booking over something, with
    // a reason.
    // (the path built once: for each part of a four-part hall this ran past
    // the 1,000-expression limit in a church's own hub)
    function roomOpen(roomId, day) {
      let c = /databases/$(database)/documents/roomClosedDays/$(roomId + '_' + day);
      return !exists(c) || get(c).data.get('on', false) != true;
    }
    function slotsFree(d) {
      return slotsFreeIn(d, partsOf(d.roomId));
    }
    function slotsFreeIn(d, p) {
      let dow = string(isoDow(d.day));
      return p.size() == 0 ? partFree(d.roomId, d, dow) : (roomOpen(d.roomId, d.day) && partsAsked(p, d, dow));
    }
    // A REQUEST for a room made of parts (members and the public) holds
    // nothing: the office's approval marks every part's day, and the rules
    // check each part fully then. So here only each part's day, where it has
    // been written, is read: with each part's record and closures too, a hall
    // of four parts ran past Firestore's limits (10 reads; 1,000 expressions)
    // and every request for it was refused. The page shows the parts' weekly
    // patterns, and approving checks them.
    function partAsked(roomId, d, dow) {
      return !exists(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day))
             || get(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day)).data.slots[d.slotFrom:d.slotTo].hasOnly([0]);
    }
    function partsAsked(p, d, dow) {
      return p.size() <= 4 && partAsked(p[0], d, dow) && (p.size() < 2 || partAsked(p[1], d, dow))
             && (p.size() < 3 || partAsked(p[2], d, dow)) && (p.size() < 4 || partAsked(p[3], d, dow));
    }

    // Book a room is for team leaders and core teams (Martin, 26 Oct; H-16):
    // a master admin, anyone who administers a team, a leader or above on
    // one, or on a core team (covers, the server's own answer). The same as
    // EGBCAuth.leadsOrCore(). The office (its job) and the room's building's
    // bookings admins may book too (Martin, 28 Oct): mayBookRoom().
    function leadsOrCore() {
      return isMaster() || me().get('adminFor', []).size() > 0
             || 'owner' in me().get('roles', {})
             || me().get('roles', {}).values().hasAny(['leader', 'admin', 'owner'])
             || me().get('covers', []).size() > 0;
    }
    // Kept lean on purpose: with raOffice() and bookingsAdminOf() a bookings
    // admin's booking ran past the rules' limit on work in one request, and
    // was refused though each part alone allowed it (H&S step 3a). So the
    // person's record is read once, their teams are the ones they are on or
    // cover (H-15), and leadsOrCore() has already asked about master admins.
    // memberCreate has checked active().
    function mayBookRoom(roomId) {
      return leadsOrCore() || officeOrBookingsAdmin(me(), roomData(roomId).siteId);
    }
    function officeOrBookingsAdmin(u, siteId) {
      let bs = /databases/$(database)/documents/bookingSettings/$(siteId);
      return (exists(bs) && u.get('memberId', '-') in get(bs).data.get('bookingsAdmins', []))
             // the jobs the server keeps on the person's record (main's H-9 part 2): no read;
             // the team jobs themselves only for a record it hasn't reached yet
             || ('jobs' in u ? 'office' in u.jobs
                 : u.get('teams', []).concat(u.get('covers', [])).hasAny(raJobTeams('office', ['Church office'])));
    }
    function memberCreate(key) {
      let d = request.resource.data;
      return d.kind == 'member' && active() && d.memberUid == request.auth.uid && mayBookRoom(d.roomId)
             && roomData(d.roomId).get('bookableByMembers', true) == true
             // A charged kind of booking waits for the office, who confirms
             // the price and records the charge (F-077).
             && (!('bookingType' in d) || d.status == 'requested'
                 || get(/databases/$(database)/documents/bookingTypes/$(d.bookingType)).data.get('charged', false) == false)
             && ((d.status == 'confirmed' && memberInstant(d.roomId) && roomOpen(d.roomId, d.day)
                  && footMarked(d, key))
                 || (d.status == 'requested' && slotsFree(d)));
    }

    function publicCreate() {
      let d = request.resource.data;
      return d.kind == 'hire' && d.status == 'requested' && d.memberUid == ''
             // The members' rate is never the public's (Martin, F-077).
             && d.get('memberRate', false) == false
             && roomData(d.roomId).get('bookableByHirers', false) == true
             && d.requester.keys().hasOnly(['name', 'email', 'phone', 'org'])
             && d.requester.name is string && d.requester.name.size() > 0 && d.requester.name.size() <= 120
             && d.requester.email is string && d.requester.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
             && slotsFree(d);
    }

    // The office (and an event's booking, F-072a): confirmed, its time held
    // on the room's day in the same write, and either free beforehand or
    // marked as booked over something, with the reason.
    //
    // FREE, FOR THE OFFICE (H-8): the page writes each quarter-hour as it was
    // plus one, so the room's day after this write holds exactly 1 across the
    // booking's time only if it was all free before. The office may write a
    // room's day as it likes anyway (theOffice, below), so reading the day as
    // it was - and the room's weekly pattern, for a day never written - adds
    // nothing for the office but cost: for a hall of four parts it was over
    // Firestore's 1,000-expression limit. Members and the public, who can't
    // write the day freely, are still checked against the day as it was.
    function officeCreate() {
      let d = request.resource.data;
      let p = partsOf(d.roomId);
      return d.status == 'confirmed' && theOffice(d.siteId)
             && ((d.get('override', false) == true && d.get('decisionNote', '') is string && d.get('decisionNote', '').size() > 0
                  && footHeld(d, p))
                 || (p.size() == 0 ? partFirst(d.roomId, d) : (roomOpen(d.roomId, d.day) && partsFirst(p, d))));
    }
    // held by this booking alone: open that day, and exactly 1 across its time after the write
    function partFirst(roomId, d) {
      return roomOpen(roomId, d.day)
             && getAfter(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day)).data.slots[d.slotFrom:d.slotTo].hasOnly([1]);
    }
    function partsFirst(p, d) {
      return p.size() <= 4 && partFirst(p[0], d) && (p.size() < 2 || partFirst(p[1], d))
             && (p.size() < 3 || partFirst(p[2], d)) && (p.size() < 4 || partFirst(p[3], d));
    }

    // ---- the hirer accepts the quote and the terms (Chunk 5, stage 2) ----
    // Whoever holds the booking's private link (its key) may accept, once:
    // only on a confirmed booking with a price; nothing else changes; the
    // time is the server's own; the total is the price confirmed; and the
    // terms are the current version for that kind of booking (or none, if
    // the kind has no terms yet).
    function hirerAccepts() {
      let b = resource.data;
      let n = request.resource.data;
      let a = n.accepted;
      let tv = 'bookingType' in b ? get(/databases/$(database)/documents/bookingTypes/$(b.bookingType)).data.get('termsVersion', 0) : 0;
      return b.status == 'confirmed' && !('accepted' in b) && ('quote' in b)
             && n.diff(b).affectedKeys().hasOnly(['accepted'])
             && a.keys().hasOnly(['name', 'at', 'termsId', 'termsVersion', 'total'])
             && a.name is string && a.name.size() > 0 && a.name.size() <= 120
             && a.at == request.time
             && a.total == b.quote.total
             && a.termsVersion == tv
             && a.termsId == (tv == 0 ? '' : b.bookingType + '_v' + string(tv));
    }

    // ---- the hirer asks to cancel (Martin, F-080) ----------------------
    // With the link, a hirer may ask, with a reason, at the server's time.
    // Asking changes nothing else: the office cancels or keeps the booking
    // (Room bookings). Asking again is allowed once the office has answered.
    function hirerAsksCancel() {
      let b = resource.data;
      let n = request.resource.data;
      let c = n.cancelRequest;
      return b.status in ['requested', 'confirmed']
             && (!('cancelRequest' in b) || b.cancelRequest.status != 'asked')
             && n.diff(b).affectedKeys().hasOnly(['cancelRequest'])
             && c.keys().hasOnly(['status', 'at', 'reason'])
             && c.status == 'asked' && c.at == request.time
             && c.reason is string && c.reason.size() <= 1000;
    }

    // ARRIVED (F-260): the hirer (with the booking's private reference, as
    // for accepting the quote) marks their hire arrived; a member marks their
    // own booking. Once, stamped by the server's clock, nothing else touched.
    // The office marks or unmarks through its own path.
    function arrives() {
      let b = resource.data;
      let n = request.resource.data;
      return b.status == 'confirmed' && !('arrived' in b)
             && n.diff(b).affectedKeys().hasOnly(['arrived'])
             && n.arrived.keys().hasOnly(['at', 'by', 'name']) && n.arrived.at == request.time
             && n.arrived.name is string && n.arrived.name.size() <= 120
             && ((n.arrived.by == 'hirer' && b.get('kind', '') == 'hire')
                 || (n.arrived.by == 'member' && active() && b.get('memberUid', '-') == request.auth.uid));
    }
    match /bookings/{key} {
      // The key is the booking's private reference (32 random characters).
      allow get: if true;
      allow list: if theOffice(resource.data.siteId)
                  || (active() && resource.data.get('memberUid', '') == request.auth.uid);
      allow create: if key.size() >= 20 && bookingShape()
                    && (memberCreate(key) || publicCreate() || officeCreate());
      allow update: if (theOffice(resource.data.siteId) && theOffice(request.resource.data.siteId))
                    || memberCancel(key) || hirerAccepts() || hirerAsksCancel() || arrives();
      allow delete: if false;
    }

    // THE CATERERS' LIST (F-260): what the kitchen needs for each confirmed
    // booking with refreshments, and nothing about who booked; made and
    // removed only by the server (functions/rooms-day.js). The office and the
    // "Catering" team read it and mark how far they have got.
    function cateringSees(siteId) { return theOffice(siteId) || raOnJob('catering', ['Catering']); }
    match /cateringOrders/{key} {
      allow read: if cateringSees(resource.data.siteId);
      allow update: if cateringSees(resource.data.siteId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'stateBy', 'stateByName', 'stateAt'])
                    && request.resource.data.state in ['new', 'prepared', 'served']
                    && request.resource.data.stateBy == request.auth.uid && request.resource.data.stateAt == request.time
                    && request.resource.data.stateByName is string && request.resource.data.stateByName.size() <= 120;
      allow create, delete: if false;
    }

    // A room's day. Anyone may read it: it says only which quarter-hours
    // are taken, never by whom. The office writes it as it likes; anyone
    // else only by marking a new confirmed booking's own quarter-hours,
    // all of which were free, and nothing else.
    function marksNewBooking(dayId) {
      let n = request.resource.data;
      let key = n.lastBooking;
      let b = getAfter(/databases/$(database)/documents/bookings/$(key)).data;
      let before = resource == null ? baseSlots(n.roomId, b.day) : resource.data.slots;
      return n.keys().hasOnly(['slots', 'lastBooking', 'roomId', 'day', 'siteId'])
             && key is string && key != ''
             && !exists(/databases/$(database)/documents/bookings/$(key))
             && b.status == 'confirmed'
             && dayOfBooking(n.roomId, b.roomId) && dayId == n.roomId + '_' + b.day && n.day == b.day && n.siteId == b.siteId
             && n.slots is list && n.slots.size() == 96
             && n.slots[b.slotFrom:b.slotTo].hasOnly([1])
             // no standing pattern that day (null): everything else stays free
             && (before == null
                 ? (n.slots[0:b.slotFrom].hasOnly([0]) && n.slots[b.slotTo:96].hasOnly([0]))
                 : (before.size() == 96 && before[b.slotFrom:b.slotTo].hasOnly([0])
                    && n.slots[0:b.slotFrom] == before[0:b.slotFrom]
                    && n.slots[b.slotTo:96] == before[b.slotTo:96]));
    }

    // ---- members cancel their own (R3) --------------------------------
    // A member may cancel their own booking, and nothing else about it. A
    // confirmed one must give its time back in the same write: the room's
    // day names it as lastCancel, and that write is allowed only by
    // unmarksOwnBooking below.
    function memberCancel(key) {
      let b = resource.data;
      let n = request.resource.data;
      return active() && b.kind == 'member' && b.get('memberUid', '') == request.auth.uid
             && b.status in ['requested', 'confirmed'] && n.status == 'cancelled'
             && n.diff(b).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy'])
             && n.cancelledBy == request.auth.uid
             && (b.status == 'requested'
                 || footGivenBack(b, key));
    }
    // Giving the time back: only the member's own confirmed booking, being
    // cancelled in this same write; only its own quarter-hours, each from
    // exactly 1 to 0 (so nothing the office booked over it is freed); and
    // nothing else on the day changes.
    function unmarksOwnBooking(dayId) {
      let n = request.resource.data;
      let o = resource.data;
      let key = n.get('lastCancel', '');
      let b = get(/databases/$(database)/documents/bookings/$(key)).data;
      let a = getAfter(/databases/$(database)/documents/bookings/$(key)).data;
      return key is string && key.size() >= 20
             && n.keys().hasOnly(['slots', 'lastBooking', 'roomId', 'day', 'siteId', 'lastCancel'])
             && n.lastBooking == o.lastBooking && n.roomId == o.roomId && n.day == o.day && n.siteId == o.siteId
             && b.get('memberUid', '') == request.auth.uid && b.status == 'confirmed' && a.status == 'cancelled'
             && dayOfBooking(n.roomId, b.roomId) && dayId == n.roomId + '_' + b.day
             && n.slots is list && n.slots.size() == 96
             && o.slots[b.slotFrom:b.slotTo].hasOnly([1]) && n.slots[b.slotFrom:b.slotTo].hasOnly([0])
             && n.slots[0:b.slotFrom] == o.slots[0:b.slotFrom]
             && n.slots[b.slotTo:96] == o.slots[b.slotTo:96];
    }

    match /roomDays/{dayId} {
      allow read: if true;
      allow create: if theOffice(request.resource.data.get('siteId', '')) || marksNewBooking(dayId);
      allow update: if theOffice(request.resource.data.get('siteId', '')) || marksNewBooking(dayId) || unmarksOwnBooking(dayId);
      allow delete: if false;
    }

    // ---- hire prices and charges (Chunk 5, stage 1) -------------------
    // Booking types (Private hire, Community group, Church use...) and each
    // room's prices for each type. Anyone may read them: the public's
    // instant quote is worked out from them. Only admins change them.
    match /bookingTypes/{typeId} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
                   && request.resource.data.get('forPublic', false) is bool && request.resource.data.get('charged', false) is bool
                   && request.resource.data.get('termsVersion', 0) is int
                   // Members' rate: none, a percentage off, or a price list of their own.
                   && (!('membersRate' in request.resource.data)
                       || (request.resource.data.membersRate.get('mode', 'none') in ['none', 'percent', 'list']
                           && request.resource.data.membersRate.get('pct', 0) is int
                           && request.resource.data.membersRate.get('pct', 0) >= 0 && request.resource.data.membersRate.get('pct', 0) <= 100));
    }
    match /rateCards/{cardId} {
      allow read: if true;
      allow write: if isAdmin()
                   && (cardId == request.resource.data.roomId + '__' + request.resource.data.typeId
                       || (cardId == request.resource.data.roomId + '__' + request.resource.data.typeId + '__members'
                           && request.resource.data.get('forMembers', false) == true))
                   && request.resource.data.get('hourly', 0) is int && request.resource.data.get('hourly', 0) >= 0
                   && request.resource.data.get('vat', false) is bool
                   && request.resource.data.get('vatRate', 0) is int && request.resource.data.get('vatRate', 0) >= 0 && request.resource.data.get('vatRate', 0) <= 100;
    }
    // What a hirer owes for a booking. Only the office of that site sees or
    // writes it (the hirer's own page comes in stage 2); never deleted, so
    // the money always has a trail. Amounts are whole pence.
    function chargeShape() {
      let c = request.resource.data;
      return c.keys().hasOnly(['bookingKey', 'seriesId', 'siteId', 'roomId', 'kind', 'payer', 'lines', 'subtotal', 'vat', 'vatRate', 'total',
                               'deposit', 'damageDeposit', 'status', 'payments', 'dueDate', 'createdAt', 'createdBy', 'adjusted', 'updatedAt', 'updatedBy', 'note',
                               'invoiceId', 'invoiceNumber', 'damage', 'exportedAt', 'payerKey'])
             && (!('damage' in c) || (c.damage is map && c.damage.get('status', 'none') in ['none', 'held', 'returned', 'kept']))
             && c.siteId is string && c.bookingKey is string
             && c.lines is list && c.lines.size() <= 60
             && c.subtotal is int && c.vat is int && c.total is int && c.total == c.subtotal + c.vat
             && c.status in ['unpaid', 'part-paid', 'paid', 'cancelled']
             && c.get('payments', []) is list && c.get('payments', []).size() <= 200
             && exists(/databases/$(database)/documents/bookings/$(c.bookingKey))
             && get(/databases/$(database)/documents/bookings/$(c.bookingKey)).data.siteId == c.siteId;
    }
    // Terms and conditions, a version at a time: <kind>_v<n>. Anyone may
    // read them (the hirer's page shows them). Admins add a version; nobody
    // changes or deletes one, so what a hirer accepted stays on record.
    match /terms/{termsId} {
      allow read: if true;
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['typeId', 'version', 'text', 'at', 'by'])
                    && request.resource.data.version is int && request.resource.data.version >= 1
                    && termsId == request.resource.data.typeId + '_v' + string(request.resource.data.version)
                    && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 20000;
      allow update, delete: if false;
    }

    // ---- invoices, numbered (Chunk 5, stage 3) -------------------------
    // One counter for the whole church: counters/invoices.next is the next
    // number. An invoice takes it in the same write as the counter moves on
    // by exactly one, so two people issuing at once cannot get the same
    // number, and no number is skipped. Invoices are never deleted.
    function invoiceNumberTaken(seq) {
      return seq is int && seq >= 1
             && (exists(/databases/$(database)/documents/counters/invoices)
                   ? get(/databases/$(database)/documents/counters/invoices).data.next == seq
                   : seq == 1)
             && getAfter(/databases/$(database)/documents/counters/invoices).data.next == seq + 1;
    }
    match /invoices/{invId} {
      allow read: if theOffice(resource.data.siteId);
      allow create: if theOffice(request.resource.data.siteId)
                    && invId == 'inv_' + string(request.resource.data.seq)
                    && invoiceNumberTaken(request.resource.data.seq)
                    && request.resource.data.number is string
                    && request.resource.data.chargeIds is list && request.resource.data.chargeIds.size() >= 1 && request.resource.data.chargeIds.size() <= 200
                    && request.resource.data.total is int && request.resource.data.total == request.resource.data.subtotal + request.resource.data.vat;
      allow update: if theOffice(resource.data.siteId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'accounts', 'emailedAt', 'exportedAt']);
      allow delete: if false;
    }
    match /counters/{counterId} {
      allow read: if volunteer();
      allow create, update: if volunteer() && counterId == 'invoices'
                            && request.resource.data.keys().hasOnly(['next'])
                            && request.resource.data.next == (resource == null ? 2 : resource.data.next + 1)
                            && existsAfter(/databases/$(database)/documents/invoices/$('inv_' + string(request.resource.data.next - 1)));
      allow delete: if false;
    }

    // ---- hirers (Chunk 5, stage 3) ---------------------------------------
    // Who hires: contact, invoice address, charity (and whether the office has
    // checked it), regular hirer, monthly invoicing, documents with expiry
    // dates. Personal details: only the office of the site that keeps them.
    match /hirers/{hirerId} {
      allow read: if theOffice(resource.data.siteId);
      allow create, update: if theOffice(request.resource.data.siteId)
                            && (resource == null || theOffice(resource.data.siteId))
                            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                            && request.resource.data.email is string && request.resource.data.email.size() <= 200
                            && request.resource.data.get('documents', []) is list && request.resource.data.get('documents', []).size() <= 30;
      allow delete: if false;
    }

    // ---- the accounts setting, and what waits for Calla Accounts ----------
    // settings/accounts: 'none' (the hub is the whole money system; the
    // default) or 'calla'. Who numbers invoices in Calla mode is Martin's to
    // decide (the brief): recorded as 'hub' until he does.
    // Office only (Martin, F-108): admins read it here; each site's bookings
    // admins read their site's copy, accountsFor/{siteId}, which an admin's
    // save writes for every site (H&S step 2b: no limit on the sites, where
    // three were checked before).
    match /settings/accounts {
      allow read: if isAdmin();
      allow write: if isAdmin()
                   && request.resource.data.mode in ['none', 'calla']
                   && request.resource.data.get('invoiceNumbersBy', 'hub') in ['hub', 'calla'];
    }
    match /accountsFor/{siteId} {
      allow read: if theOffice(siteId);
      allow write: if isAdmin()
                   && request.resource.data.keys().hasOnly(['mode', 'invoiceNumbersBy', 'payText', 'payDays', 'updatedAt'])
                   && request.resource.data.mode in ['none', 'calla']
                   && request.resource.data.get('invoiceNumbersBy', 'hub') in ['hub', 'calla']
                   && request.resource.data.get('payText', '') is string && request.resource.data.get('payText', '').size() <= 1000
                   && request.resource.data.get('payDays', 14) is int;
    }
    match /accountsQueue/{itemId} {
      allow read: if theOffice(resource.data.siteId);
      allow create: if theOffice(request.resource.data.siteId)
                    && request.resource.data.kind in ['customer', 'invoice', 'payment']
                    && request.resource.data.status in ['waiting', 'sent', 'failed'];
      allow update: if theOffice(resource.data.siteId) && theOffice(request.resource.data.siteId);
      allow delete: if false;
    }

    match /charges/{chargeId} {
      allow read: if theOffice(resource.data.siteId);
      allow create: if theOffice(request.resource.data.siteId) && chargeShape();
      allow update: if theOffice(resource.data.siteId) && theOffice(request.resource.data.siteId) && chargeShape();
      allow delete: if false;
    }

    // ---- Sunday kids registration (Chunk 6, stage 1) -------------------
    //
    // NEED TO KNOW (Martin, F-087). Children's details are kept apart from
    // the address book (open to anyone) and contacts (open to every member),
    // and inside them:
    //   - THE LEADS see every child at the site, with medical details: master
    //     admins, the site's safeguarding lead and deputy, and the admins of
    //     the children's teams the site names in kidsSettings (e.g. an admin
    //     of Kids Church).
    //   - A GROUP'S LEADERS (kidsGroups.leaderIds, member ids) see that
    //     group's children, with their medical details, and nobody else's.
    //   - Nobody else sees any of it.
    // Each child's medical details are their own copy (kidsMedical), carrying
    // the child's group, so a leader of one group can never reach a brother
    // or sister's details in another through the family's form. The family
    // record (which points at the forms) is the leads' alone.
    function kidsSettingsOf(siteId) {
      return get(/databases/$(database)/documents/kidsSettings/$(siteId)).data;
    }
    function kidsLead(siteId) {
      return active() && siteId is string && siteId != ''
             && (isMaster() || sgLeadOf(siteId)
                 || (exists(/databases/$(database)/documents/kidsSettings/$(siteId))
                     && me().get('adminFor', []).hasAny(kidsSettingsOf(siteId).get('teams', []))));
    }
    function kidsGroupLeader(groupId) {
      return active() && groupId is string && groupId != ''
             && exists(/databases/$(database)/documents/kidsGroups/$(groupId))
             && me().get('memberId', '-') in get(/databases/$(database)/documents/kidsGroups/$(groupId)).data.get('leaderIds', []);
    }
    // The registration form is the parent consent form (E2), set up once
    // per site; the leads may use that form and no other.
    function kidsFormOf(siteId, formId) {
      return siteId is string && siteId != '' && formId is string && formId != ''
             && exists(/databases/$(database)/documents/kidsSettings/$(siteId))
             && kidsSettingsOf(siteId).get('formId', '') == formId
             && kidsLead(siteId);
    }
    // ---- screen numbers: one family each, per site per day (Martin, 14 Oct 2026) ----
    // Reserved once and never changed, so two families can never share one,
    // even from two desks at the same moment. A number and a family id, no
    // names: the number is shown on a public screen anyway.
    match /kidsScreenNos/{id} {
      allow read: if active();
      allow create: if request.resource.data.keys().hasOnly(['siteId', 'day', 'n', 'familyId', 'groupId', 'at'])
                    && request.resource.data.siteId is string && request.resource.data.n is string && request.resource.data.n.matches('[0-9]{3}')
                    && request.resource.data.day is string && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && request.resource.data.familyId is string && request.resource.data.familyId.size() > 0
                    && id == request.resource.data.siteId + '_' + request.resource.data.day + '_' + request.resource.data.n
                    && (kidsLead(request.resource.data.siteId) || kidsSessionLeaderNow(request.resource.data.siteId)
                        || (kidsGroupLeader(request.resource.data.get('groupId', ''))
                            && get(/databases/$(database)/documents/kidsGroups/$(request.resource.data.get('groupId', ''))).data.get('siteId', '') == request.resource.data.siteId));
      allow update, delete: if false;
    }

    match /kidsSettings/{siteId} {
      allow read: if volunteer();
      // Who the leads are is set by a master admin or the safeguarding lead.
      allow write: if ((isMaster() || sgLeadOf(siteId))
                   && request.resource.data.get('teams', []) is list && request.resource.data.get('teams', []).size() <= 500
                   && request.resource.data.get('formId', '') is string
                   && request.resource.data.get('screenPaging', true) is bool)
                   // Kids Church leads may switch screen numbers on or off, and nothing else.
                   || (kidsLead(siteId) && resource != null
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['screenPaging', 'updatedAt', 'updatedBy'])
                       && request.resource.data.screenPaging is bool);
    }
    // Groups by school year, each with its room, day and time, ratio and
    // leaders. The leads set them.
    match /kidsGroups/{groupId} {
      allow read: if volunteer();
      allow write: if kidsLead(request.resource.data.siteId)
                   && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
                   && request.resource.data.get('ratio', 0) is int
                   && request.resource.data.get('leaderIds', []) is list && request.resource.data.get('leaderIds', []).size() <= 500;
    }
    // A family: the parent who registered, how to reach them, who may
    // collect, and which forms it came from. The leads' alone. What a
    // group's leaders need (phone, emergency contacts, collectors) is copied
    // onto each child. Never deleted from a page.
    match /kidsFamilies/{familyId} {
      allow read: if kidsLead(resource.data.siteId);
      allow create, update: if kidsLead(request.resource.data.siteId) && (resource == null || kidsLead(resource.data.siteId))
                            && request.resource.data.parentName is string && request.resource.data.parentName.size() > 0
                            && request.resource.data.get('collectors', []) is list && request.resource.data.get('collectors', []).size() <= 20;
      allow delete: if false;
    }
    match /kidsChildren/{childId} {
      allow read: if kidsLead(resource.data.siteId) || kidsGroupLeader(resource.data.get('groupId', ''));
      allow create, update: if kidsLead(request.resource.data.siteId) && (resource == null || kidsLead(resource.data.siteId))
                            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                            && request.resource.data.familyId is string
                            && request.resource.data.get('status', 'registered') in ['registered', 'visitor', 'left']
                            && !('medicalRef' in request.resource.data)
                            // A child who changes group takes their medical
                            // copy with them, in the same write.
                            && (!exists(/databases/$(database)/documents/kidsMedical/$(childId))
                                || getAfter(/databases/$(database)/documents/kidsMedical/$(childId)).data.groupId == request.resource.data.get('groupId', ''));
      allow delete: if false;
    }

    // ---- PARENTS' SUNDAY (Home, "This Sunday, for parents"; F-121, A-K1) --
    // A parent sees THEIR OWN family on their phone: the family's code (to
    // show at the door), their children's names and groups, and this
    // morning's check-ins with the collection code. Nothing else, nobody
    // else's. A parent is matched by the email on the registration form,
    // or the second parent's (Martin, N-6a and N-6c), to the email they
    // signed in with - and only if that sign-in email is VERIFIED, so nobody
    // can claim a family by typing its address. Signed in is enough: a
    // parent need not be in the address book (§21).
    function myVerifiedEmail() {
      return signedIn() && request.auth.token.get('email_verified', false) == true
             ? string(request.auth.token.get('email', '')).lower() : '';
    }
    function parentOfFamilyData(d) {
      let e = myVerifiedEmail();
      return e != '' && (d.get('email', '') == e || d.get('email2', '') == e);
    }
    function parentOf(familyId) {
      return familyId is string && familyId != ''
             && exists(/databases/$(database)/documents/kidsFamilies/$(familyId))
             && parentOfFamilyData(get(/databases/$(database)/documents/kidsFamilies/$(familyId)).data);
    }
    match /kidsFamilies/{familyId} {
      allow read: if parentOfFamilyData(resource.data);
    }
    match /kidsChildren/{childId} {
      allow read: if parentOf(resource.data.get('familyId', ''));
    }
    match /checkins/{checkinId} {
      allow read: if resource.data.get('kind', '') == 'child' && parentOf(resource.data.get('familyId', ''));
    }
    // A group's name and ages, for a parent's phone ("Little ones"). A group
    // holds no child, no name of a leader (member ids only) and nothing
    // medical.
    match /kidsGroups/{groupId} {
      allow read: if myVerifiedEmail() != '';
    }
    // One child's medical details, from the private half of their form.
    match /kidsMedical/{childId} {
      // ...and the rota's Session Leader, that morning, for the children
      // checked in that morning (Martin, F-094).
      allow read: if kidsLead(resource.data.siteId) || kidsGroupLeader(resource.data.get('groupId', ''))
                  || (kidsSessionLeaderNow(resource.data.siteId)
                      && exists(/databases/$(database)/documents/checkins/$('kids_' + resource.data.get('groupId', '') + '_' + kidsToday() + '__' + childId + '__0')));
      allow create, update: if kidsLead(request.resource.data.siteId) && (resource == null || kidsLead(resource.data.siteId))
                            && request.resource.data.keys().hasOnly(['siteId', 'groupId', 'allergies', 'medical', 'medication', 'needs', 'responseId', 'updatedAt', 'updatedBy'])
                            && request.resource.data.groupId == getAfter(/databases/$(database)/documents/kidsChildren/$(childId)).data.get('groupId', '');
      allow delete: if false;
    }

    // ---- the morning (Chunk 6, stage 3; Martin, F-094) -----------------
    //
    // A MORNING is one site on one day: kidsMornings/<site>_<YYYY-MM-DD>,
    // opened by a lead (the desk does it when a group meets that day). It
    // names everyone leading that morning - every group's leaders, and the
    // rota's Session Leader, checked here against the rota itself - and it
    // closes by itself (expiresAt, never more than 18 hours on).
    // While it is open:
    //   - everyone leading that morning sees the FIRE ROLL-CALL: each child
    //     checked in, their group and time in - a copy (kidsRoll) that holds
    //     nothing else: no medical details, no phone numbers, no code;
    //   - the Session Leader also sees the medical details of the children
    //     checked in that morning (kidsMedical, above), and nothing more.
    // Today is the UTC date: the same as the UK date except between
    // midnight and 1am in summer, when no group meets.
    function kidsToday() {
      let t = request.time;
      return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month()) + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    function kidsMorningPath(siteId) {
      return /databases/$(database)/documents/kidsMornings/$(siteId + '_' + kidsToday());
    }
    function kidsMorningOpen(siteId) {
      return active() && siteId is string && siteId != '' && exists(kidsMorningPath(siteId))
             && get(kidsMorningPath(siteId)).data.expiresAt > request.time;
    }
    function kidsMorningLeader(siteId) {
      return kidsMorningOpen(siteId)
             && (me().get('memberId', '-') in get(kidsMorningPath(siteId)).data.get('leaderIds', [])
                 || me().get('memberId', '-') in get(kidsMorningPath(siteId)).data.get('sessionLeaderIds', []));
    }
    function kidsSessionLeaderNow(siteId) {
      return kidsMorningOpen(siteId)
             && me().get('memberId', '-') in get(kidsMorningPath(siteId)).data.get('sessionLeaderIds', []);
    }
    // The Session Leader on a rota date (the rota keeps one person per role
    // as {id, name}).
    function rotaSessionLeader(rotaId) {
      let a = get(/databases/$(database)/documents/events/$(rotaId)).data.get('assignments', {}).get('Session Leader', null);
      return a is map ? a.get('id', '') : '';
    }
    match /kidsMornings/{morningId} {
      allow read: if kidsLead(resource.data.siteId)
                  || me().get('memberId', '-') in resource.data.get('leaderIds', [])
                  || me().get('memberId', '-') in resource.data.get('sessionLeaderIds', []);
      // A lead opens it, or (Martin, F-098) the rota's Session Leader for
      // that day, naming themselves: the rota check below proves it is them.
      allow create, update: if (kidsLead(request.resource.data.siteId)
                       || (active() && request.resource.data.day == kidsToday()
                           && exists(/databases/$(database)/documents/kidsSettings/$(request.resource.data.siteId))
                           && request.resource.data.get('sessionLeaderIds', []) == [me().get('memberId', '-')]))
                   && request.resource.data.keys().hasOnly(['siteId', 'day', 'rotaId', 'leaderIds', 'sessionLeaderIds', 'expiresAt', 'updatedAt', 'updatedBy'])
                   && request.resource.data.day is string
                   && morningId == request.resource.data.siteId + '_' + request.resource.data.day
                   && request.resource.data.leaderIds is list && request.resource.data.leaderIds.size() <= 500
                   && request.resource.data.expiresAt is timestamp
                   && request.resource.data.expiresAt <= request.time + duration.value(18, 'h')
                   && request.resource.data.sessionLeaderIds is list
                   && (request.resource.data.sessionLeaderIds.size() == 0
                       || (request.resource.data.sessionLeaderIds.size() == 1
                           && request.resource.data.rotaId is string && request.resource.data.rotaId != ''
                           && get(/databases/$(database)/documents/events/$(request.resource.data.rotaId)).data.get('date', '') == request.resource.data.day
                           && request.resource.data.sessionLeaderIds[0] == rotaSessionLeader(request.resource.data.rotaId)
                           && request.resource.data.sessionLeaderIds[0] != ''));
      allow delete: if false;
    }
    // The roll-call copy of a child's check-in: written in the same batch,
    // and it must say what the check-in says.
    match /kidsRoll/{checkinId} {
      allow read: if kidsLead(resource.data.siteId) || kidsGroupLeader(resource.data.get('groupId', ''))
                  || (kidsMorningLeader(resource.data.siteId) && resource.data.day == kidsToday());
      allow create, update: if kidsCkTeam(request.resource.data)
                   && request.resource.data.keys().hasOnly(['siteId', 'day', 'groupId', 'groupName', 'childId', 'name', 'state', 'inAt', 'outAt', 'roomId', 'updatedAt'])
                   && request.resource.data.siteId == getAfter(/databases/$(database)/documents/checkins/$(checkinId)).data.siteId
                   && request.resource.data.groupId == getAfter(/databases/$(database)/documents/checkins/$(checkinId)).data.groupId
                   && request.resource.data.childId == getAfter(/databases/$(database)/documents/checkins/$(checkinId)).data.signupKey
                   && request.resource.data.name == getAfter(/databases/$(database)/documents/checkins/$(checkinId)).data.name
                   && request.resource.data.day == getAfter(/databases/$(database)/documents/checkins/$(checkinId)).data.day
                   && request.resource.data.state == getAfter(/databases/$(database)/documents/checkins/$(checkinId)).data.state;
      allow delete: if false;
    }

    // ---- leaders checking themselves in on a Sunday (the app's Kids Church
    // "Today"; F-120) ------------------------------------------------------
    // One record per leader per site per day: kidsLeaderIns/<site>_<day>_<member>.
    // A leader checks only themselves in or out: a lead, a group's leader
    // (naming the group they are with), or anyone leading that morning.
    // Read by the leads and that morning's leaders (for "leaders" on Today
    // and the fire roll-call), and by the leader themselves. Never deleted.
    function leaderInShape(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['siteId', 'day', 'memberId', 'name', 'groupId', 'state', 'inAt', 'outAt'])
             && d.siteId is string && d.siteId != '' && d.day is string && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
             && d.memberId == me().get('memberId', '-')
             && id == d.siteId + '_' + d.day + '_' + d.memberId
             && d.name is string && d.name.size() > 0 && d.name.size() <= 120
             && d.get('groupId', '') is string
             && d.state in ['in', 'out'];
    }
    function mayLeadThere(d) {
      return kidsLead(d.siteId) || kidsMorningLeader(d.siteId)
             || (d.get('groupId', '') != '' && kidsGroupLeader(d.groupId)
                 && get(/databases/$(database)/documents/kidsGroups/$(d.groupId)).data.get('siteId', '') == d.siteId);
    }
    match /kidsLeaderIns/{id} {
      allow read: if kidsLead(resource.data.siteId)
                  || (kidsMorningLeader(resource.data.siteId) && resource.data.day == kidsToday())
                  || (active() && resource.data.memberId == me().get('memberId', '-'));
      allow create: if active() && leaderInShape(id) && request.resource.data.state == 'in'
                    && request.resource.data.inAt == request.time && mayLeadThere(request.resource.data);
      allow update: if active() && leaderInShape(id) && resource.data.memberId == me().get('memberId', '-')
                    && request.resource.data.siteId == resource.data.siteId && request.resource.data.day == resource.data.day
                    && ((request.resource.data.state == 'out' && request.resource.data.outAt == request.time)
                        || (request.resource.data.state == 'in' && request.resource.data.inAt == request.time));
      allow delete: if false;
    }

    // ---- term dates (Martin, F-098) -----------------------------------
    // Three terms a year, each with a start and an end, set by a lead; the
    // registers use them.
    function termOk(t) {
      return t is map && t.keys().hasOnly(['name', 'from', 'to'])
             && t.name is string && t.name.size() > 0 && t.name.size() <= 40
             && t.from is string && t.from.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
             && t.to is string && t.to.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && t.from <= t.to;
    }
    match /kidsTerms/{siteId} {
      allow read: if volunteer();
      allow write: if kidsLead(siteId)
                   && request.resource.data.keys().hasOnly(['terms', 'updatedAt', 'updatedBy'])
                   && request.resource.data.terms is list && request.resource.data.terms.size() == 3
                   && termOk(request.resource.data.terms[0]) && termOk(request.resource.data.terms[1]) && termOk(request.resource.data.terms[2])
                   && request.resource.data.terms[0].to < request.resource.data.terms[1].from
                   && request.resource.data.terms[1].to < request.resource.data.terms[2].from;
    }

    // ---- paging a parent on the screen, through ChurchShow (F-098) ------
    // One document per page, its id the child's check-in id, so paging the
    // same child again replaces it. THE CONTRACT ChurchShow reads is in
    // FINDINGS-events.md (F-100): { siteId, code, room, message, createdBy,
    // createdAt, clearedAt }. The code only, never a name: the message must
    // be exactly "<code>, please come to <group>", with the code from that
    // child's check-in and the group's own name.
    // Group leaders, the Session Leader and the leads page and clear;
    // anyone signed in reads a page that has not been cleared. ChurchShow
    // reads as the paired ChurchShow device, never a volunteer's account:
    // its clause (R6, F-111) is added here once the main window's
    // churchShow() helper exists. A page
    // older than five minutes counts as cleared (ChurchShow and the leader's
    // screen both treat it so; the leader's screen also writes clearedAt).
    function pageCk(pageId) {
      return get(/databases/$(database)/documents/checkins/$(pageId)).data;
    }
    function pageTeam(pageId) {
      return exists(/databases/$(database)/documents/checkins/$(pageId))
             && pageCk(pageId).get('kind', '') == 'child'
             && (kidsGroupLeader(pageCk(pageId).groupId) || kidsSessionLeaderNow(pageCk(pageId).siteId) || kidsLead(pageCk(pageId).siteId));
    }
    // Kids Church settings: "Allow showing a number on the service screen".
    // On unless the church has switched it off.
    function screenPagingOn(siteId) {
      return !exists(/databases/$(database)/documents/kidsSettings/$(siteId))
             || get(/databases/$(database)/documents/kidsSettings/$(siteId)).data.get('screenPaging', true) != false;
    }
    function pageShape(pageId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['siteId', 'code', 'room', 'message', 'createdBy', 'createdAt', 'clearedAt'])
             && d.siteId == pageCk(pageId).siteId
             // The screen number, never the collection code (Martin, 14 Oct 2026),
             // and only where the church allows screen numbers at all.
             && pageCk(pageId).get('screenNo', '').matches('[0-9]{3}')
             && d.code == pageCk(pageId).screenNo
             && screenPagingOn(pageCk(pageId).siteId)
             && d.room is string && d.room.size() <= 80
             && d.message == 'Screen number ' + d.code + ': please come to ' + get(/databases/$(database)/documents/kidsGroups/$(pageCk(pageId).groupId)).data.name
             && d.createdBy == request.auth.uid
             && d.createdAt == request.time
             && d.clearedAt == null;
    }
    match /screenPages/{pageId} {
      // R6 of FINDINGS-churchshow.md: the projection PC shows the code on the
      // service screen, so it reads its OWN site's pages and only while they
      // are uncleared. The events window wrote the five checks for this and
      // left the rule to the main window with churchShow(); it is here rather
      // than with the rest of CS2 because closing `events` in the same commit
      // is what takes the device's last open collection away.
      allow read: if (churchShow()
                      && resource.data.siteId == request.auth.token.siteId
                      && resource.data.clearedAt == null)
                  || (volunteer() && resource.data.clearedAt == null)
                  || (active() && resource.data.createdBy == request.auth.uid)
                  || kidsLead(resource.data.siteId);
      // A new page (or the same child paged again), for a child who is in.
      allow create: if pageTeam(pageId) && pageCk(pageId).state == 'in' && pageShape(pageId);
      allow update: if pageTeam(pageId)
                    && ((pageCk(pageId).state == 'in' && pageShape(pageId))
                        || (resource.data.clearedAt == null
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clearedAt'])
                            && request.resource.data.clearedAt == request.time));
      allow delete: if false;
    }

    // ---- small groups (Chunk 7, stage 1; EVENTS-BOOKINGS-BRIEF §6.15) ----
    //
    //   - GROUPS ADMINS: master admins, and the admins of the teams a master
    //     admin names in groupsSettings/main. They add groups and choose
    //     their leaders.
    //   - A GROUP'S LEADERS (smallGroups.leaderIds, member ids) edit its
    //     details (not its leaders, nor whether it is public), add and
    //     remove its members, and accept or decline requests to join it.
    //   - THE PUBLIC sees public groups that are running; members see all.
    //     A home group's address and an online link are smallGroupPrivate:
    //     the group's members, its leaders and the groups admins only.
    //   - Who is in a group: the group, its leaders, the groups admins - and
    //     each person their own places.
    // A group's memberCount moves by one with each member added or taken
    // out, in the same write, and never past its limit.
    function groupsAdmin() {
      return isMaster()
             || (active() && exists(/databases/$(database)/documents/groupsSettings/main)
                 && me().get('adminFor', []).hasAny(get(/databases/$(database)/documents/groupsSettings/main).data.get('teams', [])));
    }
    function sgDoc(groupId) { return get(/databases/$(database)/documents/smallGroups/$(groupId)).data; }
    function groupLeader(groupId) {
      return active() && groupId is string && groupId != '' && exists(/databases/$(database)/documents/smallGroups/$(groupId))
             && me().get('memberId', '-') in sgDoc(groupId).get('leaderIds', []);
    }
    function groupMember(groupId) {
      return active() && groupId is string && groupId != ''
             && exists(/databases/$(database)/documents/smallGroupMembers/$(groupId + '__a_' + me().get('memberId', '-')));
    }
    function groupShape() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
             && d.get('visibility', 'public') in ['public', 'members', 'churchMembers', 'team']
             && groupAudienceAgrees()
             && d.get('locationKind', 'home') in ['home', 'room', 'venue', 'online']
             && d.get('leaderIds', []) is list && d.get('leaderIds', []).size() <= 500
             && d.get('capacity', 0) is int && d.get('capacity', 0) >= 0 && d.get('capacity', 0) <= 500
             && d.get('memberCount', 0) is int && d.get('memberCount', 0) >= 0
             && d.get('open', true) is bool && d.get('active', true) is bool
             && d.get('description', '') is string && d.get('description', '').size() <= 2000
             // The address and the link to join belong in smallGroupPrivate, never on the public card.
             && !d.keys().hasAny(['address', 'meetingLink', 'postcode']);
    }
    // UNDER-18s GROUPS (Martin, F-109). A leader may be named only with an
    // in-date DBS check and safeguarding training (leaderChecks, against the
    // years in Safeguarding settings, 3 if unset), or an exception recorded
    // with a reason by a master admin or the safeguarding lead
    // (smallGroupExceptions/<group>__<member>). Checked for every leader when
    // a group is made, or first marked under-18s (at most three leaders
    // then), and for the one leader added on each later change (the page
    // names them in lastLeaderAdded).
    function yearsAgo(n) {
      let t = request.time;
      return string(t.year() - n) + '-' + (t.month() < 10 ? '0' : '') + string(t.month()) + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    function sgYears(field) {
      return exists(/databases/$(database)/documents/safeguardingSettings/defaults)
             ? get(/databases/$(database)/documents/safeguardingSettings/defaults).data.get(field, 3) : 3;
    }
    function checksInDate(memberId) {
      return exists(/databases/$(database)/documents/leaderChecks/$(memberId))
             && get(/databases/$(database)/documents/leaderChecks/$(memberId)).data.get('dbsStatus', '') == 'current'
             && get(/databases/$(database)/documents/leaderChecks/$(memberId)).data.get('dbsSeen', '') >= yearsAgo(sgYears('dbsYears'))
             && get(/databases/$(database)/documents/leaderChecks/$(memberId)).data.get('trainingDate', '') >= yearsAgo(sgYears('trainingYears'));
    }
    function leaderCleared(groupId, memberId) {
      return memberId is string && memberId != ''
             && (checksInDate(memberId) || exists(/databases/$(database)/documents/smallGroupExceptions/$(groupId + '__' + memberId)));
    }
    function allCleared(groupId, ids) {
      return ids.size() <= 3
             && (ids.size() < 1 || leaderCleared(groupId, ids[0]))
             && (ids.size() < 2 || leaderCleared(groupId, ids[1]))
             && (ids.size() < 3 || leaderCleared(groupId, ids[2]));
    }
    function under18Ok(groupId) {
      let d = request.resource.data;
      let after = d.get('leaderIds', []);
      return d.get('under18', false) != true
             || ((resource == null || resource.data.get('under18', false) != true) && allCleared(groupId, after))
             || (resource != null && resource.data.get('under18', false) == true
                 && (after.toSet().difference(resource.data.get('leaderIds', []).toSet()).size() == 0
                     || (after.toSet().difference(resource.data.get('leaderIds', []).toSet()).size() == 1
                         && after.toSet().difference(resource.data.get('leaderIds', []).toSet()).hasOnly([d.get('lastLeaderAdded', '')])
                         && leaderCleared(groupId, d.get('lastLeaderAdded', '')))));
    }
    match /smallGroupExceptions/{key} {
      allow read: if groupsAdmin() || isMaster() || sgLeadOf(resource.data.get('siteId', '')) || groupLeader(resource.data.groupId)
                  || (active() && resource.data.memberId == me().get('memberId', '-'));
      allow create, update: if (isMaster() || sgLeadOf(request.resource.data.get('siteId', '')))
                   && request.resource.data.keys().hasOnly(['groupId', 'memberId', 'name', 'reason', 'siteId', 'by', 'byName', 'at'])
                   && key == request.resource.data.groupId + '__' + request.resource.data.memberId
                   && request.resource.data.reason is string && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 1000
                   && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if isMaster() || sgLeadOf(resource.data.get('siteId', ''));
    }
    function memberKeyOf(groupId, personKind, personId) {
      return groupId + '__' + (personKind == 'contacts' ? 'c' : 'a') + '_' + personId;
    }
    // A group's canCome must say what its "Who can come" says.
    function groupAudienceAgrees() {
      let d = request.resource.data;
      let v = d.get('visibility', 'public');
      let a = d.get('canCome', []);
      return (v == 'public' && a.hasAll(['public', 'members']) && a.size() == 2)
             || (v == 'members' && a == ['members'])
             || (v == 'churchMembers' && a == ['churchMembers'])
             || (v == 'team' && d.get('teams', []) is list && d.get('teams', []).size() > 0 && d.get('teams', []).size() <= 500 && a == d.get('teams', []));
    }
    // The count moves with a member added or taken out, named in lastMemberKey.
    function groupCountOk(groupId) {
      let b = resource.data.get('memberCount', 0);
      let a = request.resource.data.get('memberCount', 0);
      let k = request.resource.data.get('lastMemberKey', '');
      return a == b
             || (a == b + 1 && k is string && k.matches(groupId + '__.*')
                 && existsAfter(/databases/$(database)/documents/smallGroupMembers/$(k))
                 && !exists(/databases/$(database)/documents/smallGroupMembers/$(k))
                 && (request.resource.data.get('capacity', 0) == 0 || a <= request.resource.data.get('capacity', 0)))
             || (a == b - 1 && k is string && k.matches(groupId + '__.*')
                 && !existsAfter(/databases/$(database)/documents/smallGroupMembers/$(k))
                 && exists(/databases/$(database)/documents/smallGroupMembers/$(k)));
    }
    match /groupsSettings/{id} {
      allow read: if active();
      allow write: if isMaster() && request.resource.data.get('teams', []) is list && request.resource.data.get('teams', []).size() <= 500;
    }
    match /smallGroups/{groupId} {
      // Who can come (§21): the public read public groups that are running;
      // signed in, a group is read by those it is for, and always by its
      // leaders, its members and the groups admins.
      allow read: if (resource.data.get('visibility', 'public') == 'public' && resource.data.get('active', true) == true)
                  || audienceOk(resource.data.get('canCome', []))
                  || groupsAdmin()
                  || (active() && me().get('memberId', '-') in resource.data.get('leaderIds', []))
                  || groupMember(groupId);
      allow create: if groupsAdmin() && groupShape() && request.resource.data.get('memberCount', 0) == 0 && under18Ok(groupId);
      allow update: if groupShape() && groupCountOk(groupId) && under18Ok(groupId)
                    && (groupsAdmin()
                        || (groupLeader(groupId)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'type', 'description', 'day', 'time', 'frequency', 'frequencyNote',
                                 'locationKind', 'siteId', 'roomId', 'area', 'venueName', 'audience', 'open', 'capacity', 'memberCount', 'lastMemberKey', 'image', 'updatedAt', 'updatedBy']))
                        // A member leaving takes themselves off the count (stage 2).
                        || (groupMember(groupId)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'lastMemberKey'])
                            && request.resource.data.get('lastMemberKey', '') == groupId + '__a_' + me().get('memberId', '-')
                            && request.resource.data.get('memberCount', 0) == resource.data.get('memberCount', 0) - 1));
      allow delete: if false;
    }
    match /smallGroupPrivate/{groupId} {
      allow read: if groupsAdmin() || groupLeader(groupId) || groupMember(groupId);
      allow write: if (groupsAdmin() || groupLeader(groupId))
                   && request.resource.data.keys().hasOnly(['address', 'meetingLink', 'notes', 'updatedAt', 'updatedBy'])
                   && request.resource.data.get('address', '').size() <= 300 && request.resource.data.get('meetingLink', '').size() <= 300;
    }
    match /smallGroupMembers/{key} {
      allow read: if groupsAdmin() || groupLeader(resource.data.groupId) || groupMember(resource.data.groupId)
                  || (active() && resource.data.personKind == 'addressBook' && resource.data.personId == me().get('memberId', '-'));
      allow create: if (groupsAdmin() || groupLeader(request.resource.data.groupId))
                    && request.resource.data.keys().hasOnly(['groupId', 'personKind', 'personId', 'name', 'email', 'phone', 'joinedAt', 'addedBy'])
                    && request.resource.data.personKind in ['addressBook', 'contacts']
                    && key == memberKeyOf(request.resource.data.groupId, request.resource.data.personKind, request.resource.data.personId)
                    && existsAfter(/databases/$(database)/documents/$(request.resource.data.personKind)/$(request.resource.data.personId))
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && getAfter(/databases/$(database)/documents/smallGroups/$(request.resource.data.groupId)).data.get('memberCount', 0)
                         == sgDoc(request.resource.data.groupId).get('memberCount', 0) + 1;
      allow delete: if (groupsAdmin() || groupLeader(resource.data.groupId)
                        || (active() && resource.data.personKind == 'addressBook' && resource.data.personId == me().get('memberId', '-')))
                    && getAfter(/databases/$(database)/documents/smallGroups/$(resource.data.groupId)).data.get('memberCount', 0)
                         == sgDoc(resource.data.groupId).get('memberCount', 0) - 1;
      allow update: if false;
    }
    // ---- small groups, stage 2: meetings, the register, messages ----
    // A meeting is one group on one date: its notes or study plan, and
    // whether it is off. The group's members read them. Who came (the
    // register) is the leaders' and the groups admins' only. Messages sent
    // to the group are kept, and the group's members may read them.
    function groupRunner(groupId) { return groupsAdmin() || groupLeader(groupId); }
    function meetingIdOk(id, d) {
      return d.groupId is string && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && id == d.groupId + '__' + d.date;
    }
    match /smallGroupMeetings/{meetingId} {
      allow read: if groupRunner(resource.data.groupId) || groupMember(resource.data.groupId);
      allow write: if groupRunner(request.resource.data.groupId) && meetingIdOk(meetingId, request.resource.data)
                   && request.resource.data.keys().hasOnly(['groupId', 'date', 'time', 'cancelled', 'notes', 'updatedAt', 'updatedBy'])
                   && request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 4000
                   && request.resource.data.get('cancelled', false) is bool
                   && (resource == null || resource.data.groupId == request.resource.data.groupId);
      allow delete: if false;
    }
    match /smallGroupAttendance/{meetingId} {
      allow read: if groupRunner(resource.data.groupId);
      allow write: if groupRunner(request.resource.data.groupId) && meetingIdOk(meetingId, request.resource.data)
                   && request.resource.data.keys().hasOnly(['groupId', 'date', 'present', 'guests', 'count', 'updatedAt', 'updatedBy'])
                   && request.resource.data.present is list && request.resource.data.present.size() <= 200
                   && request.resource.data.get('guests', 0) is int && request.resource.data.get('guests', 0) >= 0
                   && request.resource.data.count == request.resource.data.present.size() + request.resource.data.get('guests', 0)
                   && (resource == null || resource.data.groupId == request.resource.data.groupId);
      allow delete: if false;
    }
    match /smallGroupMessages/{messageId} {
      allow read: if groupRunner(resource.data.groupId) || groupMember(resource.data.groupId);
      allow create: if groupRunner(request.resource.data.groupId)
                    && request.resource.data.keys().hasOnly(['groupId', 'subject', 'body', 'sentBy', 'sentByName', 'sentAt', 'recipients'])
                    && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 200
                    && request.resource.data.body is string && request.resource.data.body.size() <= 10000
                    && request.resource.data.sentBy == request.auth.uid && request.resource.data.sentAt == request.time
                    && request.resource.data.recipients is int;
      allow update, delete: if false;
    }

    // Anyone may ask to join a public group that is running, open and not
    // full (members-only groups: signed-in members). A member asks as
    // themselves; a guest as the contact written in the same batch.
    match /smallGroupRequests/{requestId} {
      allow read: if groupsAdmin() || groupLeader(resource.data.groupId);
      allow create: if request.resource.data.keys().hasOnly(['groupId', 'groupName', 'name', 'email', 'phone', 'message', 'personKind', 'personId', 'status', 'createdAt'])
                    && request.resource.data.groupId is string && exists(/databases/$(database)/documents/smallGroups/$(request.resource.data.groupId))
                    && sgDoc(request.resource.data.groupId).get('active', true) == true
                    && sgDoc(request.resource.data.groupId).get('open', true) == true
                    && (sgDoc(request.resource.data.groupId).get('capacity', 0) == 0
                        || sgDoc(request.resource.data.groupId).get('memberCount', 0) < sgDoc(request.resource.data.groupId).get('capacity', 0))
                    && (sgDoc(request.resource.data.groupId).get('visibility', 'public') == 'public'
                        || audienceOk(sgDoc(request.resource.data.groupId).get('canCome', [])))
                    && request.resource.data.status == 'asked' && request.resource.data.createdAt == request.time
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string && request.resource.data.email.size() <= 200
                    && request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').size() <= 40
                    && request.resource.data.get('message', '') is string && request.resource.data.get('message', '').size() <= 1000
                    && ((request.resource.data.personKind == 'addressBook' && active() && request.resource.data.personId == me().get('memberId', '-'))
                        || (request.resource.data.personKind == 'contacts'
                            && existsAfter(/databases/$(database)/documents/contacts/$(request.resource.data.personId))));
      allow update: if (groupsAdmin() || groupLeader(resource.data.groupId))
                    && resource.data.status == 'asked' && request.resource.data.status in ['accepted', 'declined']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy'])
                    && request.resource.data.decidedAt == request.time && request.resource.data.decidedBy == request.auth.uid
                    && (request.resource.data.status == 'declined'
                        || existsAfter(/databases/$(database)/documents/smallGroupMembers/$(memberKeyOf(resource.data.groupId, resource.data.personKind, resource.data.personId))));
      allow delete: if false;
    }

    // ---- MAINTENANCE JOBS (the phone app's Maintenance space; F-123) -----
    // Anyone signed in reports a job: what, where, and one optional photo.
    // Everyone signed in sees the list (so nobody reports it twice). The
    // Maintenance team and the office (admins, and the bookings admins of
    // the job's site) mark it done or open it again. The photo is the
    // Maintenance team's and the office's only (Martin, A-M1): its file is
    // guarded in storage.rules; here only its path is kept. Never deleted.
    // The buildings job (H-9; EGBC: Maintenance).
    function maintTeam() {
      return active() && teamsCovered().hasAny(raJobTeams('buildings', ['Maintenance']));
    }
    function maintOffice(siteId) {
      return isAdmin() || bookingsAdminOf(siteId);
    }
    function maintShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['siteId', 'roomId', 'where', 'what', 'details', 'photoPath', 'status',
                               'reportedBy', 'reportedByName', 'reportedAt', 'doneBy', 'doneByName', 'doneAt', 'doneNote',
                               'checkId', 'safety', 'due', 'ownerId'])
             // Building compliance (Martin, 19 Oct): a follow-up on a check IS a
             // job - its check, the safety tick, a due date and who owns it.
             && d.get('checkId', '') is string && d.get('checkId', '').size() <= 160
             && d.get('safety', false) is bool
             && d.get('due', '') is string && (d.get('due', '') == '' || d.get('due', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
             && d.get('ownerId', '') is string && d.get('ownerId', '').size() <= 80
             && d.siteId is string && d.roomId is string
             && d.where is string && d.where.size() <= 120
             && d.what is string && d.what.size() > 0 && d.what.size() <= 200
             && d.get('details', '') is string && d.get('details', '').size() <= 2000
             && d.get('photoPath', '') is string && d.get('photoPath', '').size() <= 300
             && d.status in ['todo', 'done']
             && d.get('doneNote', '') is string && d.get('doneNote', '').size() <= 500;
    }
    match /maintJobs/{jobId} {
      allow read: if active();
      allow create: if active() && maintShape() && request.resource.data.status == 'todo'
                    && request.resource.data.reportedBy == request.auth.uid && request.resource.data.reportedAt == request.time
                    && request.resource.data.get('photoPath', '') in ['', 'maintJobs/' + jobId + '/photo']
                    && !request.resource.data.keys().hasAny(['doneBy', 'doneAt'])
                    // tied to a check: only the compliance admins or the check's own people
                    && (request.resource.data.get('checkId', '') == ''
                        || (exists(/databases/$(database)/documents/buildingChecks/$(request.resource.data.checkId))
                            && cmpCheck(request.resource.data.checkId).siteId == request.resource.data.siteId
                            && (cmpAdmin() || cmpAssigned(cmpCheck(request.resource.data.checkId)))));
      allow update: if maintShape()
                    && request.resource.data.reportedBy == resource.data.reportedBy && request.resource.data.reportedAt == resource.data.reportedAt
                    && (
                      // The person who reported it may add the photo, or correct it, while it is to do.
                      (resource.data.status == 'todo' && request.resource.data.status == 'todo' && resource.data.reportedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['what', 'details', 'where', 'roomId', 'siteId', 'photoPath'])
                        && request.resource.data.get('photoPath', '') in ['', 'maintJobs/' + jobId + '/photo'])
                      // The compliance admins: the safety tick, the due date and the owner.
                      || (cmpAdmin() && resource.data.status == 'todo'
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['safety', 'due', 'ownerId']))
                      // The Maintenance team or the office: done (in their name, now), or open again.
                      || ((maintTeam() || maintOffice(resource.data.siteId))
                          && ((resource.data.status == 'todo' && request.resource.data.status == 'done'
                               && request.resource.data.doneBy == request.auth.uid && request.resource.data.doneAt == request.time
                               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneBy', 'doneByName', 'doneAt', 'doneNote']))
                              || (resource.data.status == 'done' && request.resource.data.status == 'todo'
                                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneNote']))))
                    );
      allow delete: if false;
    }

    // ---- CLOSE A ROOM (the Maintenance space's "Rooms"; F-123, F-135) --
    // The Maintenance team or the room's office (admins, the site's
    // bookings admins) closes a room for some days, with a reason (Martin,
    // A-M2: the room disappears from Book a room on those days).
    //   roomClosures/<id>: the closure - room, days, reason, who, and
    //     whether it has been lifted. Anyone in the address book reads it.
    //   roomClosedDays/<room>_<day>: one marker a day, read by anyone (the
    //     public booking page needs it). It says only "closed", never why.
    // The booking rules above read the marker: closed means not free.
    // A marker is set on only for a day its closure names, while the
    // closure is on, and set off only by lifting the closure it belongs to.
    // Nothing is deleted. Bookings already made are not touched: the office
    // decides, and warns the people booked from Room bookings.
    function mayClose(siteId) {
      return maintTeam() || theOffice(siteId);
    }
    function closureShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['siteId', 'roomId', 'roomName', 'from', 'to', 'days', 'reason', 'status',
                               'by', 'byName', 'at', 'liftedBy', 'liftedByName', 'liftedAt', 'warnedAt', 'warnedBy', 'warnedCount', 'partIds', 'wholeIds'])
             && d.siteId is string && d.roomId is string && roomData(d.roomId).siteId == d.siteId
             && d.get('partIds', []) is list && d.get('partIds', []).size() <= 4
             // the rooms it is part of, closed with it
             && d.get('wholeIds', []) is list && d.get('wholeIds', []).size() <= 20
             && d.roomName is string && d.roomName.size() <= 120
             && d.from is string && d.from.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && d.to is string && d.to.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.to >= d.from
             && d.days is list && d.days.size() >= 1 && d.days.size() <= 31
             && d.days[0] == d.from && d.days[d.days.size() - 1] == d.to
             && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 300
             && d.status in ['on', 'lifted'];
    }
    match /roomClosures/{id} {
      allow read: if active();
      allow create: if mayClose(request.resource.data.siteId) && closureShape() && request.resource.data.status == 'on'
                    && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
                    && !request.resource.data.keys().hasAny(['liftedBy', 'liftedAt', 'warnedAt']);
      allow update: if closureShape() && (
                      // Lifted, by whoever may close the room, in their name, now.
                      (mayClose(resource.data.siteId) && resource.data.status == 'on' && request.resource.data.status == 'lifted'
                       && request.resource.data.liftedBy == request.auth.uid && request.resource.data.liftedAt == request.time
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'liftedBy', 'liftedByName', 'liftedAt']))
                      // The office records that it warned the people booked.
                      || (theOffice(resource.data.siteId) && request.resource.data.warnedBy == request.auth.uid && request.resource.data.warnedAt == request.time
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['warnedAt', 'warnedBy', 'warnedCount'])));
      allow delete: if false;
    }
    match /roomClosedDays/{dayId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['closureId', 'roomId', 'siteId', 'day', 'on'])
                    && dayId == request.resource.data.roomId + '_' + request.resource.data.day
                    && mayClose(request.resource.data.siteId)
                    && request.resource.data.closureId is string
                    && (
                      (request.resource.data.on == true
                       && getAfter(/databases/$(database)/documents/roomClosures/$(request.resource.data.closureId)).data.status == 'on'
                       && (getAfter(/databases/$(database)/documents/roomClosures/$(request.resource.data.closureId)).data.roomId == request.resource.data.roomId
                           || request.resource.data.roomId in getAfter(/databases/$(database)/documents/roomClosures/$(request.resource.data.closureId)).data.get('partIds', [])
                           || request.resource.data.roomId in getAfter(/databases/$(database)/documents/roomClosures/$(request.resource.data.closureId)).data.get('wholeIds', []))
                       && getAfter(/databases/$(database)/documents/roomClosures/$(request.resource.data.closureId)).data.siteId == request.resource.data.siteId
                       && request.resource.data.day in getAfter(/databases/$(database)/documents/roomClosures/$(request.resource.data.closureId)).data.days)
                      || (request.resource.data.on == false && resource != null && resource.data.siteId == request.resource.data.siteId
                          && resource.data.closureId == request.resource.data.closureId
                          && getAfter(/databases/$(database)/documents/roomClosures/$(request.resource.data.closureId)).data.status == 'lifted')
                    );
      allow delete: if false;
    }

    // ---- SERMONS (the phone app's "Listen"; F-124, F-132, F-138) -------
    // MARTIN'S OPTION 3: Val keeps uploading to Spotify for Creators. The
    // hub READS that show's public feed: the function sermonFeedSync
    // (codebase "hub", F-138) writes one sermon per episode, its id made
    // from the episode's guid (egbc-sermons-feed.js), so a second read
    // never makes a second copy. It writes with the Admin SDK, so these
    // rules never see it - and NO PAGE MAY CREATE A FEED EPISODE.
    // A feed episode's own fields (title, date, words, audio) are the
    // feed's. The hub adds only the series, the Bible book and passage,
    // the speaker, and whether it is shown; the function never touches
    // those. The upload page stays as a backup: an uploaded sermon is the
    // hub's own (source 'upload'), with its audio in Storage.
    // A sermon is public once shown; until then only the sermon admins see
    // it. WHO: master admins, and the people a master admin names in
    // sermonShow/access (a "Sermons" tick in the address book replaces
    // that once the main window adds it, F-137). Nothing is deleted.
    function sermonAdmin() {
      return isMaster()
             || (active() && exists(/databases/$(database)/documents/sermonShow/access)
                 && me().get('memberId', '-') in get(/databases/$(database)/documents/sermonShow/access).data.get('memberIds', []));
    }
    function sermonShape(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'speaker', 'date', 'seriesId', 'book', 'passage', 'description', 'audioPath', 'audioType',
                               'audioSize', 'durationSec', 'audioUrl', 'imageUrl', 'published', 'guid', 'source', 'pubDate', 'feedSeenAt',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
             && d.title is string && d.title.size() > 0 && d.title.size() <= 200
             && d.speaker is string && d.speaker.size() <= 120
             && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
             && d.seriesId is string && d.book is string && d.book.size() <= 40
             && d.passage is string && d.passage.size() <= 120
             && d.get('description', '') is string && d.get('description', '').size() <= 4000
             && d.audioPath in ['', 'sermons/' + id + '/audio']
             && d.audioSize is int && d.audioSize >= 0 && d.durationSec is int && d.durationSec >= 0
             && d.published is bool && d.source in ['feed', 'upload']
             && d.guid is string && d.guid.size() > 0 && d.guid.size() <= 1000
             && d.get('audioUrl', '') is string && d.get('audioUrl', '').size() <= 1000
             // Shown means listenable: an upload's audio is up and measured;
             // a feed episode has the feed's own address.
             && (!d.published
                 || (d.source == 'upload' && d.audioPath != '' && d.audioSize > 0 && d.durationSec > 0)
                 || (d.source == 'feed' && d.get('audioUrl', '').matches('^https?://.+')))
             && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    match /sermons/{id} {
      allow read: if resource.data.published == true || sermonAdmin();
      // Only an upload, from a page: its own episode id, no feed address.
      allow create: if sermonAdmin() && sermonShape(id) && request.resource.data.source == 'upload'
                    && request.resource.data.guid == 'egbc-sermon-' + id
                    && request.resource.data.get('audioUrl', '') == ''
                    && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if sermonAdmin() && sermonShape(id)
                    && request.resource.data.guid == resource.data.guid
                    && request.resource.data.source == resource.data.source
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (resource.data.source == 'upload'
                        || request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['speaker', 'seriesId', 'book', 'passage', 'published', 'updatedAt', 'updatedBy']));
      allow delete: if false;
    }
    match /sermonSeries/{id} {
      allow read: if true;
      allow create, update: if sermonAdmin()
                    && request.resource.data.keys().hasOnly(['name', 'description', 'artworkPath', 'order', 'updatedAt', 'updatedBy'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && request.resource.data.get('description', '') is string && request.resource.data.get('description', '').size() <= 2000
                    && request.resource.data.get('artworkPath', '') in ['', 'sermonSeries/' + id + '/artwork']
                    && request.resource.data.get('order', 0) is int
                    && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    // The feed's address (from Val's Spotify for Creators settings), set by
    // the sermon admins; the function reads it. And what the last read
    // found, which only the function writes.
    match /sermonShow/feed {
      allow read: if active();
      allow write: if sermonAdmin()
                   && request.resource.data.keys().hasOnly(['url', 'updatedAt', 'updatedBy'])
                   && request.resource.data.url is string && request.resource.data.url.size() <= 500
                   && (request.resource.data.url == '' || request.resource.data.url.matches('^https://[^ ]+$'))
                   && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }
    match /sermonShow/feedStatus {
      allow read: if active();
      allow write: if false;
    }
    match /sermonShow/access {
      allow read: if active();
      allow write: if isMaster()
                   && request.resource.data.keys().hasOnly(['memberIds', 'updatedAt', 'updatedBy'])
                   && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 50;
    }
    // Each listener's place in each sermon, so "Carry on listening" works on
    // any phone. Theirs alone.
    match /listenProgress/{uid}/sermons/{sermonId} {
      allow read: if active() && request.auth.uid == uid;
      allow create, update: if active() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['pos', 'dur', 'done', 'at'])
                    && request.resource.data.pos is number && request.resource.data.pos >= 0
                    && request.resource.data.dur is number && request.resource.data.dur >= 0
                    && request.resource.data.done is bool && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // ---- PHONE NOTIFICATIONS (NEXT-BRIEF §23; FINDINGS-notify N-2; F-144) --
    // pushTokens/<uid>_<hash>: one per person per phone. A person adds,
    //   refreshes and removes ONLY THEIR OWN. NOBODY READS THEM, not even
    //   the person: only the sending function (Admin SDK) does. Signed in is
    //   enough: a parent not in the address book may still be called to
    //   collect their child (Martin, N-6b).
    // notifyPrefs/<uid>: a person's own switches and quiet hours.
    // notifyLog: what was sent, when, by whom, and to how many phones (never
    //   a token). Written by the function only; read by master admins, the
    //   site's safeguarding lead and its Kids Church leads.
    match /pushTokens/{id} {
      allow read: if false;
      allow create, update: if signedIn() && id.matches(request.auth.uid + '_[A-Za-z0-9_-]{8,64}')
                    && request.resource.data.keys().hasOnly(['uid', 'token', 'platform', 'createdAt', 'lastSeen'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.token is string && request.resource.data.token.size() >= 20 && request.resource.data.token.size() <= 4096
                    && request.resource.data.platform in ['android', 'iphone', 'desktop', 'other']
                    && request.resource.data.lastSeen == request.time
                    && (resource == null
                        ? request.resource.data.createdAt == request.time
                        : (resource.data.uid == request.auth.uid && request.resource.data.createdAt == resource.data.createdAt));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /notifyPrefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['types', 'quietFrom', 'quietTo', 'updatedAt'])
                    && request.resource.data.types is map && request.resource.data.types.size() <= 20
                    && request.resource.data.quietFrom is string && request.resource.data.quietFrom.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
                    && request.resource.data.quietTo is string && request.resource.data.quietTo.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
                    && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /notifyLog/{id} {
      allow read: if isMaster() || sgLeadOf(resource.data.get('siteId', '')) || kidsLead(resource.data.get('siteId', ''));
      allow write: if false;
    }

    // ---- Watch (NEXT-BRIEF §24 item 5; F-163) ----------------------------
    // "Listen & Watch": the church's YouTube channel (videos/yt_<id>, read
    // from YouTube's public feed by the hub function only), members-only
    // full services (videos/mv_<id>, unlisted links the office adds), and the
    // weekly live link (watchShow/live). Looked after by the people who look
    // after sermons (sermonAdmin). THE LIVE LINK AND THE MEMBERS' VIDEOS ARE
    // NEVER READABLE SIGNED OUT: nothing here is a public page or feed.
    function watchYoutube(u) {
      return u is string && u.size() <= 300 && u.matches('^https://(www[.]|m[.])?(youtube[.]com|youtu[.]be)/[^ ]+$');
    }
    function watchVideoId(v) { return v is string && v.matches('^[A-Za-z0-9_-]{11}$'); }
    function watchMs(t) { return t is int && t > 0; }
    match /videos/{id} {
      // The channel's own videos are public on YouTube already; the members'
      // are for those signed in (or, if the office says so, church members).
      allow read: if resource.data.source == 'feed'
                  || (resource.data.source == 'members' && sermonAdmin())
                  || (resource.data.source == 'members'
                      && ((resource.data.get('audience', 'signedIn') == 'signedIn' && active())
                          || (resource.data.get('audience', '') == 'churchMembers' && (isChurchMember() || sermonAdmin()))));
      allow create, update: if sermonAdmin() && id == 'mv_' + request.resource.data.videoId
                    && request.resource.data.keys().hasOnly(['source', 'videoId', 'url', 'title', 'date', 'audience', 'note', 'hidden', 'addedBy', 'addedAt', 'updatedAt'])
                    && request.resource.data.source == 'members' && watchVideoId(request.resource.data.videoId) && watchYoutube(request.resource.data.url)
                    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
                    && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.audience in ['signedIn', 'churchMembers']
                    && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 500
                    && request.resource.data.get('hidden', false) is bool
                    && request.resource.data.updatedAt == request.time;
      // On a channel video the office may only hide or show it: the feed owns the rest.
      allow update: if sermonAdmin() && resource.data.source == 'feed'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
                    && request.resource.data.hidden is bool;
      allow delete: if sermonAdmin() && resource.data.source == 'members';
    }
    match /watchShow/{id} {
      allow read: if active() && id in ['settings', 'live', 'feedStatus'];
      // The church's choices: its channel, and the live card's defaults.
      allow write: if sermonAdmin() && id == 'settings'
                   && request.resource.data.keys().hasOnly(['channelId', 'untilDay', 'fromTime', 'untilTime', 'after', 'againDays', 'updatedAt', 'updatedBy'])
                   && (request.resource.data.channelId == '' || request.resource.data.channelId.matches('^UC[A-Za-z0-9_-]{22}$'))
                   && request.resource.data.untilDay is int && request.resource.data.untilDay >= 0 && request.resource.data.untilDay <= 6
                   && request.resource.data.untilTime is string && request.resource.data.untilTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
                   && request.resource.data.get('fromTime', '00:00') is string && request.resource.data.get('fromTime', '00:00').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
                   && request.resource.data.get('fromTime', '00:00') < request.resource.data.untilTime
                   && request.resource.data.after in ['disappear', 'again']
                   && request.resource.data.againDays is int && request.resource.data.againDays >= 1 && request.resource.data.againDays <= 31
                   && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      // This week's live link, or none (url ''). Watch again ends after the card does.
      allow write: if sermonAdmin() && id == 'live'
                   && request.resource.data.keys().hasOnly(['url', 'videoId', 'title', 'showFrom', 'showUntil', 'after', 'againUntil', 'updatedAt', 'updatedBy'])
                   && (request.resource.data.url == ''
                       || (watchYoutube(request.resource.data.url) && watchVideoId(request.resource.data.videoId)
                           && watchMs(request.resource.data.showFrom) && watchMs(request.resource.data.showUntil)
                           && request.resource.data.showUntil > request.resource.data.showFrom
                           && request.resource.data.after in ['disappear', 'again']
                           && (request.resource.data.after == 'disappear' || (watchMs(request.resource.data.againUntil) && request.resource.data.againUntil > request.resource.data.showUntil))))
                   && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 120
                   && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      // feedStatus: written by the hub function only.
    }

    // ---- Prayer requests and answers to prayer (NEXT-BRIEF §24 item 11; F-166)
    // A request is PRIVATE: read by the person who asked, the Pastoral group
    // (onPastoral(), the same as "I'm worried"), and - only if the person
    // chose it - the church's prayer team, a team named in prayerSettings/main
    // (a church may have none). Nobody else, not even a master admin.
    // Only the person who asked may mark it answered or take it back.
    // An answer to prayer is shared with everyone signed in only when the
    // person chooses, with their name only if they choose; the Pastoral group
    // may hide one.
    function prayerTeamName() {
      return exists(/databases/$(database)/documents/prayerSettings/main)
             ? get(/databases/$(database)/documents/prayerSettings/main).data.get('prayerTeam', '') : '';
    }
    function onPrayerTeam() { return prayerTeamName() != '' && onTeam(prayerTeamName()); }
    match /prayers/{id} {
      allow create: if active()
                    && request.resource.data.keys().hasOnly(['by', 'byName', 'text', 'share', 'sunday', 'at', 'answered', 'answer', 'answeredAt'])
                    && request.resource.data.by == request.auth.uid
                    // Sunday (Martin, 15 Oct): prayed for in the service only if the
                    // person says yes, with or without their name. Missing means no.
                    && request.resource.data.get('sunday', 'no') in ['no', 'named', 'anon']
                    && request.resource.data.byName is string && request.resource.data.byName.size() <= 120
                    && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 4000
                    && request.resource.data.share in ['pastoral', 'prayerTeam']
                    && request.resource.data.at == request.time
                    && request.resource.data.answered == false && request.resource.data.answer == ''
                    // F-178: with no safeguarding lead set, a request could reach nobody.
                    && sgLeadSet();
      // F-178: the people Who gets told names for prayer (careRouting/main),
      // and the safeguarding lead and deputy, are told of a request (the
      // server's prayerNotify), so they may read it too.
      allow read: if active() && (resource.data.by == request.auth.uid || onPastoral()
                                  || (resource.data.share == 'prayerTeam' && onPrayerTeam())
                                  || careNamed('prayer') || sgLeadOrDeputy());
      allow update: if active() && resource.data.by == request.auth.uid
                    && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answered', 'answer', 'answeredAt'])
                         && request.resource.data.answered is bool
                         && request.resource.data.answer is string && request.resource.data.answer.size() <= 2000
                         && request.resource.data.answeredAt == request.time)
                        // the person changes their mind about Sunday; nobody else may
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sunday'])
                            && request.resource.data.sunday in ['no', 'named', 'anon']));
      allow delete: if active() && resource.data.by == request.auth.uid;
    }
    match /prayerAnswers/{id} {
      allow read: if active() && (resource.data.hidden == false || onPastoral() || resource.data.by == request.auth.uid);
      allow create: if active()
                    && request.resource.data.keys().hasOnly(['by', 'byName', 'text', 'at', 'hidden'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.byName is string && request.resource.data.byName.size() <= 120
                    && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 2000
                    && request.resource.data.at == request.time && request.resource.data.hidden == false;
      allow update: if onPastoral() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
                    && request.resource.data.hidden is bool;
      allow delete: if active() && resource.data.by == request.auth.uid;
    }
    match /prayerSettings/{id} {
      allow read: if active();
      allow write: if isMaster() && id == 'main'
                   && request.resource.data.keys().hasOnly(['prayerTeam', 'updatedAt', 'updatedBy'])
                   && request.resource.data.prayerTeam is string && request.resource.data.prayerTeam.size() <= 60
                   && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }

    // ---- "I'm new here" (NEXT-BRIEF §24 item 12; F-167) ------------------
    // A visitor - usually NOT signed in - says hello. Anyone may send one, of
    // exactly this shape; nothing else can be written, and a sender cannot
    // read it back (or anyone's). Read only by the people the church chose
    // (welcomeSettings/main.memberIds) and master admins, who may mark one
    // contacted. The email address hellos are copied to is chosen by the
    // church and is the one public setting (welcomeSettings/public).
    function welcomer() {
      return active() && exists(/databases/$(database)/documents/welcomeSettings/main)
             && me().get('memberId', '-') in get(/databases/$(database)/documents/welcomeSettings/main).data.get('memberIds', []);
    }
    match /welcomes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'contactMe', 'uid', 'at', 'status'])
                    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string && request.resource.data.email.size() <= 200
                    && (request.resource.data.email == '' || request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
                    && request.resource.data.message is string && request.resource.data.message.size() <= 2000
                    && request.resource.data.contactMe is bool
                    // Asking to be contacted needs a way to be contacted.
                    && (request.resource.data.contactMe == false || request.resource.data.email != '' || request.resource.data.phone != '')
                    && request.resource.data.uid == (request.auth == null ? '' : request.auth.uid)
                    && request.resource.data.at == request.time && request.resource.data.status == 'new';
      allow read: if isMaster() || welcomer();
      allow update: if (isMaster() || welcomer())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledBy', 'handledAt'])
                    && request.resource.data.status in ['new', 'contacted']
                    && request.resource.data.handledBy == request.auth.uid && request.resource.data.handledAt == request.time;
      // Removing one (a visitor asking to be forgotten) is a master admin's.
      allow delete: if isMaster();
    }
    match /welcomeSettings/{id} {
      allow read: if id == 'public' || (id == 'main' && (isMaster() || welcomer()));
      allow write: if isMaster() && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
                   && ((id == 'main' && request.resource.data.keys().hasOnly(['memberIds', 'updatedAt', 'updatedBy'])
                        && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 500)
                       || (id == 'public' && request.resource.data.keys().hasOnly(['notifyEmail', 'updatedAt', 'updatedBy'])
                           && request.resource.data.notifyEmail is string && request.resource.data.notifyEmail.size() <= 200
                           && (request.resource.data.notifyEmail == '' || request.resource.data.notifyEmail.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))));
    }

    // ---- Gift Aid declarations (NEXT-BRIEF §24 item 6; F-169) ------------
    // SENSITIVE: a name, a home address and a tax status. Read by the person
    // (their own) and by the office and the treasurer - master admins, the
    // Church office group and the Finance group - and nobody else.
    // EACH DECLARATION IS ITS OWN RECORD AND IS NEVER DELETED: HMRC expects
    // them kept. Cancelling marks it, from a date, and cannot be undone;
    // declaring again makes a new one. What was declared, when, how and by
    // whom never changes; only the person's name and address can be kept up
    // to date (HMRC asks people to tell the church when they change).
    function giftAidOffice() { return raOffice() || onMoneyTeam(); }
    function gaName(d) {
      return d.title in ['', 'Mr', 'Mrs', 'Miss', 'Ms', 'Mx', 'Dr', 'Rev']
             && d.firstName is string && d.firstName.size() >= 1 && d.firstName.size() <= 60
             && d.lastName is string && d.lastName.size() >= 1 && d.lastName.size() <= 60
             && d.house is string && d.house.size() >= 1 && d.house.size() <= 60
             && d.address is string && d.address.size() <= 200
             && d.postcode is string && d.postcode.matches('^[A-Z]{1,2}[0-9][A-Z0-9]? ?[0-9][A-Z]{2}$');
    }
    match /giftAid/{id} {
      allow read: if (active() && resource.data.memberId == me().get('memberId', '-')) || giftAidOffice();
      allow create: if active()
                    && request.resource.data.keys().hasOnly(['memberId', 'title', 'firstName', 'lastName', 'house', 'address', 'postcode', 'source', 'taxpayer', 'wording',
                                                             'declaredOn', 'declaredAt', 'paperHeld', 'cancelled', 'cancelledOn', 'recordedBy', 'updatedAt', 'updatedBy'])
                    && gaName(request.resource.data)
                    && request.resource.data.taxpayer == true
                    && request.resource.data.declaredOn is string && request.resource.data.declaredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.declaredAt == request.time
                    && request.resource.data.cancelled == false && request.resource.data.cancelledOn == ''
                    && request.resource.data.recordedBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
                    && request.resource.data.wording is string && request.resource.data.wording.size() <= 1000
                    // In the app: only for yourself, with the words you agreed to.
                    && ((request.resource.data.source == 'app' && request.resource.data.memberId == me().get('memberId', '-')
                         && request.resource.data.paperHeld == false && request.resource.data.wording.size() > 50)
                        // On paper: the office, for someone, with the paper held.
                        || (request.resource.data.source == 'paper' && giftAidOffice() && request.resource.data.paperHeld == true
                            && request.resource.data.memberId is string && request.resource.data.memberId.size() > 0));
      allow update: if ((active() && resource.data.memberId == me().get('memberId', '-')) || giftAidOffice())
                    && resource.data.cancelled == false
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'firstName', 'lastName', 'house', 'address', 'postcode',
                                                                                       'cancelled', 'cancelledOn', 'updatedAt', 'updatedBy'])
                    && gaName(request.resource.data)
                    && (request.resource.data.cancelled == false
                        || (request.resource.data.cancelled == true && request.resource.data.cancelledOn is string
                            && request.resource.data.cancelledOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
                    && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---- the ChurchSuite import's record of what it made (F-177) --------
    // A readable name for each booking it made ("cs_<name>_<date>_<room>")
    // and the booking's own random key. A booking's key lets anyone read
    // the booking, so this list of them is for admins only, and only the
    // tool (with the Admin SDK) writes it.
    match /importKeys/{importKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- deleted events: what, when, and who deleted them (F-180) -------
    // ChurchSuite's "deleted events" report. Written by events-admin just
    // before it deletes a series; only an admin may write one, in their own
    // name and at the server's time; nobody may change or remove one.
    match /calEventsDeleted/{delId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['title', 'startUtc', 'endUtc', 'seriesId', 'count', 'byUid', 'byName', 'at'])
                    && request.resource.data.title is string && request.resource.data.title.size() <= 300
                    && request.resource.data.startUtc is number && request.resource.data.get('endUtc', 0) is number
                    && request.resource.data.get('seriesId', '') is string
                    && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 1000
                    && request.resource.data.byUid == request.auth.uid
                    && request.resource.data.byName is string && request.resource.data.byName.size() <= 200
                    && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ---- the church's own event categories (F-180) ----------------------
    // A name, a colour, an order and "retired". Anyone may read them: the
    // public What's on shows an event's category. Admins write them. None
    // is ever deleted - retired instead - so no event loses its category.
    function categoryShape() {
      return request.resource.data.keys().hasOnly(['name', 'colour', 'order', 'retired'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.colour is string && request.resource.data.colour.matches('#[0-9a-f]{6}')
          && request.resource.data.order is int && request.resource.data.order >= 0 && request.resource.data.order <= 500
          && request.resource.data.retired is bool;
    }
    match /eventCategories/{catId} {
      allow read: if true;
      allow create, update: if isAdmin() && catId.matches('[a-z0-9-]{1,40}') && categoryShape();
      allow delete: if false;
    }

    // ---- paid on the day (F-183) ------------------------------------------
    // One per sign-up, under the sign-up's own key: paid or not, how much and
    // how. Written by an admin or the event's leaders at the door, for a
    // sign-up that really is for that event. Read by the key-holder (the
    // person's own "my place" page, by its unguessable key) and listed by
    // admins and the event's leaders. Never deleted: "not paid" is a change.
    function paymentShape(manageKey) {
      return request.resource.data.keys().hasOnly(['calEventId', 'paid', 'amount', 'method', 'by', 'byName', 'at'])
          && request.resource.data.calEventId is string
          && exists(/databases/$(database)/documents/signups/$(manageKey))
          && get(/databases/$(database)/documents/signups/$(manageKey)).data.calEventId == request.resource.data.calEventId
          && request.resource.data.paid is bool
          && request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 100000
          && request.resource.data.method in ['cash', 'card', 'bank', 'other', '']
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 120
          && request.resource.data.at == request.time;
    }
    match /signupPayments/{manageKey} {
      allow get: if true;
      allow list: if runsEventId(resource.data.calEventId) || isEventLeader(resource.data.calEventId);
      allow create, update: if (runsEventId(request.resource.data.calEventId) || isEventLeader(request.resource.data.calEventId)) && paymentShape(manageKey)
                            && (resource == null || resource.data.calEventId == request.resource.data.calEventId);
      allow delete: if false;
    }

    // ---- taking money: each church's own Stripe account (F-181) ----------
    // The keys: NOBODY. Only the server's functions (the Admin SDK) read
    // them; a key goes in once, through paymentsSave, and never comes out.
    match /paymentSecrets/{id} {
      allow read, write: if false;
    }
    // Which events were already acted on: the server's own record.
    match /paymentEvents/{id} {
      allow read, write: if false;
    }
    // What a page may know. 'public' (can card payments be taken at all) is
    // for everyone; the account's name, live or test, and who added it are
    // for admins and the church's money team. Written by the server only.
    // The finance job (H-9): the teams churchSettings/teamJobs gives it;
    // nothing stored, the money team the payments page names; nothing
    // there, EGBC's Finance.
    function financeTeams() {
      return raJobTeams('finance', [exists(/databases/$(database)/documents/paymentSettings/team)
          ? get(/databases/$(database)/documents/paymentSettings/team).data.get('team', 'Finance') : 'Finance']);
    }
    function onMoneyTeam() {
      return active() && teamsCovered().hasAny(financeTeams());
    }
    match /paymentSettings/{id} {
      allow read: if id == 'public' || isAdmin() || onMoneyTeam();
      allow write: if false;
    }

    // ---- checklist reminders (R11) -----------------------------------------
    // Which reminders the morning job has sent: its own record, nobody else's.
    match /checklistReminders/{id} {
      allow read, write: if false;
    }

    // ---- the What's on calendar feed (R7, F-182) -------------------------
    // A person's own feed key: the server makes it (myEventsFeed) and reads
    // it (eventsFeed). No page reads or writes one.
    match /eventFeeds/{key} {
      allow read, write: if false;
    }

    // ---- regular giving by Direct Debit (F-181, GoCardless) ---------------
    // A giver's regular gift, under an unguessable key that is in their own
    // link: they read theirs by it. The treasurer and the office (the same
    // people who see Gift Aid, giftAidOffice) list them, and the gifts
    // collected. Everything is written by the server only.
    match /regularGifts/{giftKey} {
      allow get: if true;
      allow list: if giftAidOffice();
      allow write: if false;
    }
    match /donations/{donationId} {
      allow read: if giftAidOffice();
      allow write: if false;
    }

    // ---- invitations (F-187) ----------------------------------------------
    // One per person invited, under an unguessable key that is in their
    // email's links. An admin sends them and sees them all. The person, by
    // the key, may read theirs and answer it - yes or no, at the server's
    // time, and the sign-up it led to - and change nothing else.
    match /eventInvites/{inviteKey} {
      allow get: if true;
      allow list: if runsEventId(resource.data.calEventId);
      allow create: if runsEventId(request.resource.data.calEventId)
                    && request.resource.data.keys().hasOnly(['calEventId', 'memberId', 'name', 'email', 'sentAt', 'by', 'byName', 'response', 'respondedAt', 'signupKey', 'reminded'])
                    && request.resource.data.calEventId is string && request.resource.data.email is string && request.resource.data.email.size() <= 200
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.by == request.auth.uid && request.resource.data.sentAt == request.time
                    && request.resource.data.response == '' && request.resource.data.signupKey == '';
      allow update: if (runsEventId(resource.data.calEventId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reminded']))
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response', 'respondedAt', 'signupKey'])
                        && request.resource.data.response in ['yes', 'no']
                        && request.resource.data.respondedAt == request.time
                        && request.resource.data.signupKey is string && request.resource.data.signupKey.size() <= 40);
      allow delete: if runsEventId(resource.data.calEventId);
    }

    // ---- label size (F-185) ----------------------------------------------
    // One for the whole church: children's labels and events' name labels.
    // Anyone who prints labels (a volunteer, or an event's leader) reads it;
    // an admin chooses it.
    match /labelSettings/{id} {
      allow read: if active();
      allow write: if isAdmin() && id == 'main'
                   && request.resource.data.keys().hasOnly(['format', 'updatedAt', 'updatedBy'])
                   && request.resource.data.format in ['paper', 'brother62x29', 'brother62x100', 'dymo89x36', 'a4x21', 'a4x8']
                   && request.resource.data.updatedBy == request.auth.uid;
    }

    // ---- the whole series (F-184) -----------------------------------------
    // One per sign-up in a whole-series booking, under that sign-up's own
    // key, listing every key in the booking (so one email, and "cancel all").
    // Made only in the same write as its own sign-up, by whoever is making
    // that sign-up: the sign-up must be new in this write, and match. Read by
    // the key-holder; listed by admins; never changed.
    match /seriesSignups/{signupKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['seriesId', 'keys', 'calEventIds', 'email', 'createdAt'])
                    && request.resource.data.keys is list && request.resource.data.keys.size() >= 2 && request.resource.data.keys.size() <= 60
                    && signupKey in request.resource.data.keys
                    && request.resource.data.calEventIds is list && request.resource.data.calEventIds.size() == request.resource.data.keys.size()
                    && request.resource.data.seriesId is string && request.resource.data.email is string
                    && !exists(/databases/$(database)/documents/signups/$(signupKey))
                    && existsAfter(/databases/$(database)/documents/signups/$(signupKey))
                    && getAfter(/databases/$(database)/documents/signups/$(signupKey)).data.email == request.resource.data.email
                    && getAfter(/databases/$(database)/documents/signups/$(signupKey)).data.calEventId in request.resource.data.calEventIds;
      allow update, delete: if false;
    }

    // ---- the picture library (Martin, 14 Oct 2026) ----------------------
    // One shared store of pictures, each with a name and tags. Events point
    // to a picture (calEvents.imageLibId) rather than copying it. Anyone
    // signed in who can edit events may read the library; admins add,
    // rename, replace and delete. A name, tags, a web address, a size: no
    // personal data.
    function pictureShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'tags', 'url', 'path', 'width', 'height', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
             && d.name is string && d.name.size() > 0 && d.name.size() <= 80
             && d.tags is list && d.tags.size() <= 12
             && d.url is string && d.url.size() <= 2000
             && d.path is string && d.path.matches('library/[^/]+/[^/]+')
             && d.updatedBy == request.auth.uid;
    }
    match /pictureLibrary/{picId} {
      allow read: if active();
      allow create: if isAdmin() && pictureShape() && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.path.matches('library/' + picId + '/[^/]+');
      allow update: if isAdmin() && pictureShape()
                    && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.path.matches('library/' + picId + '/[^/]+');
      allow delete: if isAdmin();
    }
    // "My usual people" (usualPeople; Martin, 15 Oct): the names a person has
    // taken off their own "same as last time" list. Theirs alone: nobody
    // else reads or writes it, an admin included. The names themselves come
    // from the person's own sign-ups (the signups list rule above).
    match /signupUsual/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['hidden', 'updatedAt'])
                            && request.resource.data.hidden is list && request.resource.data.hidden.size() <= 200;
    }
    // Sending as a team (teamMail; R9, F-208): each team's address, leads and
    // deputies, and who the Pastor and the office admin are. Master admins
    // read them on the settings page; only the hub's functions write them
    // (teamMailSave checks the master admin), and only the functions decide
    // who may send (sendAsTeam). Nothing here for a page to change.
    match /teamMailboxes/{id} {
      allow read: if isMaster();
      allow write: if false;
    }
    match /teamMailSettings/{id} {
      allow read: if isMaster() && id == 'main';
      // The Pastor reads it too, so the Preaching plan knows them: member
      // ids only (the Pastor and the office admin).
      allow read: if id == 'main' && active() && me().get('memberId', '') != ''
                  && resource.data.get('pastor', '') == me().get('memberId', '');
      allow write: if false;
    }

    // ---- THE FIRE ROLL-CALL (F-214; Martin, 15 Oct) --------------------
    // Named people - fire wardens, the duty steward - and master admins see
    // who is checked in at today's events: names and how many. A master
    // admin names them (adults), each for every building or one building.
    // ONE RECORD FOR EACH BUILDING (H&S step 3a; F-280: "they have three
    // buildings"): fireRollCall/<siteId> = { siteId, people: [{ memberId,
    // name, role }], memberIds, stewards, updatedBy... }, and fireRollCall/all
    // (siteId '') for the people named for every building. Each holds up to
    // 500 (the H-9 bound for a list), so more buildings means more room.
    // Set by master admins and the office job (raOffice). The old single
    // record, fireRollCall/main, is split by tools/migrate-fire-rollcall.mjs
    // when these rules go live; after that only a master admin reads it.
    function fireNamed(id) {
      return exists(/databases/$(database)/documents/fireRollCall/$(id))
             && me().get('memberId', '') in get(/databases/$(database)/documents/fireRollCall/$(id)).data.get('memberIds', []);
    }
    function fireWarden(buildingId) {
      return active() && (fireNamed('all')
                          || (buildingId is string && buildingId != '' && buildingId != 'all' && buildingId != 'main' && fireNamed(buildingId)));
    }
    function fireRollShape(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['siteId', 'people', 'memberIds', 'stewards', 'updatedBy', 'updatedByName', 'updatedAt'])
             && (id == 'all' ? d.siteId == '' : (d.siteId == id && exists(/databases/$(database)/documents/sites/$(id))))
             && d.people is list && d.people.size() <= 500
             && d.memberIds is list && d.memberIds.size() == d.people.size()
             && d.stewards is list && d.stewards.size() <= d.people.size()
             && d.updatedBy == request.auth.uid
             && d.get('updatedByName', '') is string && d.get('updatedByName', '').size() <= 200
             && d.get('updatedAt', '') is string;
    }
    // A building's fire safety lead sets that building's list too (Martin, 27 Oct; that building only, never "all").
    function fireLeadOf(id) {
      return id != 'all' && active() && me().get('memberId', '') != '' && raRoles(id).get('fireLead', '-') == me().get('memberId', '');
    }
    match /fireRollCall/{id} {
      allow read: if isMaster()
                  || (id != 'main' && (raOffice() || fireLeadOf(id) || (active() && me().get('memberId', '') in resource.data.get('memberIds', []))));
      allow create, update: if id != 'main' && (raOffice() || fireLeadOf(id)) && fireRollShape(id);
      allow delete: if false;   // emptied, never deleted
    }
    // Children's counts for the fire roll-call (F-216; Martin, 15 Oct):
    // numbers only, per group, kept by the kidsCountsKeep function from
    // kidsRoll. A warden reads their own building's; the names stay in
    // kidsRoll, for Kids Church leaders.
    match /kidsCounts/{id} {
      allow read: if isMaster() || kidsLead(resource.data.siteId) || fireWarden(resource.data.siteId);
      allow write: if false;
    }
    // FOR SUNDAY (F-222; Martin, 16 Oct): the prayer list for the service,
    // kept by prayerSundayDaily/OnPrayer/OnRota - only the requests marked
    // yes, a name only where asked. The Pastor (teamMailSettings/main.pastor,
    // the one setting team mail uses) reads every Sunday's; that Sunday's
    // service leader reads that one, from the Wednesday before until the
    // Sunday ends. Neither may read prayers itself (that rule is unchanged).
    // THE CHURCH'S OVERALL LEADERS: the teams on churchSettings/teamJobs
    // "leadership" (FINDINGS-churchhq H-9), EGBC's Elders where the church
    // has not said. Their own teams only: the job covers nothing.
    function isLeadership() {
      return active() && me().get('teams', []).hasAny(
        exists(/databases/$(database)/documents/churchSettings/teamJobs)
          ? get(/databases/$(database)/documents/churchSettings/teamJobs).data.get('leadership', ['Elders'])
          : ['Elders']);
    }
    function isPastor() {
      return active() && me().get('memberId', '') != ''
             && exists(/databases/$(database)/documents/teamMailSettings/main)
             && get(/databases/$(database)/documents/teamMailSettings/main).data.get('pastor', '') == me().get('memberId', '');
    }
    // THE SESSION PLANNER (F-223, F-225; Martin, 16 Oct). A group (Kids
    // Church, Lazers, Youth, the preaching team) is set up by a master
    // admin. Every one of its leaders edits every plan of the group (Samy
    // writes it, Karen picks it up); its team reads them; nobody else.
    function planGroup(gid) {
      return get(/databases/$(database)/documents/planGroups/$(gid)).data;
    }
    function leadsPlanGroup(gid) {
      return active() && gid is string && gid != ''
             && exists(/databases/$(database)/documents/planGroups/$(gid))
             && me().get('memberId', '-') in planGroup(gid).get('leaderIds', []);
    }
    /* Master admins edit any group's plans too (Martin, 19 Oct), without
       being leaders - so without the plan emails, which go to leaders. */
    function editsPlanGroup(gid) {
      return leadsPlanGroup(gid)
             || (isMaster() && gid is string && gid != '' && exists(/databases/$(database)/documents/planGroups/$(gid)));
    }
    function readsPlanGroup(gid) {
      return isMaster() || leadsPlanGroup(gid)
             || (active() && gid is string && gid != ''
                 && exists(/databases/$(database)/documents/planGroups/$(gid))
                 && planGroup(gid).get('teamName', '-') in teamsCovered());
    }
    match /planGroups/{gid} {
      allow read: if isMaster()
                  || (active() && (me().get('memberId', '-') in resource.data.get('leaderIds', [])
                                   || resource.data.get('teamName', '-') in teamsCovered()));
      allow write: if isMaster()
                   && request.resource.data.keys().hasOnly(['name', 'kind', 'ageFrom', 'ageTo', 'day', 'time', 'siteId', 'leaderIds', 'teamName', 'emails', 'programmes', 'parts', 'order', 'archived', 'updatedBy', 'updatedAt'])
                   && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
                   && request.resource.data.kind in ['children', 'youth', 'sermon', 'other']
                   && request.resource.data.leaderIds is list && request.resource.data.leaderIds.size() <= 500;
      allow delete: if isMaster();
    }
    function planSessionShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['groupId', 'date', 'special', 'title', 'programme', 'lessonCode', 'lessonLink', 'passage', 'onIds', 'awayIds', 'parts', 'speakerId', 'speaker', 'eventId', 'series', 'rotaAt', 'updatedBy', 'updatedByName', 'updatedAt', 'createdAt'])
             && d.groupId is string && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && d.get('title', '') is string && d.get('title', '').size() <= 120
             && d.get('parts', []) is list && d.get('parts', []).size() <= 40
             && d.updatedBy == request.auth.uid;
    }
    match /planSessions/{sid} {
      allow read: if readsPlanGroup(resource.data.groupId);
      allow create: if editsPlanGroup(request.resource.data.groupId) && planSessionShape();
      allow update: if editsPlanGroup(resource.data.groupId)
                    && ((planSessionShape() && request.resource.data.groupId == resource.data.groupId)
                        // the live rota's who's on / away, brought up to date by a
                        // leader's visit: those alone, not "Last changed by"
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onIds', 'awayIds', 'rotaAt'])
                            && request.resource.data.onIds is list && request.resource.data.onIds.size() <= 500
                            && request.resource.data.awayIds is list && request.resource.data.awayIds.size() <= 500));
      allow delete: if editsPlanGroup(resource.data.groupId);
    }
    // SERMON PLANS, the other way (F-229): what the Preaching plan shows of a
    // sermon plan - its title, series and passage, and where it is - kept by
    // the sermonLinkKeep function from planSessions. Read by any volunteer,
    // as the rota is; never the outline or the notes.
    match /sermonLinks/{eventId} {
      allow read: if volunteer();
      allow write: if false;
    }
    // The church's API.Bible key (F-225): the bible.js functions only.
    match /privateSettings/{id} {
      allow read, write: if false;
    }
    match /prayerSundayList/{sunday} {
      allow read: if isPastor()
                  || (active() && me().get('memberId', '') in resource.data.get('leaderMemberIds', [])
                      && request.time >= resource.data.from && request.time <= resource.data.until);
      allow write: if false;
    }

    // ---- BUILDING COMPLIANCE (Stage 2; F-230, F-231, F-232) -----------------
    // Who (Martin, 19 Oct):
    //   compliance admins  master admins and the Church office: set up the
    //                      buildings, edit the church's copies of the checks
    //   trustees           the Elders and master admins: see everything
    //   assigned people    a check's responsibleIds (e.g. Val): see and record
    //                      only theirs - never the others
    // History is never changed or deleted: records and the log are append only.
    // A LEGAL REQUIREMENT IS A FLOOR (F-232): never less often than the law,
    // never switched off; a recommended standard is lengthened only with a
    // reason. The same test as egbc-compliance.js allowEvery().
    // ---- HEALTH, SAFETY AND FIRE: THE CHURCH'S SETTINGS (H&S step 2; F-280 section 8) ----
    // A JOB, NOT A TEAM (H-9): the teams churchSettings/teamJobs gives a
    // job, or - nothing stored for it - EGBC's team, egbc-team-jobs.js's
    // default (the same answer as EGBCTeamJobs.teamsFor). [] is nobody.
    function raJobTeams(job, egbcTeams) {
      let p = /databases/$(database)/documents/churchSettings/teamJobs;
      return exists(p) && job in get(p).data ? get(p).data[job] : egbcTeams;
    }
    function raOnJob(job, egbcTeams) { return active() && myTeams().hasAny(raJobTeams(job, egbcTeams)); }
    // Who sets them: master admins and the office job (the church's settings).
    function raOffice() { return isMaster() || raOnJob('office', ['Church office']); }
    // A whole number from lo, no limit but what a record holds (H-9).
    function raWhole(d, k, lo) { return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= 1000000000); }
    function raSmall(m, k, lo, hi) { return !(k in m) || (m[k] is int && m[k] >= lo && m[k] <= hi); }
    // raSettings/church: how many the church employs (the duties follow,
    // egbc-hs-core.js), screen work, a larger staff team, the insurance
    // cover, the H&S AI caps (0-500, separate from safeguarding's), the
    // action target dates (months), when an event needs an assessment.
    // Anyone signed in reads it (counts and amounts, no names).
    match /raSettings/{id} {
      allow read: if active();
      allow write: if raOffice() && id == 'church'
                   && request.resource.data.keys().hasOnly(['employees', 'screenWork', 'largerTeam', 'publicLiability', 'employersLiability', 'minCover', 'ai', 'targets', 'eventPeople', 'hireRaTypes', 'updatedAt', 'updatedBy'])
                   // the kinds of booking whose hirers must send their own risk assessment (answer 6; H&S step 5)
                   && request.resource.data.get('hireRaTypes', []) is list && request.resource.data.get('hireRaTypes', []).size() <= 500
                   && raWhole(request.resource.data, 'employees', 0) && raWhole(request.resource.data, 'largerTeam', 1)
                   && raWhole(request.resource.data, 'publicLiability', 0) && raWhole(request.resource.data, 'employersLiability', 0)
                   && raWhole(request.resource.data, 'minCover', 1) && raWhole(request.resource.data, 'eventPeople', 1)
                   && request.resource.data.get('screenWork', false) is bool
                   && request.resource.data.get('ai', {}) is map && request.resource.data.get('ai', {}).keys().hasOnly(['perChurch', 'perPerson'])
                   && raSmall(request.resource.data.get('ai', {}), 'perChurch', 0, 500) && raSmall(request.resource.data.get('ai', {}), 'perPerson', 0, 500)
                   && request.resource.data.get('targets', {}) is map && request.resource.data.get('targets', {}).keys().hasOnly(['high', 'medium', 'low'])
                   && raSmall(request.resource.data.get('targets', {}), 'high', 1, 120) && raSmall(request.resource.data.get('targets', {}), 'medium', 1, 120)
                   && raSmall(request.resource.data.get('targets', {}), 'low', 1, 120);
      allow delete: if false;
    }
    // raSiteRoles/{siteId}: each building's health and safety lead and
    // deputy (two different people) and its fire safety lead (who may be the
    // lead): member ids, '' for nobody. Names come from the address book, so
    // a name is never stored beside someone else's id (F-287's lesson).
    match /raSiteRoles/{siteId} {
      allow read: if active();
      allow write: if raOffice()
                   && exists(/databases/$(database)/documents/sites/$(siteId))
                   && request.resource.data.keys().hasOnly(['siteId', 'hsLead', 'hsDeputy', 'fireLead', 'updatedAt', 'updatedBy'])
                   && request.resource.data.siteId == siteId
                   && request.resource.data.get('hsLead', '') is string && request.resource.data.get('hsLead', '').size() <= 128
                   && request.resource.data.get('hsDeputy', '') is string && request.resource.data.get('hsDeputy', '').size() <= 128
                   && request.resource.data.get('fireLead', '') is string && request.resource.data.get('fireLead', '').size() <= 128
                   && (request.resource.data.get('hsLead', '') == '' || request.resource.data.get('hsLead', '') != request.resource.data.get('hsDeputy', ''));
      allow delete: if false;
    }

    // ---- WORKING ALONE (job 3; functions/lone-working.js; lone.html) ----
    // Someone signs in at a building with the time they expect to leave,
    // and signs out when they go: the building and the times only, never
    // where they are. They see their own; the building's contacts (its
    // list, and always its H&S lead and deputy) and the office see that
    // building's. The server tells people when someone doesn't sign out;
    // a contact marks them safe. Never deleted here: the server deletes
    // closed ones after 30 days.
    function loneContactOf(siteId) {
      let c = /databases/$(database)/documents/loneContacts/$(siteId);
      let r = /databases/$(database)/documents/raSiteRoles/$(siteId);
      let mid = me().get('memberId', '-');
      return active() && (raOffice()
             || (mid != '' && exists(c) && mid in get(c).data.get('contacts', []))
             || (mid != '' && exists(r) && (get(r).data.get('hsLead', '') == mid || get(r).data.get('hsDeputy', '') == mid)));
    }
    function loneTimeOk(t) {
      return t is timestamp && t > request.time && t <= request.time + duration.value(12, 'h');
    }
    match /loneVisits/{id} {
      allow read: if active() && (resource.data.uid == request.auth.uid || loneContactOf(resource.data.siteId));
      allow create: if active()
                    && request.resource.data.keys().hasOnly(['uid', 'memberId', 'name', 'phone', 'siteId', 'siteName', 'inAt', 'expectOut', 'status'])
                    && request.resource.data.uid == request.auth.uid && request.resource.data.memberId == me().get('memberId', '')
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
                    && request.resource.data.siteId is string && exists(/databases/$(database)/documents/sites/$(request.resource.data.siteId))
                    && request.resource.data.siteName is string && request.resource.data.siteName.size() <= 120
                    && request.resource.data.status == 'in' && request.resource.data.inAt == request.time
                    && loneTimeOk(request.resource.data.expectOut);
      allow update: if active() && resource.data.status in ['in', 'due', 'late', 'escalated'] && (
                      // the person: "I've left"
                      (resource.data.uid == request.auth.uid && request.resource.data.status == 'out' && request.resource.data.outAt == request.time
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'outAt']))
                      // the person: "I need longer" (20 times at most), from now
                      || (resource.data.uid == request.auth.uid && request.resource.data.status == 'in' && loneTimeOk(request.resource.data.expectOut)
                          && request.resource.data.extended == resource.data.get('extended', 0) + 1 && request.resource.data.extended <= 20
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expectOut', 'extended']))
                      // a contact or the office: "They're safe", with who and a short note
                      || (loneContactOf(resource.data.siteId) && request.resource.data.status == 'resolved'
                          && request.resource.data.resolvedBy == request.auth.uid && request.resource.data.resolvedAt == request.time
                          && request.resource.data.resolvedByName is string && request.resource.data.resolvedByName.size() <= 120
                          && request.resource.data.resolvedNote is string && request.resource.data.resolvedNote.size() <= 300
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedByName', 'resolvedAt', 'resolvedNote'])));
      allow delete: if false;
    }
    // each building's contacts (member ids, 10 at most), and the church's times
    match /loneContacts/{siteId} {
      allow read: if active();
      allow write: if raOffice() && exists(/databases/$(database)/documents/sites/$(siteId))
                   && request.resource.data.keys().hasOnly(['contacts', 'updatedAt', 'updatedBy'])
                   && request.resource.data.contacts is list && request.resource.data.contacts.size() <= 10
                   && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    // ---- DRIVERS AND VEHICLES (job 4; egbc-transport.js; transport.html) ----
    // A driver's record is the minimum the checks need (no licence number,
    // date of birth, address or points) and only the people the church names
    // (transportSettings/main.readers) and master admins read or write it.
    // driverOk is what everyone else sees: a name and the dates they are
    // cleared until. Vehicles aren't personal; anyone signed in records a
    // walk-round check before driving.
    function transportReader() {
      let s = /databases/$(database)/documents/transportSettings/main;
      return active() && (isMaster() || (exists(s) && me().get('memberId', '-') in get(s).data.get('readers', [])));
    }
    function trDay(v) { return v is string && (v == '' || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    match /transportSettings/{id} {
      allow read: if active();
      allow write: if raOffice() && id == 'main'
                   && request.resource.data.keys().hasOnly(['readers', 'midas', 'recheckMonths', 'updatedAt', 'updatedBy'])
                   && request.resource.data.readers is list && request.resource.data.readers.size() <= 20
                   && request.resource.data.midas is bool
                   && request.resource.data.recheckMonths is int && request.resource.data.recheckMonths >= 6 && request.resource.data.recheckMonths <= 36
                   && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /drivers/{memberId} {
      allow read: if transportReader();
      allow write: if transportReader()
                   && request.resource.data.keys().hasOnly(['memberId', 'name', 'licence', 'insurance', 'minibus', 'midas', 'active', 'updatedAt', 'updatedBy', 'updatedByName'])
                   && request.resource.data.memberId == memberId && raStr(request.resource.data.name, 120)
                   && request.resource.data.licence is map && request.resource.data.licence.keys().hasOnly(['categories', 'checkedOn', 'checkedHow', 'checkedBy', 'expires'])
                   && request.resource.data.licence.get('categories', []) is list && request.resource.data.licence.get('categories', []).hasOnly(['B', 'D1', 'D'])
                   && trDay(request.resource.data.licence.get('checkedOn', '')) && trDay(request.resource.data.licence.get('expires', ''))
                   && request.resource.data.licence.get('checkedHow', '') in ['', 'dvla', 'seen'] && raStr(request.resource.data.licence.get('checkedBy', ''), 120)
                   && request.resource.data.insurance is map && request.resource.data.insurance.keys().hasOnly(['kind', 'expires'])
                   && request.resource.data.insurance.get('kind', '') in ['', 'own', 'church'] && trDay(request.resource.data.insurance.get('expires', ''))
                   && request.resource.data.minibus in ['d1', 'car', 'no']
                   && request.resource.data.midas is map && request.resource.data.midas.keys().hasOnly(['on', 'kind']) && trDay(request.resource.data.midas.get('on', ''))
                   && request.resource.data.midas.get('kind', '') in ['', 'standard', 'accessible']
                   && request.resource.data.active is bool && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if transportReader();
    }
    match /driverOk/{memberId} {
      allow read: if active();
      allow write: if transportReader()
                   && request.resource.data.keys().hasOnly(['name', 'carsUntil', 'minibusUntil', 'updatedAt'])
                   && raStr(request.resource.data.name, 120) && trDay(request.resource.data.carsUntil) && trDay(request.resource.data.minibusUntil);
      allow delete: if transportReader();
    }
    match /vehicles/{id} {
      allow read: if active();
      allow write: if (transportReader() || raOffice())
                   && request.resource.data.keys().hasOnly(['name', 'kind', 'reg', 'seats', 'accessible', 'siteId', 'due', 'active', 'updatedAt', 'updatedBy'])
                   && raStr(request.resource.data.name, 80) && request.resource.data.name.size() > 0
                   && request.resource.data.kind in ['minibus', 'car', 'van', 'other'] && raStr(request.resource.data.get('reg', ''), 12)
                   && request.resource.data.get('seats', 0) is int && request.resource.data.get('seats', 0) >= 0 && request.resource.data.get('seats', 0) <= 60
                   && request.resource.data.get('accessible', false) is bool && raStr(request.resource.data.get('siteId', ''), 128)
                   && request.resource.data.due is map && request.resource.data.due.keys().hasOnly(['mot', 'insurance', 'tax', 'service'])
                   && trDay(request.resource.data.due.get('mot', '')) && trDay(request.resource.data.due.get('insurance', ''))
                   && trDay(request.resource.data.due.get('tax', '')) && trDay(request.resource.data.due.get('service', ''))
                   && request.resource.data.active is bool && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /vehicleChecks/{id} {
      allow read: if active();
      allow create: if active()
                    && request.resource.data.keys().hasOnly(['vehicleId', 'by', 'byName', 'at', 'ok', 'failed', 'defects'])
                    && exists(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId))
                    && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time && raStr(request.resource.data.byName, 120)
                    && request.resource.data.ok is bool && request.resource.data.failed is list && request.resource.data.failed.size() <= 20
                    && raStr(request.resource.data.defects, 500);
      allow update, delete: if false;
    }
    // ---- DATA RECORDS, UK GDPR (job 5; egbc-data-records.js; data-records.html) ----
    // The information asset register (main's fields, so its privacy tools read
    // the same list), the breach log and data requests. The church names its
    // data protection lead(s); master admins always. The register: the office
    // and the leads keep it, the trustees read it. Breaches: the leads only.
    // Requests: the leads and the office (who usually receives them).
    function dataLead() {
      let s = /databases/$(database)/documents/dataSettings/main;
      return active() && (isMaster() || (exists(s) && me().get('memberId', '-') in get(s).data.get('leads', [])));
    }
    function drText(v, n) { return v is string && v.size() <= n; }
    function drDay(v) { return v is string && (v == '' || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    // ---- PASTORAL VISITS (F-308; Martin, 27 Oct 2026) -------------------
    // Only the church's named, trained visitors read and keep them
    // (pastoralSettings/main visitorIds, 500 at most). NEVER the office, and a master
    // admin only when named: a master admin or the pastoral lead (named
    // for pastoral concerns in Who gets told, careNamed('pastoral'))
    // keeps the list, and keeping it is all they may do. Kept 2 years after
    // the person's last visit, then reviewed (pastoral-visits.html).
    function pastoralVisitor() {
      let p = /databases/$(database)/documents/pastoralSettings/main;
      return active() && exists(p) && me().get('memberId', '-') in get(p).data.get('visitorIds', []);
    }
    function pvDay(v) { return v is string && (v == '' || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function pvShape(d) {
      return d.keys().hasOnly(['memberId', 'name', 'on', 'by', 'how', 'followUp', 'followUpDone', 'note',
                               'keepUntil', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
             && d.get('memberId', '') is string && d.get('memberId', '').size() <= 60
             && d.name is string && d.name.size() > 0 && d.name.size() <= 120
             && pvDay(d.on) && d.on != ''
             && d.by is list && d.by.size() > 0 && d.by.size() <= 10
             && d.how in ['home', 'hospital', 'phone', 'other']
             && pvDay(d.get('followUp', '')) && d.get('followUpDone', false) is bool
             && d.get('note', '') is string && d.get('note', '').size() <= 2000
             && pvDay(d.get('keepUntil', ''))
             && d.updatedBy == request.auth.uid;
    }
    match /pastoralSettings/{id} {
      // Member ids only; each visitor's page needs it to know it is theirs.
      allow read: if active();
      allow write: if id == 'main' && (isMaster() || careNamed('pastoral'))
                   && request.resource.data.keys().hasOnly(['visitorIds', 'updatedAt', 'updatedBy'])
                   && request.resource.data.visitorIds is list && request.resource.data.visitorIds.size() <= 500
                   && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /pastoralVisits/{id} {
      allow read, delete: if pastoralVisitor();
      allow create, update: if pastoralVisitor() && pvShape(request.resource.data);
    }
    // The follow-up reminders' once-only marks: the server's.
    match /pastoralReminded/{id} {
      allow read, write: if false;
    }

    // The privacy tools' exports (functions/privacy-tools.js): a log of
    // who exported what for whom, written by the server only.
    match /dataExports/{id} {
      allow read: if dataLead();
      allow write: if false;
    }
    match /dataSettings/{id} {
      allow read: if active();
      allow write: if raOffice() && id == 'main'
                   && request.resource.data.keys().hasOnly(['leads', 'updatedAt', 'updatedBy'])
                   && request.resource.data.leads is list && request.resource.data.leads.size() <= 10 && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /infoAssets/{id} {
      allow read: if raOffice() || dataLead() || onTrustees();
      allow write: if (raOffice() || dataLead())
                   && request.resource.data.keys().hasOnly(['name', 'collections', 'purpose', 'lawfulBasis', 'specialCategory', 'specialCondition', 'dataSubjects', 'fieldsHeld', 'access',
                                                            'retention', 'retentionKey', 'processors', 'whereHeld', 'owner', 'reviewedOn', 'archived', 'updatedAt', 'updatedBy'])
                   && drText(request.resource.data.name, 120) && request.resource.data.name.size() > 0
                   && request.resource.data.collections is list && request.resource.data.collections.size() <= 30
                   && drText(request.resource.data.purpose, 1000)
                   && request.resource.data.lawfulBasis in ['consent', 'contract', 'legal', 'vital', 'public', 'legitimate']
                   && request.resource.data.specialCategory is bool && drText(request.resource.data.get('specialCondition', ''), 500)
                   && request.resource.data.dataSubjects is list && request.resource.data.dataSubjects.size() <= 20
                   && request.resource.data.fieldsHeld is list && request.resource.data.fieldsHeld.size() <= 60
                   && request.resource.data.access is list && request.resource.data.access.size() <= 20
                   && request.resource.data.retention is map && request.resource.data.retention.keys().hasOnly(['keepFor', 'from', 'then'])
                   && request.resource.data.retention.keepFor is int && request.resource.data.retention.keepFor >= 0
                   && request.resource.data.retention.from in ['created', 'lastActivity', 'eventEnd', 'leftChurch']
                   && request.resource.data.retention.then in ['delete', 'anonymise', 'review']
                   && drText(request.resource.data.get('retentionKey', ''), 60)
                   && request.resource.data.processors is list && request.resource.data.processors.size() <= 20
                   && drText(request.resource.data.get('whereHeld', ''), 120) && drText(request.resource.data.get('owner', ''), 120)
                   && drDay(request.resource.data.get('reviewedOn', '')) && request.resource.data.get('archived', false) is bool
                   && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /dataBreaches/{id} {
      allow read: if dataLead();
      allow write: if dataLead()
                   && request.resource.data.keys().hasOnly(['title', 'happenedOn', 'discoveredAt', 'what', 'assetIds', 'kinds', 'people', 'risk', 'icoDecision', 'icoReportedOn', 'icoRef', 'icoWhy',
                                                            'peopleTold', 'peopleToldOn', 'actions', 'lessons', 'status', 'closedOn', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
                   && drText(request.resource.data.title, 120) && request.resource.data.title.size() > 0
                   && drDay(request.resource.data.happenedOn) && request.resource.data.discoveredAt is string && request.resource.data.discoveredAt.size() <= 30
                   && drText(request.resource.data.what, 2000)
                   && request.resource.data.assetIds is list && request.resource.data.assetIds.size() <= 30
                   && request.resource.data.kinds is list && request.resource.data.kinds.hasOnly(['confidentiality', 'integrity', 'availability'])
                   && request.resource.data.people is int && request.resource.data.people >= 0
                   && request.resource.data.risk in ['', 'unlikely', 'risk', 'high']
                   && request.resource.data.icoDecision in ['', 'reported', 'not-needed'] && drDay(request.resource.data.icoReportedOn)
                   && drText(request.resource.data.icoRef, 60) && drText(request.resource.data.icoWhy, 1000)
                   && request.resource.data.peopleTold in ['', 'yes', 'no', 'not-needed'] && drDay(request.resource.data.peopleToldOn)
                   && drText(request.resource.data.actions, 2000) && drText(request.resource.data.lessons, 2000)
                   && request.resource.data.status in ['open', 'closed'] && drDay(request.resource.data.closedOn)
                   // a closed breach needs the ICO decision, with its reason when not reported
                   && (request.resource.data.status == 'open' || (request.resource.data.icoDecision != ''
                       && (request.resource.data.icoDecision == 'reported' || request.resource.data.icoWhy.size() > 0)))
                   && request.resource.data.updatedBy == request.auth.uid
                   && (resource == null ? request.resource.data.createdBy == request.auth.uid : request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if false;
    }
    match /dataRequests/{id} {
      allow read: if dataLead() || raOffice();
      allow write: if (dataLead() || raOffice())
                   && request.resource.data.keys().hasOnly(['kind', 'requester', 'receivedOn', 'identity', 'extended', 'extendWhy', 'status', 'doneOn', 'outcome', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
                   && request.resource.data.kind in ['access', 'rectify', 'erase', 'restrict', 'portable', 'object']
                   && drText(request.resource.data.requester, 120) && request.resource.data.requester.size() > 0
                   && drDay(request.resource.data.receivedOn) && request.resource.data.receivedOn != ''
                   && request.resource.data.identity in ['', 'checked', 'not-needed']
                   && request.resource.data.extended is bool && drText(request.resource.data.extendWhy, 500)
                   && (request.resource.data.extended == false || request.resource.data.extendWhy.size() > 0)
                   && request.resource.data.status in ['open', 'done', 'refused'] && drDay(request.resource.data.doneOn)
                   && drText(request.resource.data.outcome, 1000)
                   && (request.resource.data.status != 'refused' || request.resource.data.outcome.size() > 0)
                   && request.resource.data.updatedBy == request.auth.uid
                   && (resource == null ? request.resource.data.createdBy == request.auth.uid : request.resource.data.createdBy == resource.data.createdBy);
      // kept 2 years after it was answered, then the lead deletes it
      allow delete: if dataLead() && resource.data.status != 'open';
    }
    match /loneSettings/{id} {
      allow read: if active();
      allow write: if raOffice() && id == 'main'
                   && request.resource.data.keys().hasOnly(['graceMins', 'escalateMins', 'updatedAt', 'updatedBy'])
                   && request.resource.data.graceMins is int && request.resource.data.graceMins >= 5 && request.resource.data.graceMins <= 120
                   && request.resource.data.escalateMins is int && request.resource.data.escalateMins >= 5 && request.resource.data.escalateMins <= 120
                   && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // ---- THE BUILDING'S OWN H&S AND FIRE ASSESSMENTS (H&S step 3; F-280 section 3 A and B) ----
    // raAssessments/<siteId>__<hs|fire>: one for each building and kind. A
    // draft is written by the office (its job) or the building's leads
    // (raSiteRoles). It is signed by the building's lead - health and safety:
    // the lead or deputy; fire: the fire safety lead or the health and
    // safety lead - only once every required question is answered (the same
    // ids as egbc-hs-templates.js questionsFor: change both together), then
    // countersigned by a trustee who is not the signer (Martin's answer 2).
    // Changing a signed one starts its next version. Each countersigned
    // version is kept in raSigned, never changed.
    function raStr(v, n) { return v is string && v.size() <= n; }
    function raRoles(siteId) {
      let p = /databases/$(database)/documents/raSiteRoles/$(siteId);
      return exists(p) ? get(p).data : {};
    }
    function raAnyLead(siteId) {
      let r = raRoles(siteId);
      let mid = me().get('memberId', '');
      return active() && mid != '' && mid in [r.get('hsLead', '-'), r.get('hsDeputy', '-'), r.get('fireLead', '-')];
    }
    function raLeadOf(siteId, kind) {
      let r = raRoles(siteId);
      let mid = me().get('memberId', '');
      return active() && mid != ''
             && (kind == 'hs' ? mid in [r.get('hsLead', '-'), r.get('hsDeputy', '-')] : mid in [r.get('fireLead', '-'), r.get('hsLead', '-')]);
    }
    function raAssessSees(siteId) { return cmpSees() || raAnyLead(siteId); }
    function raHsChecklist(kind, p) {
      return ['insurance', 'competent'].concat(kind == 'hs'
        ? ['hsHazards', 'hsWho', 'hsControls', 'hsActions', 'hsReview', 'firstAid', 'electrics', 'workAtHeight', 'manualHandling', 'contractors', 'accessibility', 'chemicals']
            .concat(p.get('kitchen', false) == true ? ['foodHygiene'] : [])
            .concat(p.get('gas', false) == true ? ['gas'] : [])
            .concat(p.get('pre2000', false) == true ? ['asbestos'] : [])
            .concat(p.get('lift', false) == true ? ['lift'] : [])
            .concat(p.get('loneWorking', false) == true ? ['loneWorking'] : [])
            .concat(p.get('employees', false) == true ? ['employees'] : [])
            .concat(p.get('children', false) == true ? ['children'] : [])
            .concat(p.get('tower', false) == true ? ['towerAccess'] : [])
            .concat(p.get('churchyard', false) == true ? ['memorials'] : [])
        : ['premises', 'responsible', 'peopleAtRisk', 'ignition', 'fuel', 'detection', 'escape', 'firefighting', 'compartment', 'fireManagement', 'fireActions']
            .concat(p.get('kitchen', false) == true ? ['cooking'] : [])
            .concat(p.get('candles', false) == true ? ['nakedFlames'] : [])
            .concat(p.get('woodBurner', false) == true ? ['heating'] : [])
            .concat(p.get('publicUse', false) == true ? ['hirers'] : []));
    }
    function raChecklistDone(d) {
      let pp = /databases/$(database)/documents/buildingProfiles/$(d.siteId);
      let a = d.get('answers', {});
      return a.keys().hasAll(raHsChecklist(d.kind, exists(pp) ? get(pp).data : {}))
             && !a.values().hasAny(['', 'N/A:', 'N/A: ', 'Yes:', 'Yes: ', 'No:', 'No: ']);
    }
    function raAssessShape(d) {
      return d.keys().hasOnly(['siteId', 'kind', 'version', 'status', 'assessor', 'assessedOn', 'sections', 'groups', 'hazards', 'actions', 'answers', 'reviewDue', 'source', 'ai', 'suggested',
                               'signedBy', 'signedByName', 'signedByRole', 'signedAt', 'signedVersion', 'counterBy', 'counterByName', 'counterAt', 'updatedBy', 'updatedAt'])
             && d.kind in ['hs', 'fire'] && d.version is int && d.version >= 1
             && d.status in ['draft', 'signed', 'countersigned']
             && raStr(d.get('assessor', ''), 200) && raStr(d.get('assessedOn', ''), 10) && raStr(d.get('reviewDue', ''), 10)
             && d.get('sections', {}) is map && d.get('sections', {}).size() <= 40
             && d.get('groups', []) is list && d.get('groups', []).size() <= 20
             // 500: the H-9 bound for a list
             && d.get('hazards', []) is list && d.get('hazards', []).size() <= 500
             && d.get('actions', []) is list && d.get('actions', []).size() <= 500
             && d.get('answers', {}) is map && d.get('answers', {}).size() <= 200
             // read from a professional's report (H&S step 4): who wrote it, and who checked what was read
             && d.get('source', {}) is map && d.get('source', {}).size() <= 12
             // an AI first draft (H&S step 7): when, and who checked it; its suggested answers never count as answers
             && d.get('ai', {}) is map && d.get('ai', {}).size() <= 8 && d.get('suggested', {}) is map && d.get('suggested', {}).size() <= 200
             && d.updatedBy == request.auth.uid;
    }
    function raAssessWrite(id, d, before) {
      return raAssessShape(d) && id == d.siteId + '__' + d.kind
             && exists(/databases/$(database)/documents/sites/$(d.siteId))
             && (before == null || (before.siteId == d.siteId && before.kind == d.kind))
             && (
               // A DRAFT, with no signatures in it. A signed one is never
               // changed in place: changing it starts the next version.
               (d.status == 'draft' && (raOffice() || raAnyLead(d.siteId))
                && d.get('signedBy', '') == '' && d.get('counterBy', '') == ''
                && (before == null ? d.version == 1 : (before.status == 'draft' ? d.version == before.version : d.version == before.version + 1)))
               // SIGNED by the building's lead, as themselves, now, every question answered
               || (d.status == 'signed' && before != null && before.status == 'draft' && d.version == before.version
                   && d.diff(before).affectedKeys().hasOnly(['status', 'signedBy', 'signedByName', 'signedByRole', 'signedAt', 'signedVersion', 'updatedBy', 'updatedAt'])
                   && d.signedBy == request.auth.uid && d.signedAt == request.time && d.signedVersion == d.version
                   && raStr(d.get('signedByName', ''), 120) && raStr(d.get('signedByRole', ''), 60)
                   && raLeadOf(d.siteId, d.kind) && raChecklistDone(d))
               // COUNTERSIGNED by a trustee who is not the signer
               || (d.status == 'countersigned' && before != null && before.status == 'signed'
                   && d.diff(before).affectedKeys().hasOnly(['status', 'counterBy', 'counterByName', 'counterAt', 'updatedBy', 'updatedAt'])
                   && d.counterBy == request.auth.uid && d.counterAt == request.time && raStr(d.get('counterByName', ''), 120)
                   && request.auth.uid != before.signedBy && (isMaster() || onTrustees()))
             );
    }
    match /raAssessments/{id} {
      // a missing one tells nobody anything, so a page can ask whether there is one yet
      allow read: if resource == null || raAssessSees(resource.data.siteId);
      allow create, update: if raAssessWrite(id, request.resource.data, resource == null ? null : resource.data);
      allow delete: if false;
    }
    // ---- AN EVENT'S HEALTH AND SAFETY ASSESSMENT (H&S step 5; F-280 section 3C; answers 4 and 5;
    // away events at any age) ----
    // raEvents/<calEventId>: written by the event's organisers and leaders,
    // the office (job) or the H&S leads of the building that approves it
    // (approverSiteId: the event's own, or a building with a lead for one
    // away). Signed by the organiser once every required question is
    // answered (the same ids as egbc-hs-templates.js eventQuestions: change
    // both together), then approved by that building's health and safety
    // lead or deputy, not the signer. "Anyone who may need care or support"
    // answered yes lets the safeguarding lead or deputy read it too, and
    // nothing else from safeguarding is here: an under-18s event's own
    // safeguarding assessment stays its own, linked from the page.
    function raEventChecklist(kind, f, care) {
      return ['insurance', 'numbers', 'firstAid', 'accessibility', 'weather', 'incidents']
        .concat(kind in ['daytrip', 'residential', 'adventurous']
                ? ['venue', 'venueFire', 'venueRa', 'travel', 'drivers', 'medical', 'contacts', 'leaderOnCall', 'careSupport']
                : ['buildingRas', 'fire', 'crowd'])
        .concat(kind == 'wedding' ? ['traffic'] : kind == 'baptism' ? ['fontWater'] : kind == 'funeral' ? ['churchyard', 'traffic']
              : kind == 'residential' ? ['sleeping', 'nightFire'] : kind == 'adventurous' ? ['instructor', 'activityEquipment', 'activityLicence'] : [])
        .concat(f.get('flames', false) == true ? ['flames'] : [])
        .concat(f.get('food', false) == true ? ['food'] : [])
        .concat(f.get('alcohol', false) == true ? ['alcohol'] : [])
        .concat(f.get('outdoor', false) == true ? ['outdoor'] : [])
        .concat(f.get('equipment', false) == true ? ['equipmentPat'] : [])
        .concat(f.get('music', false) == true ? ['licensing'] : [])
        .concat(kind in ['daytrip', 'residential', 'adventurous'] && care.get('support', '') == 'yes' ? ['careHow'] : []);
    }
    function raEventDone(d) {
      let a = d.get('answers', {});
      return a.keys().hasAll(raEventChecklist(d.kind, d.get('flags', {}), d.get('care', {})))
             && !a.values().hasAny(['', 'N/A:', 'N/A: ', 'Yes:', 'Yes: ', 'No:', 'No: ']);
    }
    function raEventSees(calEventId, d) {
      return cmpSees() || runsEventId(calEventId) || isEventLeader(calEventId) || raAnyLead(d.get('approverSiteId', ''))
             || (d.get('care', {}).get('support', '') == 'yes' && (sgLeadOf(d.get('siteId', '')) || sgLeadOf(d.get('approverSiteId', ''))));
    }
    function raEventShape(d, calEventId) {
      return d.keys().hasOnly(['calEventId', 'siteId', 'approverSiteId', 'title', 'kind', 'flags', 'care', 'people', 'marked', 'venue', 'sections', 'hazards', 'actions', 'answers', 'ai', 'suggested', 'transport',
                               'version', 'status', 'source', 'signedBy', 'signedByName', 'signedAt', 'signedVersion', 'approvedBy', 'approvedByName', 'approvedAt', 'updatedBy', 'updatedAt'])
             && d.calEventId == calEventId && exists(/databases/$(database)/documents/calEvents/$(calEventId))
             && d.kind in ['general', 'concert', 'fair', 'wedding', 'baptism', 'funeral', 'hire', 'daytrip', 'residential', 'adventurous']
             && raStr(d.get('siteId', ''), 128) && d.approverSiteId is string && exists(/databases/$(database)/documents/sites/$(d.approverSiteId))
             && raStr(d.get('title', ''), 200)
             && d.get('flags', {}) is map && d.get('flags', {}).keys().hasOnly(['flames', 'food', 'alcohol', 'outdoor', 'equipment', 'music'])
             && d.get('care', {}) is map && d.get('care', {}).keys().hasOnly(['support']) && d.get('care', {}).get('support', '') in ['', 'yes', 'no']
             && d.get('people', 0) is int && d.get('marked', false) is bool
             && d.get('venue', {}) is map && d.get('venue', {}).size() <= 12
             // the drivers and vehicles chosen from the church's records (job 4): ids only
             && d.get('transport', {}) is map && d.get('transport', {}).keys().hasOnly(['driverIds', 'vehicleIds'])
             && d.get('transport', {}).get('driverIds', []) is list && d.get('transport', {}).get('driverIds', []).size() <= 20
             && d.get('transport', {}).get('vehicleIds', []) is list && d.get('transport', {}).get('vehicleIds', []).size() <= 10
             && d.get('sections', {}) is map && d.get('sections', {}).size() <= 40
             && d.get('hazards', []) is list && d.get('hazards', []).size() <= 500
             && d.get('actions', []) is list && d.get('actions', []).size() <= 500
             && d.get('answers', {}) is map && d.get('answers', {}).size() <= 200
             && d.get('source', {}) is map && d.get('source', {}).size() <= 12
             && d.get('ai', {}) is map && d.get('ai', {}).size() <= 8 && d.get('suggested', {}) is map && d.get('suggested', {}).size() <= 200
             && d.version is int && d.version >= 1 && d.status in ['draft', 'signed', 'approved']
             && d.updatedBy == request.auth.uid;
    }
    function raEventWrite(calEventId, d, before) {
      return raEventShape(d, calEventId)
             && (
               (d.status == 'draft'
                && (runsEventId(calEventId) || isEventLeader(calEventId) || raOffice() || raAnyLead(d.approverSiteId))
                && d.get('signedBy', '') == '' && d.get('approvedBy', '') == ''
                && (before == null ? d.version == 1 : (before.status == 'draft' ? d.version == before.version : d.version == before.version + 1)))
               // SIGNED by the organiser (answer 5), as themselves, now, every question answered
               || (d.status == 'signed' && before != null && before.status == 'draft' && d.version == before.version
                   && d.diff(before).affectedKeys().hasOnly(['status', 'signedBy', 'signedByName', 'signedAt', 'signedVersion', 'updatedBy', 'updatedAt'])
                   && d.signedBy == request.auth.uid && d.signedAt == request.time && d.signedVersion == d.version && raStr(d.get('signedByName', ''), 120)
                   && runsEventId(calEventId) && raEventDone(d))
               // APPROVED by the building's health and safety lead or deputy, not the signer
               || (d.status == 'approved' && before != null && before.status == 'signed'
                   && d.diff(before).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedByName', 'approvedAt', 'updatedBy', 'updatedAt'])
                   && d.approvedBy == request.auth.uid && d.approvedAt == request.time && raStr(d.get('approvedByName', ''), 120)
                   && request.auth.uid != before.signedBy && (isMaster() || raLeadOf(d.approverSiteId, 'hs')))
             );
    }
    match /raEvents/{calEventId} {
      allow read: if resource == null || raEventSees(calEventId, resource.data);
      allow create, update: if raEventWrite(calEventId, request.resource.data, resource == null ? null : resource.data);
      allow delete: if false;
    }
    // A HIRER'S OWN RISK ASSESSMENT, checked by the office (H&S step 5; F-280 section 3D; answer 6):
    // raHire/<booking key> = { siteId, confirmedBy, confirmedByName, confirmedAt, note }
    match /raHire/{key} {
      allow read: if resource == null || cmpSees() || theOffice(resource.data.siteId);
      allow create, update: if (theOffice(request.resource.data.siteId) || raOffice())
                    && request.resource.data.keys().hasOnly(['siteId', 'confirmedBy', 'confirmedByName', 'confirmedAt', 'note'])
                    && request.resource.data.confirmedBy == request.auth.uid && request.resource.data.confirmedAt == request.time
                    && raStr(request.resource.data.get('confirmedByName', ''), 120) && raStr(request.resource.data.get('note', ''), 1000)
                    && exists(/databases/$(database)/documents/bookings/$(key))
                    && get(/databases/$(database)/documents/bookings/$(key)).data.siteId == request.resource.data.siteId;
      allow delete: if false;
    }
    // WHAT WAS READ FROM A PROFESSIONAL'S REPORT (H&S step 4): written by the
    // raReadReport function only; a person checks it on the page before any
    // of it is added to the assessment.
    match /raReads/{id} {
      // a building's (<siteId>__hs|fire), an away event's venue (<calEventId>__venue), a hirer's (<booking key>__hire)
      allow read: if resource == null
                  || (resource.data.get('kind', '') in ['hs', 'fire'] && raAssessSees(resource.data.siteId))
                  || (resource.data.get('kind', '') == 'venue' && raEventSees(resource.data.calEventId, {}))
                  || (resource.data.get('kind', '') == 'hire' && (cmpSees() || theOffice(resource.data.siteId)));
      allow write: if false;
    }
    // A BUILDING ASSESSMENT'S DATE AND COLOUR, for everyone (H&S step 5; F-280 10.8: only these
    // cross over): raStatus/<siteId>__<kind>, written in the same batch as the assessment and
    // held to it, so an event's organiser sees "Fire risk assessment: countersigned, review by ..."
    // without reading the assessment itself.
    match /raStatus/{id} {
      allow read: if active();
      allow create, update: if request.resource.data.keys().hasOnly(['siteId', 'kind', 'status', 'version', 'reviewDue', 'counterAt'])
                    && id == request.resource.data.siteId + '__' + request.resource.data.kind
                    && getAfter(/databases/$(database)/documents/raAssessments/$(id)).data.status == request.resource.data.status
                    && getAfter(/databases/$(database)/documents/raAssessments/$(id)).data.version == request.resource.data.version
                    && getAfter(/databases/$(database)/documents/raAssessments/$(id)).data.get('reviewDue', '') == request.resource.data.reviewDue
                    && getAfter(/databases/$(database)/documents/raAssessments/$(id)).data.get('counterAt', null) == request.resource.data.get('counterAt', null);
      allow delete: if false;
    }
    // Counts only, never names (H&S step 6): raCounts/peeps = { agreed }, kept by functions/peeps.js.
    match /raCounts/{id} {
      allow read: if active();
      allow write: if false;
    }
    // Each countersigned version, as it was: written with the countersigning.
    match /raSigned/{id} {
      allow read: if raAssessSees(resource.data.siteId);
      allow create: if request.resource.data.keys().hasOnly(['siteId', 'kind', 'version', 'assessment', 'at'])
                    && id == request.resource.data.siteId + '__' + request.resource.data.kind + '__v' + string(request.resource.data.version)
                    && request.resource.data.at == request.time
                    && getAfter(/databases/$(database)/documents/raAssessments/$(request.resource.data.siteId + '__' + request.resource.data.kind)).data.status == 'countersigned'
                    && getAfter(/databases/$(database)/documents/raAssessments/$(request.resource.data.siteId + '__' + request.resource.data.kind)).data.counterBy == request.auth.uid
                    && request.resource.data.assessment == getAfter(/databases/$(database)/documents/raAssessments/$(request.resource.data.siteId + '__' + request.resource.data.kind)).data;
      allow update, delete: if false;
    }

    // By job (H-9): the office keeps them, the trustees see them.
    function cmpAdmin() { return raOffice(); }
    function cmpTrustee() { return isMaster() || onTrustees(); }
    function cmpSees() { return cmpAdmin() || cmpTrustee(); }
    function cmpCheck(id) { return get(/databases/$(database)/documents/buildingChecks/$(id)).data; }
    function cmpAssigned(c) { return active() && me().get('memberId', '-') in c.get('responsibleIds', []); }
    function cmpDays(e) {
      return e.get('unit', '') == 'week' ? 7 * e.get('n', 1)
           : e.get('unit', '') == 'month' ? 30.4375 * e.get('n', 1)
           : e.get('unit', '') == 'year' ? 365.25 * e.get('n', 1) : 1000000;
    }
    function cmpEveryOk(e) {
      return e is map && e.keys().hasOnly(['n', 'unit', 'trigger', 'triggerWords'])
             && e.get('unit', '') in ['week', 'month', 'year', 'once', 'demand']
             && (!('n' in e) || (e.n is int && e.n >= 1 && e.n <= 120));
    }
    function cmpCheckShape(siteId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['siteId', 'templateId', 'templateVersion', 'area', 'title', 'every', 'kind', 'basis', 'legal', 'baseEvery', 'lengthenReason',
                               'note', 'state', 'offReason', 'responsibleIds', 'custom', 'edited', 'createdAt', 'updatedAt'])
             && d.siteId == siteId && exists(/databases/$(database)/documents/sites/$(siteId))
             && d.templateId is string && d.title is string && d.title.size() > 0 && d.title.size() <= 140
             && cmpEveryOk(d.every)
             && d.state in ['on', 'off', 'removed']
             && d.get('offReason', '') is string && d.get('offReason', '').size() <= 300
             && d.get('lengthenReason', '') is string && d.get('lengthenReason', '').size() <= 300
             // 500: the H-9 bound for a list (H&S step 3a; was 10)
             && d.get('responsibleIds', []) is list && d.get('responsibleIds', []).size() <= 500
             && d.get('note', '') is string && d.get('note', '').size() <= 300
             && (d.state != 'off' || d.get('offReason', '').size() > 0);
    }
    // The law's floor, against the template as it is now.
    function cmpFloorOk() {
      let d = request.resource.data;
      let tp = /databases/$(database)/documents/complianceTemplates/$(d.templateId);
      return d.templateId == '' || !exists(tp)
             || (get(tp).data.get('basis', 'practice') == 'legal'
                   ? (cmpDays(d.every) <= cmpDays(get(tp).data.every) && d.state != 'off')
                 : get(tp).data.get('basis', 'practice') == 'standard'
                   ? (cmpDays(d.every) <= cmpDays(get(tp).data.every) || d.get('lengthenReason', '').size() > 0)
                 : true);
    }
    match /complianceTemplates/{id} {
      allow read: if active();
      allow write: if false;            // the seeding tool (Admin SDK) only
    }
    match /buildingProfiles/{siteId} {
      allow read: if cmpSees() || raAnyLead(siteId);   // the building's leads too (H&S step 3)
      allow create, update: if cmpAdmin() && request.resource.data.siteId == siteId
                            && exists(/databases/$(database)/documents/sites/$(siteId));
      allow delete: if false;
    }
    match /buildingChecks/{id} {
      allow read: if cmpSees() || cmpAssigned(resource.data) || raAnyLead(resource.data.siteId);
      allow create: if cmpAdmin() && cmpCheckShape(request.resource.data.siteId)
                    && (id == request.resource.data.siteId + '__' + request.resource.data.templateId
                        || (request.resource.data.templateId == '' && id.matches(request.resource.data.siteId + '__c_[a-z0-9]{4,16}')))
                    && cmpFloorOk();
      allow update: if cmpAdmin() && cmpCheckShape(resource.data.siteId)
                    && request.resource.data.templateId == resource.data.templateId
                    && cmpFloorOk();
      allow delete: if false;           // removed, never deleted: its history stays
    }
    function cmpRecordShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['checkId', 'siteId', 'doneOn', 'doneBy', 'doneByName', 'notes', 'files', 'certExpiry', 'items', 'jobId', 'at'])
             && d.checkId is string && exists(/databases/$(database)/documents/buildingChecks/$(d.checkId))
             && d.siteId == cmpCheck(d.checkId).siteId
             && d.doneOn is string && d.doneOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && d.doneBy == request.auth.uid
             && d.get('notes', '') is string && d.get('notes', '').size() <= 2000
             // 500: the H-9 bound for a list (H&S step 3a; were 10 and 200)
             && d.get('files', []) is list && d.get('files', []).size() <= 500
             && d.get('items', []) is list && d.get('items', []).size() <= 500
             && d.get('certExpiry', '') is string;
    }
    match /checkRecords/{id} {
      allow read: if cmpSees() || cmpAssigned(cmpCheck(resource.data.checkId)) || raAnyLead(resource.data.siteId);
      allow create: if cmpRecordShape()
                    && (cmpAdmin() || (cmpAssigned(cmpCheck(request.resource.data.checkId)) && cmpCheck(request.resource.data.checkId).state == 'on'));
      allow update, delete: if false;   // what was done stays done
    }
    match /buildingWork/{id} {
      allow read: if cmpSees() || raAnyLead(resource.data.siteId);
      allow create: if cmpAdmin() && request.resource.data.keys().hasOnly(['siteId', 'kind', 'on', 'note', 'by', 'at'])
                    && request.resource.data.by == request.auth.uid && request.resource.data.siteId is string
                    && request.resource.data.on is string && request.resource.data.on.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow update, delete: if false;
    }
    match /roomProfiles/{roomId} {
      allow read: if active();
      allow create, update: if cmpAdmin() && request.resource.data.keys().hasOnly(['siteId', 'kind', 'updatedAt'])
                            && exists(/databases/$(database)/documents/rooms/$(roomId))
                            && request.resource.data.kind in ['', 'kitchen', 'hall', 'office', 'av', 'store', 'plant', 'other'];
      allow delete: if false;
    }
    match /fireEquipment/{id} {
      allow read: if active();
      allow create, update: if cmpAdmin()
                            && request.resource.data.keys().hasOnly(['siteId', 'roomId', 'type', 'size', 'label', 'nextService', 'removed', 'updatedAt'])
                            && request.resource.data.type in ['water', 'foam', 'co2', 'powder', 'wetChemical', 'fireBlanket']
                            && request.resource.data.removed is bool;
      allow delete: if false;           // marked removed, never deleted
    }
    // STAGE 3 (F-233). A building's colour for the room bookings screen: a
    // colour and numbers only, so anyone signed in may see it (the people who
    // look after bookings are not all compliance admins). Written by the daily
    // run, and by the office's page when it opens a building. A warning only:
    // nothing about a booking reads it to refuse.
    match /complianceStatus/{siteId} {
      allow read: if active();
      allow create, update: if cmpAdmin()
                            && request.resource.data.keys().hasOnly(['siteId', 'rag', 'counts', 'safetyJobs', 'at'])
                            && request.resource.data.siteId == siteId
                            && request.resource.data.rag in ['red', 'amber', 'green', 'grey']
                            && request.resource.data.counts is map && request.resource.data.safetyJobs is int;
      allow delete: if false;
    }
    // Which reminders have gone (the daily run only).
    match /complianceReminders/{id} {
      allow read, write: if false;
    }
    // THE TRUSTEES' YEARLY SIGN-OFF: a trustee records that they have
    // reviewed the building compliance, in their own name, now. Never
    // changed or deleted.
    match /complianceSignoffs/{id} {
      allow read: if cmpSees();
      allow create: if cmpTrustee()
                    && request.resource.data.keys().hasOnly(['year', 'by', 'byName', 'at', 'note', 'snapshot'])
                    && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
                    && request.resource.data.year is int && request.resource.data.year >= 2026 && request.resource.data.year <= 2100
                    && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 1000
                    && request.resource.data.get('snapshot', {}) is map;
      allow update, delete: if false;
    }
    // ---- STAGE 4 (F-234): LIVE RISK MANAGEMENT, PEEPs and GEEPs ---------
    // The professional Health, Safety and Fire risk assessments' reports:
    // date, assessor, next review, the file. The office puts them up; the
    // trustees and the office read them. Never changed or deleted.
    match /raReports/{id} {
      allow read: if cmpSees() || raAnyLead(resource.data.siteId);
      allow create: if cmpAdmin()
                    && request.resource.data.keys().hasOnly(['siteId', 'kind', 'date', 'assessor', 'nextReview', 'files', 'by', 'byName', 'at'])
                    && request.resource.data.kind in ['fire', 'hs']
                    && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.nextReview is string && request.resource.data.nextReview.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.assessor is string && request.resource.data.assessor.size() > 0 && request.resource.data.assessor.size() <= 120
                    && request.resource.data.by == request.auth.uid
                    && exists(/databases/$(database)/documents/sites/$(request.resource.data.siteId));
      allow update, delete: if false;
    }
    // Hazards: the office keeps them; their controls are the building's checks.
    match /hazards/{id} {
      allow read: if cmpSees() || raAnyLead(resource.data.siteId);
      allow create, update: if cmpAdmin()
                            && request.resource.data.keys().hasOnly(['siteId', 'area', 'hazard', 'who', 'l', 's', 'controls', 'notes', 'status', 'source', 'starterId', 'createdAt', 'updatedAt', 'updatedBy'])
                            && request.resource.data.hazard is string && request.resource.data.hazard.size() > 0 && request.resource.data.hazard.size() <= 200
                            && request.resource.data.l is int && request.resource.data.l >= 1 && request.resource.data.l <= 5
                            && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 5
                            && request.resource.data.controls is list && request.resource.data.controls.size() <= 40
                            && request.resource.data.status in ['open', 'closed']
                            && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;           // closed, never deleted
    }
    // The trustees' dated snapshots of the register (with Martin's banner).
    match /riskSnapshots/{id} {
      allow read: if cmpSees();
      allow create: if cmpTrustee()
                    && request.resource.data.keys().hasOnly(['siteId', 'banner', 'by', 'byName', 'at', 'note', 'reports', 'hazards', 'changes'])
                    && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
                    && request.resource.data.banner is string && request.resource.data.banner.matches('^Live risk management: .*')
                    && request.resource.data.hazards is list && request.resource.data.hazards.size() <= 200;
      allow update, delete: if false;
    }
    // A building's GEEP: how visitors who need help get out. Not personal:
    // anyone signed in reads it; the office writes it.
    match /geeps/{siteId} {
      allow read: if active();
      allow create, update: if cmpAdmin()
                            && request.resource.data.keys().hasOnly(['siteId', 'identify', 'refuges', 'helpers', 'equipment', 'reviewDue', 'updatedBy', 'updatedByName', 'updatedAt'])
                            && request.resource.data.siteId == siteId
                            && exists(/databases/$(database)/documents/sites/$(siteId));
      allow delete: if false;
    }
    // PEEPS (Martin, 19 Oct). A person's own plan, with their agreement:
    // only they and master admins read or change it here. Minimal - no
    // medical history: what help, who helps, where, what equipment. They
    // delete it when it is no longer needed. Wardens never read this; they
    // read peepToday, below.
    function peepShape(mid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['memberId', 'name', 'agreed', 'agreedAt', 'needs', 'helpers', 'route', 'equipment', 'reviewDue', 'madeBy', 'enteredBy', 'enteredByName', 'updatedBy', 'updatedAt'])
             && d.memberId == mid && d.agreed == true
             && d.name is string && d.name.size() <= 120
             && d.needs is string && d.needs.size() > 0 && d.needs.size() <= 300
             && d.get('helpers', '') is string && d.get('helpers', '').size() <= 300
             && d.get('route', '') is string && d.get('route', '').size() <= 300
             && d.get('equipment', '') is string && d.get('equipment', '').size() <= 300
             && d.reviewDue is string && d.reviewDue.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && d.updatedBy == request.auth.uid;
    }
    function ownPeep(mid) { return active() && me().get('memberId', '') == mid && mid != ''; }
    match /peeps/{mid} {
      allow read: if ownPeep(mid) || isMaster();
      // A master admin entering a plan for someone records it: 'Entered by <name>
      // with their agreement' (Martin, 19 Oct).
      allow create, update: if peepShape(mid)
                            && (ownPeep(mid)
                                || (isMaster() && request.resource.data.get('enteredBy', '') == request.auth.uid
                                    && request.resource.data.get('enteredByName', '') is string && request.resource.data.get('enteredByName', '').size() > 0));
      allow delete: if ownPeep(mid) || isMaster();
    }
    // Today's plans for the roll-call: ONLY the people in today, read ONLY by
    // the wardens and the stewards on duty today (the peeps.js function
    // works both out) and master admins. Written by the function alone.
    match /peepToday/{day} {
      allow read: if isMaster() || (active() && me().get('memberId', '-') in resource.data.get('readers', []));
      allow write: if false;
    }
    // Every look at, and change to, a PEEP is logged. Append only; master admins read it.
    match /peepLog/{id} {
      allow read: if isMaster();
      allow create: if active() && request.resource.data.keys().hasOnly(['what', 'memberId', 'by', 'byName', 'at'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.what in ['view', 'made', 'changed', 'deleted'];
      allow update, delete: if false;
    }

    // ---- PRESENT (F-242): a PowerPoint deck, its notes, and who is on which slide ----
    // The context says whose it is: a session (its planner group) or a
    // meeting (its room). Session: the group's leaders present, its team
    // watch. Meeting: the host presents, the invitees watch - until the main
    // window adds meetingInvitee()/meetingHost() (F-242 section 6), master
    // admins only.
    // A MEETING'S HOST AND INVITEES (the main window, F-263, 22 Oct 2026),
    // the same answer as functions/video.js mayHost(): a master admin; an
    // admin of one of the room's teams; anyone on one of its host teams; or
    // the organiser of the event, when the event is in this room. Invitees:
    // the hosts, anyone on the room's teams, and - for a room marked
    // members (the members' meeting) - church members. The room is read from
    // churchSettings/video.roomsByKey, kept by the server beside `rooms`.
    function meetingRoomHere(room) {
      return get(/databases/$(database)/documents/churchSettings/video).data.get('roomsByKey', {}).get(room, {});
    }
    function meetingEventHere(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }
    function meetingOrganiser(room, eventId) {
      return eventId is string && eventId != '' && !eventId.matches('.*/.*')
             && exists(/databases/$(database)/documents/events/$(eventId))
             && meetingEventHere(eventId).get('organiserUid', '') == request.auth.uid
             && meetingEventHere(eventId).get('videoRoom',
                  get(/databases/$(database)/documents/churchSettings/video).data.get('byType', {}).get(meetingEventHere(eventId).get('type', ''), '')) == room;
    }
    function meetingHost(room, eventId) {
      return isMaster()
             || (active() && room is string && room != ''
                 && (me().get('adminFor', []).concat(me().get('adminCovers', [])).hasAny(meetingRoomHere(room).get('teams', []))
                     || teamsCovered().hasAny(meetingRoomHere(room).get('hostTeams', []))
                     || meetingOrganiser(room, eventId)));
    }
    function meetingInvitee(room, eventId) {
      return meetingHost(room, eventId)
             || (active() && room is string && room != ''
                 && (myTeams().hasAny(meetingRoomHere(room).get('teams', []))
                     || (meetingRoomHere(room).get('members', false) == true && isChurchMember())));
    }
    // The events window's names for them, taking a context (F-264).
    function meetingHostE(ctx) { return meetingHost(ctx.get('room', ''), ctx.get('eventId', '')); }
    function meetingInviteeE(ctx) { return meetingInvitee(ctx.get('room', ''), ctx.get('eventId', '')); }
    // THE HOST'S SAY-SO (Martin, 21 Oct, F-242 question 2): a host may let one
    // other person present: presentAllow/<meeting key>_<their uid>. It lasts
    // while the host is there - the host's page renews aliveAt each minute,
    // and it ends 3 minutes after the last renewal (a host who has gone).
    function meetingKey(ctx) {
      return 'mtg_' + ctx.get('room', '') + '_' + (ctx.get('eventId', '') != '' ? ctx.get('eventId', '') : ctx.get('day', ''));
    }
    function presentAllowed(ctx) {
      return request.auth != null
             && exists(/databases/$(database)/documents/presentAllow/$(meetingKey(ctx) + '_' + request.auth.uid))
             && request.time < get(/databases/$(database)/documents/presentAllow/$(meetingKey(ctx) + '_' + request.auth.uid)).data.aliveAt + duration.value(3, 'm');
    }
    function deckReads(ctx) {
      return ctx is map && ((ctx.get('type', '') == 'session' && readsPlanGroup(ctx.get('groupId', '')))
                            || (ctx.get('type', '') == 'meeting' && (meetingInviteeE(ctx) || presentAllowed(ctx))));
    }
    function deckPresents(ctx) {
      return ctx is map && ((ctx.get('type', '') == 'session' && editsPlanGroup(ctx.get('groupId', '')))
                            || (ctx.get('type', '') == 'meeting' && (meetingHostE(ctx) || presentAllowed(ctx))));
    }
    function presentCtxOk(ctx) {
      return (ctx.get('type', '') != 'session'
              || (ctx.get('sessionId', '') is string && exists(/databases/$(database)/documents/planSessions/$(ctx.get('sessionId', '-')))
                  && get(/databases/$(database)/documents/planSessions/$(ctx.get('sessionId', '-'))).data.get('groupId', '') == ctx.get('groupId', '-')))
             // A meeting (F-247): its room, its event (or none) and its day, nothing else.
             && (ctx.get('type', '') != 'meeting'
                 || (ctx.keys().hasOnly(['type', 'room', 'eventId', 'day'])
                     && ctx.get('room', '') is string && ctx.get('room', '').size() > 0 && ctx.get('room', '').size() <= 80
                     && ctx.get('eventId', '') is string && ctx.get('eventId', '').size() <= 200
                     && ctx.get('day', '') is string && ctx.get('day', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }
    // A meeting's shared state names the deck on the screens (deckId): a deck
    // made for that same meeting room, so everyone loads the same slides.
    function presentDeckOk(d) {
      return d.context.get('type', '') != 'meeting'
             || (d.get('deckId', '') is string && d.get('deckId', '').size() > 0 && d.get('deckId', '').size() <= 40
                 && exists(/databases/$(database)/documents/presentDecks/$(d.get('deckId', '-')))
                 && get(/databases/$(database)/documents/presentDecks/$(d.get('deckId', '-'))).data.context.get('type', '') == 'meeting'
                 && get(/databases/$(database)/documents/presentDecks/$(d.get('deckId', '-'))).data.context.get('room', '') == d.context.get('room', '-'));
    }
    match /presentDecks/{deckId} {
      allow read: if deckReads(resource.data.context);
      allow create: if deckPresents(request.resource.data.context) && presentCtxOk(request.resource.data.context)
                    && request.resource.data.keys().hasOnly(['context', 'name', 'status', 'source', 'by', 'byName', 'at'])
                    && request.resource.data.status == 'uploaded' && request.resource.data.source in ['upload', 'onedrive']
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120;
      allow update: if deckPresents(resource.data.context)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'keep'])
                    && request.resource.data.get('keep', false) is bool;
      allow delete: if deckPresents(resource.data.context);
    }
    // The speaker notes: whoever may present, never the viewers. The converter writes them.
    match /presentNotes/{deckId} {
      allow read: if deckPresents(resource.data.context);
      allow write: if false;
    }
    // Which slide everyone is on: one small document per session or meeting.
    // A slide's video in step (F-251): which one, playing or paused, from where, since when.
    function presentMediaOk(m) {
      return m == null || (m is map && m.keys().hasOnly(['i', 'k', 'state', 'at', 'since'])
             && m.i is int && m.k is int && m.state in ['playing', 'paused'] && (m.at is int || m.at is float) && m.since is string && m.since.size() < 40);
    }
    // The quiz (F-255): TV mode's teams and scores live here; phones mode
    // only says which run (its runId and code). Only the presenter changes it.
    function presentQuizOk(x) {
      return x == null || (x is map && x.keys().hasOnly(['step', 'mode', 'phase', 'q', 'teams', 'bonus', 'first', 'got', 'openedAt', 'seconds', 'seed', 'runId', 'code'])
             && x.get('mode', '') in ['tv', 'phones'] && x.get('teams', []) is list && x.get('teams', []).size() <= 6
             && x.get('got', []) is list && x.get('got', []).size() <= 6);
    }
    function presentNowShape(key) {
      let d = request.resource.data;
      return d.keys().hasOnly(['context', 'slide', 'presenterUid', 'presenterName', 'startedAt', 'slideAt', 'blank', 'updatedBy', 'media', 'quiz', 'deckId'])
             && presentMediaOk(d.get('media', null)) && presentQuizOk(d.get('quiz', null)) && presentDeckOk(d)
             && d.slide is int && d.slide >= 0 && d.slide < 1000 && d.blank is bool
             && d.presenterUid in [request.auth.uid, ''] && d.updatedBy == request.auth.uid
             && (d.context.get('type', '') != 'session' || key == 'ps_' + d.context.get('sessionId', '-'))
             && (d.context.get('type', '') != 'meeting' || key == meetingKey(d.context));
    }
    // The host's say-so (above): set, renewed and taken back by a host only;
    // read by that host and by the person it lets present - nobody else.
    match /presentAllow/{id} {
      allow read: if resource == null ? active()
                     : (resource.data.get('uid', '') == request.auth.uid || meetingHostE(resource.data.context));
      allow create, update: if request.resource.data.context is map && request.resource.data.context.get('type', '') == 'meeting'
                    && meetingHostE(request.resource.data.context) && presentCtxOk(request.resource.data.context)
                    && request.resource.data.keys().hasOnly(['context', 'key', 'uid', 'name', 'by', 'at', 'aliveAt'])
                    && request.resource.data.key == meetingKey(request.resource.data.context)
                    && request.resource.data.uid is string && request.resource.data.uid.size() > 0
                    && id == request.resource.data.key + '_' + request.resource.data.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.by == request.auth.uid && request.resource.data.aliveAt == request.time
                    // Only somebody who is here (main window, 22 Oct 2026): a host
                    // cannot hand the slides to someone who is not in the meeting.
                    && exists(/databases/$(database)/documents/presentHere/$(request.resource.data.key + '_' + request.resource.data.uid));
      allow delete: if meetingHostE(resource.data.context);
    }
    // Who is in the meeting, for the host's "Let ... present" list: each
    // person's own small record, kept fresh by their page, gone when they leave.
    match /presentHere/{id} {
      allow read: if resource == null ? active()
                     : (resource.data.get('uid', '') == request.auth.uid || meetingHostE(resource.data.context));
      allow create, update: if active() && request.resource.data.context is map && request.resource.data.context.get('type', '') == 'meeting'
                    && presentCtxOk(request.resource.data.context)
                    // Invitees only (main window, 22 Oct 2026): the host's "who is
                    // here" lists the meeting's own people, nobody else.
                    && meetingInviteeE(request.resource.data.context)
                    && request.resource.data.keys().hasOnly(['context', 'key', 'uid', 'name', 'at'])
                    && request.resource.data.key == meetingKey(request.resource.data.context)
                    && request.resource.data.uid == request.auth.uid && id == request.resource.data.key + '_' + request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.at == request.time;
      allow delete: if resource == null || resource.data.get('uid', '') == request.auth.uid || meetingHostE(resource.data.context);
    }
    match /presentNow/{key} {
      // Before anyone presents the document does not exist: anyone signed in
      // may look (there is nothing to see), so every screen's listener stays
      // alive and follows the moment someone starts.
      allow read: if resource == null ? active() : deckReads(resource.data.context);
      allow create: if deckPresents(request.resource.data.context) && presentCtxOk(request.resource.data.context) && presentNowShape(key);
      // The presenter moves on, stops, or someone allowed takes over; the context never changes.
      allow update: if deckPresents(resource.data.context) && request.resource.data.context == resource.data.context
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slide', 'slideAt', 'blank', 'media', 'quiz'])
                          ? resource.data.presenterUid == request.auth.uid && presentMediaOk(request.resource.data.get('media', null)) && presentQuizOk(request.resource.data.get('quiz', null))
                          : presentNowShape(key));
      allow delete: if false;
    }
    // A phones-mode quiz run (F-255): anyone with its unguessable id may read
    // it (players have no account - anonymous sign-in stays off); it holds the
    // question WITHOUT its answer, nicknames and scores. Nobody lists runs,
    // and only the hub's functions write. Codes, player keys, answers and the
    // right answers (quizCodes, quizPlayers, quizAnswers, quizSecret) have no
    // rule, so no page reaches them at all.
    match /quizRuns/{runId} {
      allow get: if true;
      allow list, write: if false;
    }

    // THE AUDIT LOG: append only. Nobody - not a master admin - changes or deletes it.
    match /complianceLog/{id} {
      allow read: if cmpSees();
      allow create: if request.resource.data.keys().hasOnly(['siteId', 'what', 'by', 'byName', 'at', 'detail'])
                    && request.resource.data.by == request.auth.uid
                    && (cmpAdmin() || (cmpTrustee() && request.resource.data.what in ['signoff', 'snapshot'])
                        || (active() && request.resource.data.what in ['done', 'job']));
      allow update, delete: if false;
    }

    // ── end EVENTS ──────────────────────────────────────────────────

    // ---- everything else --------------------------------------------
    // Closed by default. Add an explicit rule per collection as you migrate
    // each tool onto authentication.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
