rules_version = '2';

// EGBC Worship Planner — Firebase Storage rules
//
// Deploy from the project folder with:
//   firebase deploy --only storage --project egbc-worship-planner
//
// Knowledge Base media (AV how-to and troubleshooting videos) is readable by
// anyone with the link. These are internal AV instruction videos with no
// personal data and no third-party copyright, so open read is acceptable and
// avoids every viewer needing an account.
//
// Writes are capped at 500 MB and restricted to video and image types, so a
// stray upload cannot run up a bill.
//
// PlayThrough recordings are NOT covered by this and should stay out of the
// kb/ path until authentication exists — those are recordings of copyrighted
// worship songs and need gating.

service firebase.storage {
  match /b/{bucket}/o {

    // ── Knowledge Base media ──────────────────────────────────────────
    match /kb/{page}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 500 * 1024 * 1024
                   && (request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('image/.*'));
      allow delete: if false;
    }

    // ── Banner photos ─────────────────────────────────────────────────
    // Uploaded from the hub by team admins. Readable by anyone, since the
    // banner is the first thing on the page before rules are even consulted.

    match /banners/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Team resources ────────────────────────────────────────────────
    // Documents and files uploaded through resources.html. Signed-in only —
    // these include charters, policies and schemes of work.

    match /resources/{team}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // ── PlayThrough recordings ────────────────────────────────────────
    // Recordings of copyrighted worship songs. Signed-in only — never public.

    match /playthrough/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 500 * 1024 * 1024;
      allow delete: if false;
    }

    // ── Who is an administrator ───────────────────────────────────────
    // These rules CAN see Firestore - firestore.get() works here, and the
    // earlier note saying they could not was wrong. The users document is
    // the same one firestore.rules reads, mirrored from the address book,
    // so there is one answer to "is this person an admin" across both.
    //
    // exists() first: get() on a missing document fails the whole rule
    // rather than returning null, and a person signing in for the first
    // time has no users document for a moment.

    function adminHere() {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
             && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
             && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('masterAdmin', false) == true
                 || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('adminFor', []).size() > 0);
    }

    // ── Event pictures ────────────────────────────────────────────────
    // What's On and the event page are public, and the picture is drawn
    // before anyone has signed in to anything, so read is open - the same
    // reasoning as banners.
    //
    // Writing is administrators only (Martin's decision on F-016). The
    // event document the picture belongs to is already admin-only, so a
    // member who could write here could only have put an orphan file in
    // the bucket - but "only an orphan file" is not a reason to leave a
    // door open on a public read path.
    //
    // Room pictures will live at rooms/{roomId}/{fileName} when they are
    // uploaded rather than linked; the same rule applies, and it is written
    // below ready for it.

    match /events/{calEventId}/{fileName} {
      allow read: if true;
      allow write: if adminHere()
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if adminHere();
    }

    match /rooms/{roomId}/{fileName} {
      allow read: if true;
      allow write: if adminHere()
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if adminHere();
    }

    // ── Rota PDFs, on their way to an email ───────────────────────────
    //
    // "Send all rotas" builds one PDF per person, puts it here, reads it
    // straight back as base64 to attach to the email, and deletes it. The
    // files exist for a few seconds and nothing ever links to them.
    //
    // This path had NO rule at all, which meant the whole send failed the
    // moment the rules were applied - every person's upload refused, and
    // the planner reporting "Error for <name>" with nothing sent. Found by
    // driving the real button against the emulator (S0); it would otherwise
    // have been found by the church, on the day the rules were deployed.

    match /rota-temp/{packageId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }

    // ── Rota PDFs (existing behaviour) ────────────────────────────────
    // Nothing in the repo writes here any more - see FINDINGS-restyle.md.
    // Left as it was rather than tightened blind: it is reachable from the
    // original site, which is still live.
    match /rotas/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    // ── Everything else is closed ─────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
