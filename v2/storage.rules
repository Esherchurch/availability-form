rules_version = '2';

// EGBC Worship Planner — Firebase Storage rules
//
// Deploy from the project folder with:
//   firebase deploy --only storage --project egbc-worship-planner
//
// Knowledge Base media (AV how-to and troubleshooting videos) is readable by
// anyone with the link. These are internal AV instruction videos with no
// personal data and no third-party copyright, so open read is acceptable and
// avoids every viewer needing an account.
//
// Writes are capped at 500 MB and restricted to video and image types, so a
// stray upload cannot run up a bill.
//
// PlayThrough recordings are NOT covered by this and should stay out of the
// kb/ path until authentication exists — those are recordings of copyrighted
// worship songs and need gating.

service firebase.storage {
  match /b/{bucket}/o {

    // ── Knowledge Base media ──────────────────────────────────────────
    match /kb/{page}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 500 * 1024 * 1024
                   && (request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('image/.*'));
      allow delete: if false;
    }

    // ── Banner photos ─────────────────────────────────────────────────
    // Uploaded from the hub by team admins. Readable by anyone, since the
    // banner is the first thing on the page before rules are even consulted.

    match /banners/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── Email pictures ────────────────────────────────────────────────
    // What EmailBuilder2.html and CoreTeamApp.html put in a church email:
    // a photo, or a GIF they have made in the page.
    //
    // THIS PATH HAD NO RULE AT ALL, so it fell to the closed catch-all at
    // the bottom and every upload from both pages was refused - for a
    // leader, for a master admin, for everybody. Found on 11 Oct 2026
    // while making the rules agree with EmailBuilder2's door, which is
    // the only reason anybody looked: nothing shouted, the page just
    // could not add a picture.
    //
    // Read is open, as banners are, and for the same reason: the picture
    // ends up in an email in somebody's inbox, where there is no sign-in
    // to consult. Nothing personal goes here - it is artwork for a
    // church-wide email.
    //
    // Writing is Core Team's. Checked against the mirrored profile, the
    // same field firestore.rules reads, so the door, the drafts and the
    // pictures all answer to one list.
    match /email_assets/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
                         .data.get('teams', []).hasAny(['Core Team'])
                       || firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
                         .data.get('masterAdmin', false) == true);
      allow delete: if false;
    }

    // ── Team resources ────────────────────────────────────────────────
    // Documents and files uploaded through resources.html. Signed-in only —
    // these include charters, policies and schemes of work.

    match /resources/{team}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // ── PlayThrough recordings ────────────────────────────────────────
    // Recordings of copyrighted worship songs. Signed-in only — never public.

    match /playthrough/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 500 * 1024 * 1024;
      allow delete: if false;
    }

    // ── Who is an administrator ───────────────────────────────────────
    // These rules CAN see Firestore - firestore.get() works here, and the
    // earlier note saying they could not was wrong. The users document is
    // the same one firestore.rules reads, mirrored from the address book,
    // so there is one answer to "is this person an admin" across both.
    //
    // exists() first: get() on a missing document fails the whole rule
    // rather than returning null, and a person signing in for the first
    // time has no users document for a moment.

    function adminHere() {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
             && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
             && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('masterAdmin', false) == true
                 || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('adminFor', []).size() > 0);
    }

    // ── Event pictures ────────────────────────────────────────────────
    // What's On and the event page are public, and the picture is drawn
    // before anyone has signed in to anything, so read is open - the same
    // reasoning as banners.
    //
    // Writing is administrators only (Martin's decision on F-016). The
    // event document the picture belongs to is already admin-only, so a
    // member who could write here could only have put an orphan file in
    // the bucket - but "only an orphan file" is not a reason to leave a
    // door open on a public read path.
    //
    // Room pictures will live at rooms/{roomId}/{fileName} when they are
    // uploaded rather than linked; the same rule applies, and it is written
    // below ready for it.

    match /events/{calEventId}/{fileName} {
      allow read: if true;
      allow write: if adminHere()
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if adminHere();
    }

    match /rooms/{roomId}/{fileName} {
      allow read: if true;
      allow write: if adminHere()
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if adminHere();
    }

    // ── Rota PDFs, on their way to an email ───────────────────────────
    //
    // "Send all rotas" builds one PDF per person, puts it here, reads it
    // straight back as base64 to attach to the email, and deletes it. The
    // files exist for a few seconds and nothing ever links to them.
    //
    // This path had NO rule at all, which meant the whole send failed the
    // moment the rules were applied - every person's upload refused, and
    // the planner reporting "Error for <name>" with nothing sent. Found by
    // driving the real button against the emulator (S0); it would otherwise
    // have been found by the church, on the day the rules were deployed.

    match /rota-temp/{packageId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }

    // ── Rota PDFs, the old path ───────────────────────────────────────
    //
    // This took a 25MB upload from anybody at all, signed in or not. S-003.
    // Checked before closing it: nothing in v2 writes here, and nothing on
    // the original site does either - the planner on both sites uses
    // rota-temp/. Reading stays open, in case an old email still links to
    // a PDF somebody was sent.
    //
    // write and delete are separate because on a delete there is no
    // request.resource to measure, and asking for its size there refuses
    // the delete for a reason nobody would guess.
    match /rotas/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }

    // ── Branding at the root of the bucket ──────────────────────────
    // The church logo and the header images were uploaded before any folders
    // existed, so they sit at the root of the bucket where no rule below
    // reaches them. Every page shows one, including the two with no sign-in
    // at all: the availability form, which goes to the whole team once a
    // term, and the login page. Without this they would have lost their logo
    // the day these rules went live - found because the form's console said
    // "User does not have permission to access '1774936285076.png'".
    //
    // Named one by one rather than opening the whole root, so this grants
    // read on these six files and on nothing else, and nothing may be written
    // to the root at all.
    match /{fileName} {
      allow read: if fileName in [
        '1774936285076.png',              // the church logo, on most pages
        'copilot_image_1775806874083.jpeg', // the hub and shell header
        '1774933729776.png',
        '1774933429062.png',
        '1774936402880.png',
        '1777880144841.png'               // the training portal's logo
      ];
      allow write, delete: if false;
    }

    // ── EVENTS (events window) ──────────────────────────────────────
    // Owned by the events window (EVENTS-WINDOW-BRIEF.md); nothing in here
    // changes a rule outside it.

    // Files attached to a form: a hirer's safeguarding policy, a child's
    // care plan. The person filling the form in has no account, so the
    // upload is allowed only into the folder of a request that is still
    // open - its key is the folder name, and only they have it.
    //
    // Reading is the master admin and the safeguarding lead or deputy of
    // the site the form belongs to, because a file may hold medical detail
    // and the rules cannot see inside it. Never replaced, never deleted
    // from the page.
    function formRequest(key) {
      return firestore.get(/databases/(default)/documents/formRequests/$(key)).data;
    }
    // MEMBERS' MEETINGS' PAPERS (21 Oct 2026): church members and whoever
    // runs the meetings read them; master admins, the Church office and the
    // Elders put them up. Never a public file address.
    function storageMeetingRunner() {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
             && storageMe().status == 'active'
             && (storageMe().get('masterAdmin', false) == true
                 || storageMe().get('teams', []).hasAny(['Church office', 'Elders']));
    }
    function storageMeetingMember() {
      return storageMeetingRunner()
             || (request.auth != null
                 && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
                 && storageMe().status == 'active'
                 && storageMe().get('churchMember', false) == true);
    }
    match /churchMeetings/{mid}/papers/{file} {
      allow read: if storageMeetingMember();
      allow create, update: if storageMeetingRunner()
                            && request.resource.size < 20 * 1024 * 1024
                            && (request.resource.contentType == 'application/pdf'
                                || request.resource.contentType.matches('image/.*'));
      allow delete: if storageMeetingRunner();
    }
    function storageMe() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function storageSgLead(siteId) {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
             && storageMe().status == 'active'
             && (storageMe().get('masterAdmin', false) == true
                 || (siteId != ''
                     && storageMe().get('memberId', '') != ''
                     && firestore.exists(/databases/(default)/documents/bookingSettings/$(siteId))
                     && (firestore.get(/databases/(default)/documents/bookingSettings/$(siteId)).data.get('safeguardingLead', '') == storageMe().get('memberId', '')
                         || firestore.get(/databases/(default)/documents/bookingSettings/$(siteId)).data.get('safeguardingDeputy', '') == storageMe().get('memberId', ''))));
    }

    match /formUploads/{key}/{fileName} {
      // resource == null: a new file only. Writing over one already there
      // counts as "create" too, and must not be allowed.
      allow create: if resource == null
                    && request.resource.size < 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf')
                    && firestore.exists(/databases/(default)/documents/formRequests/$(key))
                    && formRequest(key).status in ['sent', 'reuse'];
      allow read: if firestore.exists(/databases/(default)/documents/formRequests/$(key))
                  && storageSgLead(formRequest(key).get('siteId', ''));
      allow update: if false;
      // Only when the answer it belongs to is due for deletion, from the
      // retention list - which only a master admin can act on.
      allow delete: if request.auth != null
                    && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
                    && storageMe().status == 'active' && storageMe().get('masterAdmin', false) == true;
    }

    // Photos from a one-off upload link (E4, NEXT-BRIEF §11). Written only
    // into a numbered place the uploader has taken on a link that is on and
    // unexpired; photos only (JPEG, PNG, HEIC, WebP), under 15 MB; never
    // over a file already there. Only admins can read or list them.
    // Rejected photos are deleted by Martin by hand, never from a page.
    function uploadLinkData(linkId) {
      return firestore.get(/databases/(default)/documents/uploadLinks/$(linkId)).data;
    }
    match /uploads/{linkId}/{slot} {
      allow create: if resource == null
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp)')
                    && firestore.exists(/databases/(default)/documents/uploadLinks/$(linkId))
                    && uploadLinkData(linkId).active == true
                    && uploadLinkData(linkId).expiresAt > request.time
                    && slot.matches('[0-9]{1,4}')
                    && int(slot) < uploadLinkData(linkId).count;
      allow read: if adminHere();
      allow update, delete: if false;
    }

    // A hirer's documents (insurance, safeguarding policy, risk assessment):
    // the site's office only - an admin, or that site's bookings admin.
    // PDFs and pictures, under 15 MB. Kept: replaced only by a new upload.
    function storageOffice(siteId) {
      return adminHere()
             || (request.auth != null
                 && firestore.exists(/databases/(default)/documents/bookingSettings/$(siteId))
                 && storageMe().status == 'active'
                 && storageMe().get('memberId', '-') in firestore.get(/databases/(default)/documents/bookingSettings/$(siteId)).data.get('bookingsAdmins', []));
    }
    match /hirerDocs/{siteId}/{hirerId}/{fileName} {
      allow read: if storageOffice(siteId);
      allow create: if storageOffice(siteId) && request.resource.size < 15 * 1024 * 1024
                    && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
      allow update, delete: if false;
    }

    // The church's logo (church-settings.html): shown on the public hire
    // pages, so anyone reads it; admins put it there.
    match /church/{fileName} {
      allow read: if true;
      allow create, update: if adminHere() && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if adminHere();
    }

    // A small group's picture (Chunk 7): the groups admins or (stage 2) the
    // group's own leaders upload it; it is shown on "Find a group", so
    // anyone may read it.
    function groupLeaderHere(groupId) {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
             && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
             && firestore.exists(/databases/(default)/documents/smallGroups/$(groupId))
             && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('memberId', '-')
                  in firestore.get(/databases/(default)/documents/smallGroups/$(groupId)).data.get('leaderIds', []);
    }
    match /smallGroups/{groupId}/{fileName} {
      allow read: if true;
      allow write: if (adminHere() || groupLeaderHere(groupId))
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if adminHere() || groupLeaderHere(groupId);
    }

    // A maintenance job's one photo (F-123; Martin, A-M1): put up by the
    // person who reported the job, while it is to do; seen only by the
    // Maintenance team and the office (admins, and the bookings admins of
    // the job's site). One file per job, at maintJobs/<job>/photo.
    function maintJob(jobId) {
      return firestore.get(/databases/(default)/documents/maintJobs/$(jobId)).data;
    }
    function maintReader(jobId) {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
             && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
             && (adminHere()
                 || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('teams', []).hasAny(['Maintenance'])
                 || (firestore.exists(/databases/(default)/documents/maintJobs/$(jobId))
                     && maintJob(jobId).get('siteId', '') != ''
                     && firestore.exists(/databases/(default)/documents/bookingSettings/$(maintJob(jobId).siteId))
                     && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('memberId', '-')
                          in firestore.get(/databases/(default)/documents/bookingSettings/$(maintJob(jobId).siteId)).data.get('bookingsAdmins', [])));
    }
    match /maintJobs/{jobId}/photo {
      allow read: if maintReader(jobId);
      allow write: if request.auth != null
                   && firestore.exists(/databases/(default)/documents/maintJobs/$(jobId))
                   && maintJob(jobId).reportedBy == request.auth.uid
                   && maintJob(jobId).status == 'todo'
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Sermons uploaded in the hub (the backup way; F-132, F-138). Sermons
    // from Val's feed play from the feed's own addresses and have nothing
    // here. A shown sermon's audio may be played by anyone; one not shown
    // only by the sermon admins (master admins, and the people named in
    // sermonShow/access), who upload it. Replaced, never deleted from a page.
    function sermonDoc(id) {
      return firestore.get(/databases/(default)/documents/sermons/$(id)).data;
    }
    function sermonAdminHere() {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
             && storageMe().status == 'active'
             && (storageMe().get('masterAdmin', false) == true
                 || (firestore.exists(/databases/(default)/documents/sermonShow/access)
                     && storageMe().get('memberId', '-') in firestore.get(/databases/(default)/documents/sermonShow/access).data.get('memberIds', [])));
    }
    match /sermons/{sermonId}/audio {
      allow read: if (firestore.exists(/databases/(default)/documents/sermons/$(sermonId)) && sermonDoc(sermonId).published == true)
                  || sermonAdminHere();
      allow create, update: if sermonAdminHere()
                    && firestore.exists(/databases/(default)/documents/sermons/$(sermonId))
                    && request.resource.size < 300 * 1024 * 1024
                    && request.resource.contentType.matches('audio/(mpeg|mp3|mp4|x-m4a|m4a|aac|wav|x-wav)');
      allow delete: if false;
    }
    // Each series' picture: public, like the sermons.
    match /sermonSeries/{seriesId}/artwork {
      allow read: if true;
      allow create, update: if sermonAdminHere() && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png)');
      allow delete: if false;
    }

    // The picture library (Martin, 14 Oct 2026): library/<picId>/<file>.
    // Anyone may see a picture (events are shown on public pages); an
    // admin adds, replaces and removes them. Pictures only, at most 8 MB
    // (the pages make them smaller first). WRITTEN, NOT DEPLOYED: it goes
    // live on switch-over day with the rest of these rules.
    match /library/{picId}/{fileName} {
      allow read: if true;
      allow create, update: if adminHere()
                            && request.resource.size < 8 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if adminHere();
    }

    // THE SESSION PLANNER (F-223; Martin, 16 Oct): a session's files -
    // worksheets, PowerPoints, pictures, programme videos - at
    // planner/<group>/<session>/<file>. The group's leaders put them up;
    // its leaders and its team read them; master admins too. Video up to
    // 500 MB (programme downloads), anything else up to 50 MB.
    function planGroupHere(groupId) {
      return firestore.get(/databases/(default)/documents/planGroups/$(groupId)).data;
    }
    function planActive() {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
             && storageMe().status == 'active';
    }
    function planLeaderHere(groupId) {
      return planActive() && firestore.exists(/databases/(default)/documents/planGroups/$(groupId))
             && (storageMe().get('memberId', '-') in planGroupHere(groupId).get('leaderIds', [])
                 || storageMe().get('masterAdmin', false) == true);
    }
    function planReaderHere(groupId) {
      return planActive() && firestore.exists(/databases/(default)/documents/planGroups/$(groupId))
             && (storageMe().get('masterAdmin', false) == true
                 || storageMe().get('memberId', '-') in planGroupHere(groupId).get('leaderIds', [])
                 || planGroupHere(groupId).get('teamName', '-') in storageMe().get('teams', []));
    }
    match /planner/{groupId}/{sessionId}/{fileName} {
      allow read: if planReaderHere(groupId);
      allow write: if planLeaderHere(groupId)
                   && (request.resource.contentType.matches('video/.*') ? request.resource.size < 500 * 1024 * 1024
                                                                        : request.resource.size < 50 * 1024 * 1024)
                   && (request.resource.contentType.matches('(image|video|audio)/.*')
                       || request.resource.contentType.matches('application/(pdf|vnd.openxmlformats-officedocument..*|vnd.ms-powerpoint|msword|vnd.oasis.opendocument..*)'));
      allow delete: if planLeaderHere(groupId);
    }

    // Building compliance certificates and photos (F-231): at
    // compliance/<site>/<check>/<file>. The compliance admins (master admins,
    // the Church office) and the check's own people put them up; those and the
    // trustees (Elders) read them. Images and PDFs, up to 20 MB. Never deleted.
    function cmpCheckHere(checkId) {
      return firestore.get(/databases/(default)/documents/buildingChecks/$(checkId)).data;
    }
    function cmpWho() {
      return planActive() && (storageMe().get('masterAdmin', false) == true || 'Church office' in storageMe().get('teams', []));
    }
    function cmpMine(siteId, checkId) {
      return planActive() && firestore.exists(/databases/(default)/documents/buildingChecks/$(checkId))
             && cmpCheckHere(checkId).siteId == siteId
             && storageMe().get('memberId', '-') in cmpCheckHere(checkId).get('responsibleIds', []);
    }
    // PRESENT (F-242): a deck's source PowerPoint and its slide pictures, at
    // present/<deck>/. Read by the deck's audience (a session's group;
    // a meeting's invitees once agreed - master admins until then). The
    // source is put up by whoever may present; the pictures by the
    // converter alone. Never readable by anyone else.
    function deckHere(deckId) { return firestore.get(/databases/(default)/documents/presentDecks/$(deckId)).data; }
    function deckCtx(deckId) { return deckHere(deckId).get('context', {}); }
    // A meeting's host and invitees: firestore.rules' meetingHost() and
    // meetingInvitee(), said again here (F-263, 22 Oct 2026).
    function meetingRoomStorage(room) {
      return firestore.get(/databases/(default)/documents/churchSettings/video).data.get('roomsByKey', {}).get(room, {});
    }
    function meetingOrganiserStorage(room, eventId) {
      return eventId is string && eventId != '' && !eventId.matches('.*/.*')
             && firestore.exists(/databases/(default)/documents/events/$(eventId))
             && firestore.get(/databases/(default)/documents/events/$(eventId)).data.get('organiserUid', '') == request.auth.uid
             && firestore.get(/databases/(default)/documents/events/$(eventId)).data.get('videoRoom',
                  firestore.get(/databases/(default)/documents/churchSettings/video).data.get('byType', {})
                    .get(firestore.get(/databases/(default)/documents/events/$(eventId)).data.get('type', ''), '')) == room;
    }
    function meetingHostStorage(room, eventId) {
      return planActive()
             && (storageMe().get('masterAdmin', false) == true
                 || storageMe().get('adminFor', []).hasAny(meetingRoomStorage(room).get('teams', []))
                 || storageMe().get('teams', []).hasAny(meetingRoomStorage(room).get('hostTeams', []))
                 || meetingOrganiserStorage(room, eventId));
    }
    function meetingInviteeStorage(room, eventId) {
      return meetingHostStorage(room, eventId)
             || (planActive()
                 && (storageMe().get('teams', []).hasAny(meetingRoomStorage(room).get('teams', []))
                     || (meetingRoomStorage(room).get('members', false) == true && storageMe().get('churchMember', false) == true)));
    }
    function deckAudience(deckId) {
      return firestore.exists(/databases/(default)/documents/presentDecks/$(deckId))
             && ((deckCtx(deckId).get('type', '') == 'session' && planReaderHere(deckCtx(deckId).get('groupId', '-')))
                 || (deckCtx(deckId).get('type', '') == 'meeting' && meetingInviteeStorage(deckCtx(deckId).get('room', ''), deckCtx(deckId).get('eventId', ''))));
    }
    function deckPresenter(deckId) {
      return firestore.exists(/databases/(default)/documents/presentDecks/$(deckId))
             && ((deckCtx(deckId).get('type', '') == 'session' && planLeaderHere(deckCtx(deckId).get('groupId', '-')))
                 || (deckCtx(deckId).get('type', '') == 'meeting' && meetingHostStorage(deckCtx(deckId).get('room', ''), deckCtx(deckId).get('eventId', ''))));
    }
    match /present/{deckId}/{fileName} {
      allow read: if deckAudience(deckId);
      allow create, update: if fileName == 'source.pptx' && deckPresenter(deckId)
                            && request.resource.size < 100 * 1024 * 1024
                            && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation';
      allow delete: if deckPresenter(deckId);
    }
    // ROOM FLOOR PLANS (F-243): at roomPlans/<room>/, never the public
    // rooms/. Who sees one is the room's floorPlanWho: 'public' anyone;
    // 'members' (the default) anyone signed in and active, and the office;
    // 'office' the admins and the site's bookings admins. Admins put them up.
    function roomHere(roomId) { return firestore.get(/databases/(default)/documents/rooms/$(roomId)).data; }
    function planOffice(roomId) {
      return planActive() && (adminHere()
             || (firestore.exists(/databases/(default)/documents/bookingSettings/$(roomHere(roomId).get('siteId', '-')))
                 && storageMe().get('memberId', '-') in firestore.get(/databases/(default)/documents/bookingSettings/$(roomHere(roomId).get('siteId', '-'))).data.get('bookingsAdmins', [])));
    }
    match /roomPlans/{roomId}/{fileName} {
      allow read: if firestore.exists(/databases/(default)/documents/rooms/$(roomId))
                  && (roomHere(roomId).get('floorPlanWho', 'members') == 'public'
                      || (roomHere(roomId).get('floorPlanWho', 'members') == 'members' && planActive())
                      || planOffice(roomId));
      allow write: if adminHere() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if adminHere();
    }
    match /compliance/{siteId}/{checkId}/{fileName} {
      allow read: if cmpWho() || (planActive() && 'Elders' in storageMe().get('teams', [])) || cmpMine(siteId, checkId);
      allow create: if (cmpWho() || cmpMine(siteId, checkId))
                    && request.resource.size < 20 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf');
      allow update, delete: if false;
    }

    // ── end EVENTS ──────────────────────────────────────────────────

    // ── Everything else is closed ─────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
