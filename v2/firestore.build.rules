&& request.resource.data.get('logoUrl', '') is string && request.resource.data.get('logoUrl', '').size() <= 1000
&& request.resource.data.get('logoPath', '') is string && request.resource.data.get('logoPath', '').size() <= 300
&& request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 60
&& request.resource.data.get('skills', []) is list
&& request.resource.data.get('skills', []).size() <= 60
&& (request.resource.data.get('skills', []).size() == 0
|| request.resource.data.get('skills', []).join('\n').matches('[^\n]{1,60}(\n[^\n]{1,60})*'))
&& request.resource.data.get('places', []) is list
&& request.resource.data.get('places', []).size() <= 100
&& request.resource.data.get('board', '') is string && request.resource.data.get('board', '').size() <= 60
&& request.resource.data.get('coreFor', []) is list
&& request.resource.data.get('coreFor', []).size() <= 500
&& !(teamId in request.resource.data.get('coreFor', []))
&& request.resource.data.get('name', '') == teamId
&& request.resource.data.get('rota', true) is bool
&& request.resource.data.get('runs', []) is list
&& request.resource.data.get('runs', []).size() <= 4
&& request.resource.data.get('runs', []).hasOnly(['today', 'people', 'bookings', 'send']);
}
function under18Teams() {
let p = /databases/$(database)/documents/teamFlags/under18;
return exists(p) ? get(p).data.teams : [];
}
function eventIsUnder18() {
return exists(/databases/$(database)/documents/teamFlags/under18)
