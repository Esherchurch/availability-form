|| boardLeader(resource.data.boardId);
allow update: if false;
}
function urgentOk() {
return request.resource.data.get('urgent', false) != true
|| (resource != null && resource.data.get('urgent', false) == true)
|| raOffice();
}
function noticeTeamsMine(teams) {
return teams is list && teams.size() > 0 && teams.hasOnly(me().get('adminFor', []));
}
function mayNoticeTo(teams) {
return raOffice() || (isAdmin() && noticeTeamsMine(teams));
}
match /news/{itemId} {
allow read: if active();
allow create: if mayNoticeTo(request.resource.data.get('teams', [])) && urgentOk();
allow delete: if mayNoticeTo(resource.data.get('teams', []));
allow update: if (mayNoticeTo(resource.data.get('teams', []))
