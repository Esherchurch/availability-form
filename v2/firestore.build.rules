&& mirrorsBook(request.resource.data);
allow update: if signedIn() && request.auth.uid == uid
&& request.resource.data.diff(resource.data).affectedKeys()
.hasOnly(['lastSeen', 'name', 'teams', 'adminFor', 'masterAdmin',
