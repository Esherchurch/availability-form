function cmpAdmin() { return raOffice(); }
function cmpTrustee() { return isMaster() || onTrustees(); }
function cmpSees() { return cmpAdmin() || cmpTrustee(); }
function cmpCheck(id) { return get(/databases/$(database)/documents/buildingChecks/$(id)).data; }
function cmpAssigned(c) { return active() && me().get('memberId', '-') in c.get('responsibleIds', []); }
function cmpDays(e) {
return e.get('unit', '') == 'week' ? 7 * e.get('n', 1)
: e.get('unit', '') == 'month' ? 30.4375 * e.get('n', 1)
: e.get('unit', '') == 'year' ? 365.25 * e.get('n', 1) : 1000000;
}
function cmpEveryOk(e) {
return e is map && e.keys().hasOnly(['n', 'unit', 'trigger', 'triggerWords'])
