|| (lead && d.signedBy == request.auth.uid
&& d.signedAt == request.time && d.signedVersion == d.version
&& sgChecklistDone(ev.get('sgKind', ''), d)))
&& ((d.get('waived', false) == (before == null ? false : before.get('waived', false))
&& d.get('waivedAt', null) == (before == null ? null : before.get('waivedAt', null))
&& d.get('waivedBy', '') == (before == null ? '' : before.get('waivedBy', ''))
&& d.get('waivedWhy', '') == (before == null ? '' : before.get('waivedWhy', '')))
|| ((lead || isMaster())
&& d.get('waivedBy', '') == request.auth.uid && d.get('waivedAt', null) == request.time
&& sgText(d.get('waivedWhy', ''), 300) && d.get('waivedWhy', '').size() > 0));
