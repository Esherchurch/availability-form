function isoDow(day) {
let p = day.split('-');
return timestamp.date(int(p[0]), int(p[1]), int(p[2])).dayOfWeek();
}
function roomData(roomId) {
return get(/databases/$(database)/documents/rooms/$(roomId)).data;
}
function partsOf(roomId) { return roomData(roomId).get('parts', []); }
function partFree(roomId, d, dow) {
let s = exists(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day))
? get(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day)).data.slots
: roomData(roomId).get('rotaWeek', {}).get(dow, null);
return roomOpen(roomId, d.day) && (s == null || s[d.slotFrom:d.slotTo].hasOnly([0]));
}
function partMarked(roomId, d, key) {
return getAfter(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day)).data.lastBooking == key;
}
function partHeld(roomId, d) {
return !getAfter(/databases/$(database)/documents/roomDays/$(roomId + '_' + d.day)).data.slots[d.slotFrom:d.slotTo].hasAny([0]);
}
function partGivenBack(roomId, b, key) {
return getAfter(/databases/$(database)/documents/roomDays/$(roomId + '_' + b.day)).data.get('lastCancel', '') == key;
}
function partsFree(p, d, dow) {
return p.size() <= 4 && partFree(p[0], d, dow) && (p.size() < 2 || partFree(p[1], d, dow))
&& (p.size() < 3 || partFree(p[2], d, dow)) && (p.size() < 4 || partFree(p[3], d, dow));
}
function footMarked(d, key) {
let p = partsOf(d.roomId);
return p.size() == 0 ? partMarked(d.roomId, d, key)
: (p.size() <= 4 && partMarked(p[0], d, key) && (p.size() < 2 || partMarked(p[1], d, key))
&& (p.size() < 3 || partMarked(p[2], d, key)) && (p.size() < 4 || partMarked(p[3], d, key)));
}
function footHeld(d, p) {
return p.size() == 0 ? partHeld(d.roomId, d)
: (p.size() <= 4 && partHeld(p[0], d) && (p.size() < 2 || partHeld(p[1], d))
&& (p.size() < 3 || partHeld(p[2], d)) && (p.size() < 4 || partHeld(p[3], d)));
}
function footGivenBack(b, key) {
let p = partsOf(b.roomId);
return p.size() == 0 ? partGivenBack(b.roomId, b, key)
: (p.size() <= 4 && partGivenBack(p[0], b, key) && (p.size() < 2 || partGivenBack(p[1], b, key))
&& (p.size() < 3 || partGivenBack(p[2], b, key)) && (p.size() < 4 || partGivenBack(p[3], b, key)));
}
function dayOfBooking(roomOnDay, bookingRoom) {
return partsOf(bookingRoom).size() == 0 ? roomOnDay == bookingRoom : roomOnDay in partsOf(bookingRoom);
}
function baseSlots(roomId, day) {
return roomData(roomId).get('rotaWeek', {}).get(string(isoDow(day)), null);
}
function bookingsAdminOf(siteId) {
return active() && siteId is string && siteId != ''
