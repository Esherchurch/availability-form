'signedBy', 'signedByName', 'signedAt', 'signedVersion', 'signedNote',
'waived', 'waivedBy', 'waivedByName', 'waivedAt', 'waivedWhy', 'source', 'updatedAt', 'updatedBy',
'flags', 'signedByRole', 'host', 'hostIds'])
&& d.calEventId == calEventId
&& sgText(d.get('title', ''), 120) && sgText(d.get('templateId', ''), 40)
