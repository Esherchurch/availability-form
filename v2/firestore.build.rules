&& request.resource.data.get('description', '') is string && request.resource.data.get('description', '').size() <= 2000
&& request.resource.data.get('invitees', []) is list && request.resource.data.get('invitees', []).size() <= 500
&& request.resource.data.get('teams', []) is list && request.resource.data.get('teams', []).size() <= 100
