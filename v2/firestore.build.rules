function raHsChecklist(kind, p) {
return ['insurance', 'competent'].concat(kind == 'hs'
? ['hsHazards', 'hsWho', 'hsControls', 'hsActions', 'hsReview', 'firstAid', 'electrics', 'workAtHeight', 'manualHandling', 'contractors', 'accessibility', 'chemicals']
.concat(p.get('kitchen', false) == true ? ['foodHygiene'] : [])
.concat(p.get('gas', false) == true ? ['gas'] : [])
.concat(p.get('pre2000', false) == true ? ['asbestos'] : [])
.concat(p.get('lift', false) == true ? ['lift'] : [])
.concat(p.get('loneWorking', false) == true ? ['loneWorking'] : [])
.concat(p.get('employees', false) == true ? ['employees'] : [])
.concat(p.get('children', false) == true ? ['children'] : [])
.concat(p.get('tower', false) == true ? ['towerAccess'] : [])
.concat(p.get('churchyard', false) == true ? ['memorials'] : [])
: ['premises', 'responsible', 'peopleAtRisk', 'ignition', 'fuel', 'detection', 'escape', 'firefighting', 'compartment', 'fireManagement', 'fireActions']
.concat(p.get('kitchen', false) == true ? ['cooking'] : [])
.concat(p.get('candles', false) == true ? ['nakedFlames'] : [])
.concat(p.get('woodBurner', false) == true ? ['heating'] : [])
