allow update: if (isPastor() || isLeadership())
&& request.resource.data.diff(resource.data).affectedKeys()
.hasOnly(['publicTitle', 'speaker', 'speakerId', 'serviceLeader', 'serviceLeaderId', 'serviceRoles', 'readers', 'updatedAt', 'updatedBy'])
