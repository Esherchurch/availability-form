: ['buildingRas', 'fire', 'crowd'])
.concat(kind == 'wedding' ? ['traffic'] : kind == 'baptism' ? ['fontWater'] : kind == 'funeral' ? ['churchyard', 'traffic']
: kind == 'residential' ? ['sleeping', 'nightFire'] : kind == 'adventurous' ? ['instructor', 'activityEquipment', 'activityLicence'] : [])
.concat(f.get('flames', false) == true ? ['flames'] : [])
.concat(f.get('food', false) == true ? ['food'] : [])
.concat(f.get('alcohol', false) == true ? ['alcohol'] : [])
.concat(f.get('outdoor', false) == true ? ['outdoor'] : [])
.concat(f.get('equipment', false) == true ? ['equipmentPat'] : [])
.concat(f.get('music', false) == true ? ['licensing'] : [])
.concat(kind in ['daytrip', 'residential', 'adventurous'] && care.get('support', '') == 'yes' ? ['careHow'] : []);
}
function raEventDone(d) {
let a = d.get('answers', {});
return a.keys().hasAll(raEventChecklist(d.kind, d.get('flags', {}), d.get('care', {})))
&& !a.values().hasAny(['', 'N/A:', 'N/A: ', 'Yes:', 'Yes: ', 'No:', 'No: ']);
